+fs::path ExeDir() {
+    static const fs::path dir = [] {
+        std::error_code ec;
+        fs::path exe = fs::read_symlink("/proc/self/exe", ec);
+        if (!ec && !exe.empty()) return exe.parent_path();
+        return fs::current_path(ec);
+    }();
+    return dir;
+}
+
+int Instance() {
+    static const int n = [] {
+        const auto& args = ProcessArgs();
+        for (size_t i = 1; i < args.size(); ++i) {
+            if (args[i] == "--instance" && i + 1 < args.size()) {
+                return std::clamp(std::atoi(args[i + 1].c_str()), 0, 8);
+            }
+            if (args[i].rfind("--instance=", 0) == 0) {
+                return std::clamp(std::atoi(args[i].c_str() + 11), 0, 8);
+            }
+        }
+        return 0;
+    }();
+    return n;
