+void OpenGameWindow(bool apply) {
+    if (!g_running.load(std::memory_order_acquire)) {
+        DoOpenGameWindow(apply);
+        return;
+    }
+    if (g_main_tid_valid.load(std::memory_order_acquire) && pthread_equal(pthread_self(), g_main_tid)) {
+        DoOpenGameWindow(apply);
+        return;
+    }
+    std::unique_lock<std::mutex> lock(g_open_lock);
+    g_open_done = false;
+    SDL_Event ev{};
+    ev.type = SDL_EVENT_USER;
+    ev.user.code = kEvOpenWindow;
+    ev.user.data1 = apply ? reinterpret_cast<void*>(uintptr_t(1)) : nullptr;
+    if (SDL_PushEvent(&ev)) {
+        g_open_cv.wait_for(lock, std::chrono::seconds(5), [] { return g_open_done; });
+    }
