+std::vector<GpuAdapterInfo> EnumerateGpuAdapters() {
+    std::vector<GpuAdapterInfo> out;
+#ifdef _WIN32
+    using Microsoft::WRL::ComPtr;
+    ComPtr<IDXGIFactory4> factory;
+    if (FAILED(CreateDXGIFactory2(0, IID_PPV_ARGS(&factory))) || !factory) return out;
+
+    ComPtr<IDXGIFactory6> f6;
+    bool has_f6 = SUCCEEDED(factory.As(&f6)) && f6;
+    std::map<std::tuple<uint32_t, uint32_t, uint32_t>, uint32_t> ordinal_map;
+
+    auto add_adapter = [&](IDXGIAdapter1* ad) {
+        DXGI_ADAPTER_DESC1 desc{};
+        if (FAILED(ad->GetDesc1(&desc))) return;
+        GpuAdapterInfo info;
+        info.vendor_id = desc.VendorId;
+        info.device_id = desc.DeviceId;
+        info.subsys_id = desc.SubSysId;
+        info.revision = desc.Revision;
+        info.luid = (uint64_t(uint32_t(desc.AdapterLuid.HighPart)) << 32) | uint32_t(desc.AdapterLuid.LowPart);
+        info.name = WideToUtf8(desc.Description);
+        info.dedicated_vram = desc.DedicatedVideoMemory;
+        info.shared_mem = desc.SharedSystemMemory;
+        info.is_software = (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0;
+        info.likely_uma = !info.is_software && info.dedicated_vram < (512ull << 20) && info.shared_mem >= (1ull << 30);
+        uint32_t ord = ordinal_map[{info.vendor_id, info.device_id, info.subsys_id}]++;
+        char keybuf[64];
+        std::snprintf(keybuf, sizeof(keybuf), "%04X:%04X:%08X:%u", info.vendor_id, info.device_id, info.subsys_id, ord);
+        info.key = keybuf;
+        info.d3d12_fl11 = SUCCEEDED(D3D12CreateDevice(ad, D3D_FEATURE_LEVEL_11_0, __uuidof(ID3D12Device), nullptr));
+        if (info.d3d12_fl11) {
+            static constexpr D3D_FEATURE_LEVEL kLevels[] = {
+                D3D_FEATURE_LEVEL_12_2, D3D_FEATURE_LEVEL_12_1, D3D_FEATURE_LEVEL_12_0,
+                D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+            info.max_feature_level = D3D_FEATURE_LEVEL_11_0;
+            for (D3D_FEATURE_LEVEL fl : kLevels) {
+                if (SUCCEEDED(D3D12CreateDevice(ad, fl, __uuidof(ID3D12Device), nullptr))) {
+                    info.max_feature_level = uint32_t(fl);
+                    break;
+                }
+            }
+        }
+        out.push_back(std::move(info));
+    };
+
+    for (UINT i = 0;; ++i) {
+        ComPtr<IDXGIAdapter1> ad;
+        HRESULT hr = has_f6
+                         ? f6->EnumAdapterByGpuPreference(i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE, IID_PPV_ARGS(&ad))
+                         : factory->EnumAdapters1(i, &ad);
+        if (FAILED(hr) || !ad) break;
+        add_adapter(ad.Get());
+    }
+    if (!has_f6) {
+        std::stable_sort(out.begin(), out.end(), [](const GpuAdapterInfo& a, const GpuAdapterInfo& b) {
+            if (a.is_software != b.is_software) return !a.is_software;
+            if (a.likely_uma != b.likely_uma) return !a.likely_uma;
+            return a.dedicated_vram > b.dedicated_vram;
+        });
+    }
+#else
+    PFN_vkGetInstanceProcAddr get_proc = nullptr;
+    void* vk_dl = nullptr;
+    bool sdl_loaded = false;
+    if (SDL_Vulkan_LoadLibrary(nullptr)) {
+        sdl_loaded = true;
+        get_proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(SDL_Vulkan_GetVkGetInstanceProcAddr());
+    }
+    if (!get_proc) {
+        vk_dl = dlopen("libvulkan.so.1", RTLD_LAZY | RTLD_LOCAL);
+        if (vk_dl) get_proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(vk_dl, "vkGetInstanceProcAddr"));
+    }
+    if (get_proc) {
+        auto create_inst = reinterpret_cast<PFN_vkCreateInstance>(get_proc(VK_NULL_HANDLE, "vkCreateInstance"));
+        if (create_inst) {
+            VkApplicationInfo app_info{};
+            app_info.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+            app_info.pApplicationName = (kGame.log && *kGame.log) ? kGame.log : "XboxXBERecomp";
+            app_info.apiVersion = VK_API_VERSION_1_2;
+            VkInstanceCreateInfo ci{};
+            ci.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+            ci.pApplicationInfo = &app_info;
+            VkInstance inst = VK_NULL_HANDLE;
+            if (create_inst(&ci, nullptr, &inst) != VK_SUCCESS) {
+                app_info.apiVersion = VK_API_VERSION_1_0;
+                create_inst(&ci, nullptr, &inst);
+            }
+            if (inst != VK_NULL_HANDLE) {
+                auto enum_devs = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(get_proc(inst, "vkEnumeratePhysicalDevices"));
+                auto get_props = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(get_proc(inst, "vkGetPhysicalDeviceProperties"));
+                auto get_mem = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(get_proc(inst, "vkGetPhysicalDeviceMemoryProperties"));
+                auto destroy_inst = reinterpret_cast<PFN_vkDestroyInstance>(get_proc(inst, "vkDestroyInstance"));
+                uint32_t count = 0;
+                if (enum_devs && get_props && get_mem && enum_devs(inst, &count, nullptr) == VK_SUCCESS && count > 0) {
+                    std::vector<VkPhysicalDevice> devs(count);
+                    if (enum_devs(inst, &count, devs.data()) == VK_SUCCESS) {
+                        std::map<std::tuple<uint32_t, uint32_t, uint32_t>, uint32_t> ordinal_map;
+                        for (VkPhysicalDevice pd : devs) {
+                            VkPhysicalDeviceProperties props{};
+                            VkPhysicalDeviceMemoryProperties mem{};
+                            get_props(pd, &props);
+                            get_mem(pd, &mem);
+                            GpuAdapterInfo info;
+                            info.vendor_id = props.vendorID;
+                            info.device_id = props.deviceID;
+                            info.subsys_id = 0;
+                            info.revision = props.driverVersion;
+                            info.luid = (uint64_t(props.vendorID) << 32) | uint64_t(props.deviceID);
+                            info.name = props.deviceName;
+                            for (uint32_t h = 0; h < mem.memoryHeapCount; ++h) {
+                                if (mem.memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+                                    info.dedicated_vram += mem.memoryHeaps[h].size;
+                                else
+                                    info.shared_mem += mem.memoryHeaps[h].size;
+                            }
+                            info.is_software = (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU);
+                            info.likely_uma = (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU);
+                            info.d3d12_fl11 = true;  // Linux Vulkan capable; keeps shared UI filters enabled
+                            info.max_feature_level = props.apiVersion;
+                            uint32_t ord = ordinal_map[{info.vendor_id, info.device_id, info.subsys_id}]++;
+                            char keybuf[64];
+                            std::snprintf(keybuf, sizeof(keybuf), "%04X:%04X:%08X:%u", info.vendor_id, info.device_id,
+                                          info.subsys_id, ord);
+                            info.key = keybuf;
+                            out.push_back(std::move(info));
+                        }
+                    }
+                }
+                if (destroy_inst) destroy_inst(inst, nullptr);
+            }
+        }
+    }
+    if (vk_dl) dlclose(vk_dl);
+    if (sdl_loaded) SDL_Vulkan_UnloadLibrary();
+    std::stable_sort(out.begin(), out.end(), [](const GpuAdapterInfo& a, const GpuAdapterInfo& b) {
+        if (a.is_software != b.is_software) return !a.is_software;
+        if (a.likely_uma != b.likely_uma) return !a.likely_uma;
+        return a.dedicated_vram > b.dedicated_vram;
+    });
+#endif
+    return out;
+}
