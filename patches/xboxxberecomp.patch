+    AotStamp stamp{};
+    if (LoadAotStamp(stamp_path, adapter_desc_.VendorId, adapter_desc_.DeviceId, adapter_desc_.SubSysId,
+                     adapter_desc_.Revision, expected_sig, stamp) &&
