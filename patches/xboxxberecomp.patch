+bool PrepareGameCode(const GameFiles& game) {
+    std::error_code ec;
+    fs::create_directories(CompilerDir() / "work", ec);
+    fs::path lock_path = CompilerDir() / "work" / ".build.lock";
+    int lock_fd = ::open(lock_path.c_str(), O_CREAT | O_RDWR | O_CLOEXEC, 0644);
+    if (lock_fd >= 0) (void)::flock(lock_fd, LOCK_EX);
+
+    std::vector<Image> images = Images();
+    std::vector<Target> stale = StaleTargets(game, images);
+    for (const Target& target : stale) LOGR("Game code: building lib%s.so", target.image->exe.c_str());
+    bool built = stale.empty() || BuildWithWindow(stale);
+
+    if (lock_fd >= 0) {
+        (void)::flock(lock_fd, LOCK_UN);
+        ::close(lock_fd);
+    }
+    if (!built) return false;
+    for (const Image& image : images)
+        if (image.xbe == IMAGE_XBE && dispatch::Load(CodeLib(image))) return true;
+    LOGE("Game code: the game's shared library could not be loaded.");
+    if (HasDisplay() && !AutoStartRequested()) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, WideToUtf8Simple(kGame.title).c_str(),
+                                 "The game's code could not be loaded, see the log in the logs folder.", nullptr);
+    }
+    return false;
+}
