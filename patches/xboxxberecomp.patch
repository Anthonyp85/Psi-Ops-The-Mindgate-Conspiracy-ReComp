+
+void RecordGuestFrame(double guest_frame_ms, double capture_ms, double wait_gpu_frame_ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    st.pending_guest_ns.store(uint64_t(std::max(0.0, guest_frame_ms * 1e6)), std::memory_order_relaxed);
+    st.pending_capture_ns.fetch_add(uint64_t(std::max(0.0, capture_ms * 1e6)), std::memory_order_relaxed);
+    uint64_t wg = uint64_t(std::max(0.0, wait_gpu_frame_ms * 1e6));
