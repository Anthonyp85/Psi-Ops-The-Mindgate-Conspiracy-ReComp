+bool VulkanBackend::InitImGui() {
+    VkDescriptorPoolSize pool_sizes[] = {
+        {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 64},
+    };
+    VkDescriptorPoolCreateInfo pci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pci.flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT;
+    pci.maxSets = 64;
+    pci.poolSizeCount = 1;
+    pci.pPoolSizes = pool_sizes;
+    if (vk_.create_desc_pool(dev_, &pci, nullptr, &ui_pool_) != VK_SUCCESS) return false;
+
+    g_imgui_vk_loader = {vk_.get_inst_proc, instance_};
+    if (!ImGui_ImplVulkan_LoadFunctions(ImGuiVkLoadFunc, nullptr)) {
+        LOGE("vulkan: ImGui_ImplVulkan_LoadFunctions failed");
+        return false;
+    }
+
+    ImGui_ImplVulkan_InitInfo ii{};
+    ii.Instance = instance_;
+    ii.PhysicalDevice = phys_;
+    ii.Device = dev_;
+    ii.QueueFamily = queue_family_;
+    ii.Queue = queue_;
+    ii.DescriptorPool = ui_pool_;
+    ii.RenderPass = present_rp_;
+    ii.MinImageCount = uint32_t(std::max<size_t>(2, swap_images_.size()));
+    ii.ImageCount = uint32_t(std::max<size_t>(2, swap_images_.size()));
+    ii.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    ii.PipelineCache = pipe_cache_;
+    if (!ImGui_ImplVulkan_Init(&ii)) {
+        LOGE("vulkan: ImGui_ImplVulkan_Init failed");
+        return false;
+    }
+    imgui_inited_ = true;
+    return true;
+}
+
+void VulkanBackend::ParseCaptureCli() {
+    auto args = ReadProcCmdline();
+    for (size_t i = 1; i < args.size(); ++i) {
+        const std::string& a = args[i];
+        auto take = [&](const char* flag, std::string& val) -> bool {
+            size_t n = std::strlen(flag);
+            if (a == flag && i + 1 < args.size()) {
+                val = args[++i];
+                return true;
+            }
+            if (a.size() > n + 1 && a.compare(0, n, flag) == 0 && a[n] == '=') {
+                val = a.substr(n + 1);
+                return true;
+            }
+            return false;
+        };
+        std::string v;
+        if (take("--capture-bmp", v) || take("--capture-ui-bmp", v)) cli_cap_bmp_ = std::filesystem::path(v);
+        else if (take("--capture-at-gframe", v)) cli_cap_at_gframe_ = uint32_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-after-frames", v)) cli_cap_after_frames_ = uint64_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-after-3d-frames", v))
+            cli_cap_after_3d_frames_ = uint64_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-min-3d-ms", v))
+            cli_cap_min_3d_ms_ = double(std::max(0, std::atoi(v.c_str())));
+        else if (a == "--capture-exit") cli_cap_exit_ = true;
+    }
+    if (cli_cap_bmp_.empty()) {
+        if (const char* ev = std::getenv("XBE_CAPTURE_UI_BMP"); ev && *ev) cli_cap_bmp_ = std::filesystem::path(ev);
+    }
+}
+
+void VulkanBackend::ComputeRenderExtents(uint32_t& out_rw, uint32_t& out_rh, uint32_t& out_vpx, uint32_t& out_vpy,
+                                         uint32_t& out_vpw, uint32_t& out_vph) const {
+    bool wide = app::Widescreen();
+    float aspect = wide ? 16.0f / 9.0f : 4.0f / 3.0f;
+    float w = float(std::max(bb_w_, 1u));
+    float h = float(std::max(bb_h_, 1u));
+    float vw = std::min(w, h * aspect);
+    float vh = vw / aspect;
+    out_vpw = std::max(1u, uint32_t(std::lround(vw)));
+    out_vph = std::max(1u, uint32_t(std::lround(vh)));
+    out_vpx = (bb_w_ > out_vpw) ? (bb_w_ - out_vpw) / 2u : 0u;
+    out_vpy = (bb_h_ > out_vph) ? (bb_h_ - out_vph) / 2u : 0u;
+
+    const app::Settings& s = app::Get();
+    if (Upscaler* u = g_upscaler.load(std::memory_order_acquire); u && upscaler_inited_) {
+        u->ResolveRenderSize(out_vpw, out_vph, guest_w_, guest_h_, wide, out_rw, out_rh);
+    } else {
+        float factor = std::clamp(float(s.render_percent) / 100.0f, 0.33f, 2.0f);
+        if (s.aspect_correct_render) {
+            out_rw = std::max(320u, uint32_t(std::lround(out_vpw * factor)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(out_vph * factor)) & ~1u);
+        } else {
+            float sc = std::max((out_vph * factor) / float(guest_h_), 0.5f);
+            out_rw = std::max(320u, uint32_t(std::lround(guest_w_ * sc)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(guest_h_ * sc)) & ~1u);
+        }
+    }
+    out_rw = std::max(320u, out_rw & ~1u);
+    out_rh = std::max(240u, out_rh & ~1u);
+}
+
+void VulkanBackend::InitUpscaler() {
+    Upscaler* u = g_upscaler.load(std::memory_order_acquire);
+    if (!u) return;
+    UpscalerInitDesc desc{};
+    desc.device = reinterpret_cast<void*>(dev_);
+    desc.queue = reinterpret_cast<void*>(phys_);
+    desc.cmd_list = reinterpret_cast<void*>(cmd_);
+    desc.caps = caps_;
+    desc.host.ctx = this;
+    desc.host.transition = [](void* ctx, void* res, uint32_t* cur_state, uint32_t want_state) {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!res || !cur_state) return;
+        VkImageLayout st = static_cast<VkImageLayout>(*cur_state);
+        self->TransitionImage(reinterpret_cast<VkImage>(res), st, static_cast<VkImageLayout>(want_state),
+                              VK_IMAGE_ASPECT_COLOR_BIT);
+        *cur_state = uint32_t(st);
+    };
+    desc.host.compile = [](void* ctx, const std::string& src, const char* entry, const char* profile,
+                           uint64_t* out_hash) -> void* {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        uint64_t h = 0;
+        VkShaderModule mod = self->Compile(src, entry, profile, h);
+        if (out_hash) *out_hash = h;
+        return reinterpret_cast<void*>(mod);
+    };
+    desc.host.create_or_load_compute_pso = [](void* ctx, const wchar_t* /*name*/, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!d || !out_pso) return false;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+        VkResult r = self->vk_.create_comp_pipes(self->dev_, self->pipe_cache_, 1,
+                                                 static_cast<const VkComputePipelineCreateInfo*>(d), nullptr, &pipe);
+        if (self->boot_init_complete_ && perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        if (r != VK_SUCCESS) return false;
+        self->pso_dirty_ = true;
+        self->cache_dirty_frame_ = self->presents_;
+        *out_pso = reinterpret_cast<void*>(pipe);
+        return true;
+    };
+    desc.host.create_or_load_graphics_pso = [](void* ctx, const wchar_t* name, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!out_pso) return false;
+        // Special query: name == nullptr && desc == nullptr returns swapchain present VkRenderPass
+        if (!name && !d) {
+            *out_pso = reinterpret_cast<void*>(self->present_rp_);
+            return self->present_rp_ != VK_NULL_HANDLE;
+        }
+        if (!d) return false;
+        VkGraphicsPipelineCreateInfo ci = *static_cast<const VkGraphicsPipelineCreateInfo*>(d);
+        if (ci.renderPass == VK_NULL_HANDLE) ci.renderPass = self->present_rp_;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+        VkResult r = self->vk_.create_gfx_pipes(self->dev_, self->pipe_cache_, 1, &ci, nullptr, &pipe);
+        if (self->boot_init_complete_ && perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        if (r != VK_SUCCESS) return false;
+        self->pso_dirty_ = true;
+        self->cache_dirty_frame_ = self->presents_;
+        *out_pso = reinterpret_cast<void*>(pipe);
+        return true;
+    };
+    desc.host.flush = [](void* ctx) { static_cast<VulkanBackend*>(ctx)->Flush(); };
+    desc.host.upload = [](void* ctx, uint64_t size, uint64_t align, void** out_res, uint64_t* out_off, uint8_t** out_cpu,
+                          uint64_t* out_gpu) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        Alloc a = self->Upload(size, align);
+        if (a.buf == VK_NULL_HANDLE || !a.cpu) return false;
+        if (out_res) *out_res = reinterpret_cast<void*>(a.buf);
+        if (out_off) *out_off = a.off;
+        if (out_cpu) *out_cpu = a.cpu;
+        if (out_gpu) *out_gpu = a.off;
+        return true;
+    };
+    desc.host.get_pipeline_library = [](void* ctx) -> void* {
+        return reinterpret_cast<void*>(static_cast<VulkanBackend*>(ctx)->instance_);
+    };
+    upscaler_inited_ = u->Init(desc);
+}
+
+void VulkanBackend::LoadSettings() {
+    ComputeRenderExtents(render_w_, render_h_, vp_x_, vp_y_, vp_w_, vp_h_);
+    scale_x_ = float(render_w_) / float(guest_w_);
+    scale_y_ = float(render_h_) / float(guest_h_);
+    scale_ = scale_y_;
+    const app::Settings& s = app::Get();
+    last_upscaler_mode_ = s.upscaler;
+    last_upscale_quality_ = s.upscale_quality;
+    last_aspect_correct_ = s.aspect_correct_render;
+    texturedumper::Update();
+}
+
+// --- Synchronization, Recording, RenderPasses & Barriers ---
+
+uint64_t VulkanBackend::GetCompletedValue() const {
+    uint64_t v = 0;
+    if (timeline_sem_ != VK_NULL_HANDLE) vk_.get_sem_val(dev_, timeline_sem_, &v);
+    return v;
+}
+
+void VulkanBackend::WaitTimeline(uint64_t value) {
+    if (value == 0 || GetCompletedValue() >= value) return;
+    VkSemaphoreWaitInfo wi{VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO};
+    wi.semaphoreCount = 1;
+    wi.pSemaphores = &timeline_sem_;
+    wi.pValues = &value;
+    vk_.wait_sems(dev_, &wi, UINT64_MAX);
+}
+
+void VulkanBackend::WaitGpuFrame(uint64_t n) {
+    uint64_t fence = present_fence_[n % (kFrames + 1)].load();
+    if (fence) WaitTimeline(fence);
+}
+
+void VulkanBackend::Begin() {
+    Frame& f = CurrentFrame();
+    cmd_ = f.cmd;
+    VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vk_.begin_cmd_buf(cmd_, &bi);
+    if (ts_pool_ != VK_NULL_HANDLE && !ts_started_) {
+        uint32_t slot = uint32_t(frame_ % kFrames);
+        vk_.cmd_reset_qp(cmd_, ts_pool_, slot * 2u, 2u);
+        vk_.cmd_write_ts(cmd_, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, ts_pool_, slot * 2u);
+        ts_started_ = true;
+    }
+    if (!f.queries_used.empty() && occ_pool_ != VK_NULL_HANDLE) {
+        for (uint32_t q : f.queries_used) vk_.cmd_reset_qp(cmd_, occ_pool_, q, 1);
+        f.queries_used.clear();
+    }
+    bound_rt_ = bound_ds_ = nullptr;
+    in_render_pass_ = false;
+    rp_rt_ = rp_ds_ = nullptr;
+    binds_ = {};
+}
+
+void VulkanBackend::Submit(bool wait) {
+    EndRenderPass();
+    FlushPendingQueryResolves();
+    last_vsc_buf_ = VK_NULL_HANDLE;
+    last_dc_buf_ = VK_NULL_HANDLE;
+    vk_.end_cmd_buf(cmd_);
+
+    uint64_t sig_val = ++fence_value_;
+    uint32_t slot = uint32_t(frame_ % kFrames);
+    uint64_t wait_val = 0;
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+
+    VkTimelineSemaphoreSubmitInfo tsi{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+    tsi.signalSemaphoreValueCount = 1;
+    tsi.pSignalSemaphoreValues = &sig_val;
+
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, &tsi};
+    if (swap_acquired_) {
+        tsi.waitSemaphoreValueCount = 1;
+        tsi.pWaitSemaphoreValues = &wait_val;
+        si.waitSemaphoreCount = 1;
+        si.pWaitSemaphores = &img_avail_sems_[slot];
+        si.pWaitDstStageMask = &wait_stage;
+        swap_acquired_ = false;
+    }
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd_;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &timeline_sem_;
+    vk_.queue_submit(queue_, 1, &si, VK_NULL_HANDLE);
+
+    Frame& f = CurrentFrame();
+    f.fence = sig_val;
+    if (wait) {
+        WaitTimeline(sig_val);
+        vk_.reset_cmd_pool(dev_, f.cmd_pool, 0);
+        vk_.reset_desc_pool(dev_, f.desc_pool, 0);
+        for (VkDescriptorPool ep : f.extra_desc_pools) vk_.reset_desc_pool(dev_, ep, 0);
+        f.desc_cache.clear();
+        FreeDeferred(f.garbage);
+        f.used = 0;
+        Begin();
+    }
+}
+
+void VulkanBackend::SubmitPresent(uint32_t bi) {
+    EndRenderPass();
+    FlushPendingQueryResolves();
+    last_vsc_buf_ = VK_NULL_HANDLE;
+    last_dc_buf_ = VK_NULL_HANDLE;
+    vk_.end_cmd_buf(cmd_);
+
+    uint64_t sig_val = ++fence_value_;
+    uint32_t slot = uint32_t(frame_ % kFrames);
+
+    uint64_t wait_vals[1] = {0};
+    uint64_t sig_vals[2] = {0, sig_val};
+    VkTimelineSemaphoreSubmitInfo tsi{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+    tsi.signalSemaphoreValueCount = 2;
+    tsi.pSignalSemaphoreValues = sig_vals;
+
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSemaphore sig_sems[2] = {render_done_sems_[bi], timeline_sem_};
+
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, &tsi};
+    if (swap_acquired_) {
+        tsi.waitSemaphoreValueCount = 1;
+        tsi.pWaitSemaphoreValues = wait_vals;
+        si.waitSemaphoreCount = 1;
+        si.pWaitSemaphores = &img_avail_sems_[slot];
+        si.pWaitDstStageMask = &wait_stage;
+        swap_acquired_ = false;
+    }
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd_;
+    si.signalSemaphoreCount = 2;
+    si.pSignalSemaphores = sig_sems;
+    vk_.queue_submit(queue_, 1, &si, VK_NULL_HANDLE);
+
+    CurrentFrame().fence = sig_val;
+}
+
+void VulkanBackend::ResetFrame() {
+    Frame& f = CurrentFrame();
+    if (f.fence && GetCompletedValue() < f.fence) {
+        const bool perf_on = diag::Perf() || perf::Enabled();
+        auto perf_wait = perf_on ? PerfClock::now() : PerfClock::time_point{};
+        WaitTimeline(f.fence);
+        if (perf_on) g_perf.wait += PerfMs(perf_wait);
+    }
+    if (f.ts_valid && ts_pool_ != VK_NULL_HANDLE) {
+        uint32_t slot = uint32_t(frame_ % kFrames);
+        uint64_t ts[2] = {};
+        if (vk_.get_query_results(dev_, ts_pool_, slot * 2u, 2, sizeof(ts), ts, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+            ts[1] >= ts[0]) {
+            last_gpu_ms_ = double(ts[1] - ts[0]) * double(phys_props_.limits.timestampPeriod) / 1e6;
+        }
+        f.ts_valid = false;
+    }
+    vk_.reset_cmd_pool(dev_, f.cmd_pool, 0);
+    vk_.reset_desc_pool(dev_, f.desc_pool, 0);
+    for (VkDescriptorPool ep : f.extra_desc_pools) vk_.reset_desc_pool(dev_, ep, 0);
+    f.desc_cache.clear();
+    FreeDeferred(f.garbage);
+    f.used = 0;
+    Begin();
+}
+
+VulkanBackend::Alloc VulkanBackend::Upload(uint64_t size, uint64_t align) {
+    align = std::max<uint64_t>(align, 16);
+    Frame& f = CurrentFrame();
+    g_perf.upload += size;
+    uint64_t o = (f.used + align - 1) & ~(align - 1);
+    if (o + size <= upload_size_) {
+        f.used = o + size;
+        return {f.upload_buf, o, f.map + o};
+    }
+    g_perf.overflow++;
+    constexpr uint64_t kOwnAlign = 0x10000;
+    uint64_t alloc_sz = (std::max<uint64_t>(size, sizeof(DrawConstants)) + kOwnAlign - 1) & ~(kOwnAlign - 1);
+    VkBuffer buf = VK_NULL_HANDLE;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    uint8_t* p = nullptr;
+    VkBufferUsageFlags usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                               VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    if (CreateBuffer(alloc_sz, usage, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, buf,
+                     mem, &p) &&
+        p) {
+        f.garbage.push_back({VK_NULL_HANDLE, VK_NULL_HANDLE, buf, mem, VK_NULL_HANDLE});
+        return {buf, 0, p};
+    }
+    if (size <= upload_size_) {
+        perf::RecordMidFrameFlush();
+        Submit(true);
+        Frame& f2 = CurrentFrame();
+        f2.used = size;
+        return {f2.upload_buf, 0, f2.map};
+    }
+    LOGE("vulkan: upload allocation failed (%llu bytes)", (unsigned long long)size);
+    return {};
+}
+
+VkRenderPass VulkanBackend::GetRenderPass(VkFormat color_fmt, VkFormat depth_fmt) {
+    uint64_t key = (uint64_t(color_fmt) << 32) | uint64_t(depth_fmt);
+    auto it = rp_cache_.find(key);
+    if (it != rp_cache_.end()) return it->second;
+
+    VkAttachmentDescription atts[2]{};
+    uint32_t att_count = 0;
+    VkAttachmentReference color_ref{}, depth_ref{};
+    bool has_c = (color_fmt != VK_FORMAT_UNDEFINED);
+    bool has_d = (depth_fmt != VK_FORMAT_UNDEFINED);
+
+    if (has_c) {
+        auto& a = atts[att_count];
+        a.format = color_fmt;
+        a.samples = VK_SAMPLE_COUNT_1_BIT;
+        a.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        a.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        a.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        color_ref = {att_count++, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    }
+    if (has_d) {
+        auto& a = atts[att_count];
+        a.format = depth_fmt;
+        a.samples = VK_SAMPLE_COUNT_1_BIT;
+        a.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.initialLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        a.finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        depth_ref = {att_count++, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL};
+    }
+
+    VkSubpassDescription sub{};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = has_c ? 1u : 0u;
+    sub.pColorAttachments = has_c ? &color_ref : nullptr;
+    sub.pDepthStencilAttachment = has_d ? &depth_ref : nullptr;
+
+    VkRenderPassCreateInfo ci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    ci.attachmentCount = att_count;
+    ci.pAttachments = atts;
+    ci.subpassCount = 1;
+    ci.pSubpasses = &sub;
+    VkRenderPass rp = VK_NULL_HANDLE;
+    vk_.create_rp(dev_, &ci, nullptr, &rp);
+    rp_cache_[key] = rp;
+    return rp;
+}
+
+VkFramebuffer VulkanBackend::GetFramebuffer(VkRenderPass rp, VkImageView color_v, VkImageView depth_v, uint32_t w,
+                                            uint32_t h) {
+    FbKey k{rp, color_v, depth_v, w, h};
+    auto it = fb_cache_.find(k);
+    if (it != fb_cache_.end()) return it->second;
+
+    VkImageView atts[2]{};
+    uint32_t n = 0;
+    if (color_v != VK_NULL_HANDLE) atts[n++] = color_v;
+    if (depth_v != VK_NULL_HANDLE) atts[n++] = depth_v;
+
+    VkFramebufferCreateInfo fbi{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fbi.renderPass = rp;
+    fbi.attachmentCount = n;
+    fbi.pAttachments = atts;
+    fbi.width = w;
+    fbi.height = h;
+    fbi.layers = 1;
+    VkFramebuffer fb = VK_NULL_HANDLE;
+    vk_.create_fb(dev_, &fbi, nullptr, &fb);
+    fb_cache_[k] = fb;
+    return fb;
+}
+
+void VulkanBackend::InvalidateFramebuffersForView(VkImageView v) {
+    if (v == VK_NULL_HANDLE) return;
+    for (auto it = fb_cache_.begin(); it != fb_cache_.end();) {
+        if (it->first.color == v || it->first.depth == v) {
+            CurrentFrame().garbage.push_back({VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, it->second});
+            it = fb_cache_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void VulkanBackend::EnsureRenderPass(Target* rt, Target* ds) {
+    if (in_render_pass_ && rp_rt_ == rt && rp_ds_ == ds) return;
+    EndRenderPass();
+    if (!rt && !ds) return;
+    if (rt) TransitionImage(rt->img, rt->layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+    if (ds) {
+        TransitionImage(ds->img, ds->layout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+                        VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+    }
+    VkFormat cf = rt ? rt->vk_fmt : VK_FORMAT_UNDEFINED;
+    VkFormat df = ds ? ds->vk_fmt : VK_FORMAT_UNDEFINED;
+    VkRenderPass rp = GetRenderPass(cf, df);
+    uint32_t w = rt ? rt->w : ds->w;
+    uint32_t h = rt ? rt->h : ds->h;
+    VkFramebuffer fb = GetFramebuffer(rp, rt ? rt->att_view : VK_NULL_HANDLE, ds ? ds->att_view : VK_NULL_HANDLE, w, h);
+
+    VkRenderPassBeginInfo bi{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    bi.renderPass = rp;
+    bi.framebuffer = fb;
+    bi.renderArea = {{0, 0}, {w, h}};
+    vk_.cmd_begin_rp(cmd_, &bi, VK_SUBPASS_CONTENTS_INLINE);
+    in_render_pass_ = true;
+    rp_rt_ = rt;
+    rp_ds_ = ds;
+}
+
+void VulkanBackend::EnsureRawRenderPass(VkRenderPass rp, VkFramebuffer fb, uint32_t w, uint32_t h) {
+    EndRenderPass();
+    VkRenderPassBeginInfo bi{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    bi.renderPass = rp;
+    bi.framebuffer = fb;
+    bi.renderArea = {{0, 0}, {w, h}};
+    vk_.cmd_begin_rp(cmd_, &bi, VK_SUBPASS_CONTENTS_INLINE);
+    in_render_pass_ = true;
+    rp_rt_ = nullptr;
+    rp_ds_ = nullptr;
+}
+
+void VulkanBackend::EndRenderPass() {
+    if (!in_render_pass_) return;
+    vk_.cmd_end_rp(cmd_);
+    in_render_pass_ = false;
+    rp_rt_ = rp_ds_ = nullptr;
+    binds_ = {};
+    FlushPendingQueryResolves();
+}
+
+void VulkanBackend::FlushPendingQueryResolves() {
+    if (pending_query_resolves_.empty() || occ_pool_ == VK_NULL_HANDLE || occ_rb_ == VK_NULL_HANDLE) return;
+    for (uint32_t q : pending_query_resolves_) {
+        vk_.cmd_copy_qp_res(cmd_, occ_pool_, q, 1, occ_rb_, VkDeviceSize(q) * sizeof(uint64_t), sizeof(uint64_t),
+                            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+    }
+    pending_query_resolves_.clear();
+}
+
+void VulkanBackend::TransitionImage(VkImage img, VkImageLayout& cur, VkImageLayout want, VkImageAspectFlags aspect,
+                                    uint32_t mips, uint32_t layers) {
+    if (cur == want && want != VK_IMAGE_LAYOUT_GENERAL) return;
+    EndRenderPass();
+    VkPipelineStageFlags src_stage = 0, dst_stage = 0;
+    VkAccessFlags src_acc = 0, dst_acc = 0;
+    LayoutStageAccess(cur, src_stage, src_acc);
+    LayoutStageAccess(want, dst_stage, dst_acc);
+
+    VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    b.srcAccessMask = src_acc;
+    b.dstAccessMask = dst_acc;
+    b.oldLayout = cur;
+    b.newLayout = want;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = img;
+    b.subresourceRange = {aspect, 0, mips, 0, layers};
+    vk_.cmd_barrier(cmd_, src_stage, dst_stage, 0, 0, nullptr, 0, nullptr, 1, &b);
+    cur = want;
+}
