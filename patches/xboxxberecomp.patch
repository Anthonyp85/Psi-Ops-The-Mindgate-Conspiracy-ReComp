+// Minimal RGBA8 PNG decoder (via zlib) for loading <kGame.log>.png as the SDL3 window icon.
+uint32_t ReadBe32(const uint8_t* p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+uint8_t Paeth(uint8_t a, uint8_t b, uint8_t c) {
+    int p = int(a) + int(b) - int(c);
+    int pa = std::abs(p - int(a));
+    int pb = std::abs(p - int(b));
+    int pc = std::abs(p - int(c));
+    if (pa <= pb && pa <= pc) return a;
+    return (pb <= pc) ? b : c;
+}
+
+bool DecodePngRgba(const fs::path& path, uint32_t& out_w, uint32_t& out_h, std::vector<uint8_t>& out_rgba) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f) return false;
+    std::vector<uint8_t> data((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    static constexpr uint8_t kSig[8] = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+    if (data.size() < 33 || std::memcmp(data.data(), kSig, 8) != 0) return false;
+
+    uint32_t w = 0, h = 0;
+    uint8_t bit_depth = 0, color_type = 0;
+    std::vector<uint8_t> idat;
+    size_t pos = 8;
+    while (pos + 12 <= data.size()) {
+        uint32_t len = ReadBe32(data.data() + pos);
+        const uint8_t* tag = data.data() + pos + 4;
+        if (pos + 12 + len > data.size()) break;
+        const uint8_t* body = data.data() + pos + 8;
+        if (std::memcmp(tag, "IHDR", 4) == 0 && len >= 13) {
+            w = ReadBe32(body);
+            h = ReadBe32(body + 4);
+            bit_depth = body[8];
+            color_type = body[9];
+        } else if (std::memcmp(tag, "IDAT", 4) == 0) {
+            idat.insert(idat.end(), body, body + len);
+        } else if (std::memcmp(tag, "IEND", 4) == 0) {
+            break;
+        }
+        pos += 12 + size_t(len);
+    }
+    if (w == 0 || h == 0 || w > 1024 || h > 1024 || bit_depth != 8 || (color_type != 6 && color_type != 2) ||
+        idat.empty()) {
+        return false;
+    }
+
+    size_t bpp = (color_type == 6) ? 4 : 3;
+    size_t stride = size_t(w) * bpp;
+    uLongf raw_len = uLongf(size_t(h) * (stride + 1));
+    std::vector<uint8_t> raw(raw_len);
+    if (uncompress(raw.data(), &raw_len, idat.data(), uLong(idat.size())) != Z_OK ||
+        raw_len != size_t(h) * (stride + 1)) {
+        return false;
+    }
+
+    std::vector<uint8_t> unfilt(size_t(h) * stride);
+    for (uint32_t y = 0; y < h; ++y) {
+        uint8_t ftype = raw[size_t(y) * (stride + 1)];
+        const uint8_t* src = raw.data() + size_t(y) * (stride + 1) + 1;
+        uint8_t* dst = unfilt.data() + size_t(y) * stride;
+        const uint8_t* prev = (y > 0) ? (unfilt.data() + size_t(y - 1) * stride) : nullptr;
+        for (size_t x = 0; x < stride; ++x) {
+            uint8_t a = (x >= bpp) ? dst[x - bpp] : 0;
+            uint8_t b = prev ? prev[x] : 0;
+            uint8_t c = (prev && x >= bpp) ? prev[x - bpp] : 0;
+            uint8_t v = src[x];
+            switch (ftype) {
+                case 0: dst[x] = v; break;
+                case 1: dst[x] = uint8_t(v + a); break;
+                case 2: dst[x] = uint8_t(v + b); break;
+                case 3: dst[x] = uint8_t(v + ((int(a) + int(b)) >> 1)); break;
+                case 4: dst[x] = uint8_t(v + Paeth(a, b, c)); break;
+                default: return false;
+            }
+        }
+    }
+
+    out_w = w;
+    out_h = h;
+    out_rgba.resize(size_t(w) * h * 4);
+    if (bpp == 4) {
+        std::memcpy(out_rgba.data(), unfilt.data(), out_rgba.size());
+    } else {
+        for (size_t i = 0; i < size_t(w) * h; ++i) {
+            out_rgba[i * 4 + 0] = unfilt[i * 3 + 0];
+            out_rgba[i * 4 + 1] = unfilt[i * 3 + 1];
+            out_rgba[i * 4 + 2] = unfilt[i * 3 + 2];
+            out_rgba[i * 4 + 3] = 255;
+        }
+    }
+    return true;
+}
