+            ids += " \\\n\tX(" + name + ")";
+            export_funcs.insert("sub_" + name);
+        } else {
+            export_funcs.insert(fmt("sub_%08X", a));
+        }
+    }
+    for (auto& [va, _] : cfg.functions) {
+        if (!cfg.named) export_funcs.insert(fmt("sub_%08X", va));
+    }
+    for (auto& [name, va] : cfg.data) {
+        syms += fmt("#define SYM_%s %08X\n#define HAS_%s %d\n", name.c_str(), va, name.c_str(), va ? 1 : 0);
+        ids += " \\\n\tX(" + name + ")";
+    }
+    if (cfg.named) syms += "#define IMAGE_NAMED 1\n#define IMAGE_SYMBOLS(X)" + ids + "\n";
