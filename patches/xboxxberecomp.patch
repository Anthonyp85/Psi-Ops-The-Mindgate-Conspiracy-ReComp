+        const DepthStencilSeed ds_sten_write{1, 0, 0, 0, 1, kCmpAlways, 255, 255, kStenKeep, kStenKeep, kStenZero};
+        const DepthStencilSeed ds_sten_incr{1, 0, 0, 0, 1, kCmpAlways, 255, 255, kStenKeep, kStenKeep, kStenIncr};
+        const DepthStencilSeed ds_sten_test{1, 0, 0, 0, 1, kCmpEqual, 255, 255, kStenKeep, kStenKeep, kStenKeep};
+        const DepthStencilSeed ds_3d_opaque_sten_zero{1, 1, 1, kCmpLessEqual, 1, kCmpAlways, 255, 255, kStenKeep,
+                                                      kStenKeep, kStenZero};
+        const DepthStencilSeed ds_3d_shadow_test{1, 1, 0, kCmpLessEqual, 1, kCmpEqual, 255, 255, kStenKeep, kStenKeep,
+                                                 kStenIncr};
+
+        const uint32_t max_strip = is_vulkan ? 1u : 0u;
+        for (uint32_t strip = 0; strip <= max_strip; ++strip) {
+            // 1. CRI Sofdec FMV, 2D UI, Fonts, SaturationAdjust FFP PSOs
+            for (uint64_t fmv_ps : {ps_fmv_quad, ps_fmv_p13_q0, ps_fmv_p13_q1}) {
+                AddPso(vs_104_q, fmv_ps, lay_104, bl_opaque_rgba, ds_2d_nods, strip);
+                AddPso(vs_104_q, fmv_ps, lay_104, bl_opaque_rgba, ds_2d_off, strip);
+                AddPso(vs_104_q, fmv_ps, lay_104, bl_alpha_rgb, ds_2d_nods, strip);
+                AddPso(vs_104_q, fmv_ps, lay_104, bl_alpha_rgb, ds_sten_test, strip);
+            }
+            AddPso(vs_104_n, ps_fmv_quad, lay_104, bl_opaque_rgba, ds_2d_off, strip);
+
+            for (const auto& bl : {bl_opaque_rgb, bl_alpha_rgb, bl_alpha_rgba, bl_additive}) {
+                AddPso(vs_142_q, ps_ui_mod_q, lay_142, bl, ds_2d_off, strip);
+                AddPso(vs_142_n, ps_ui_mod_n, lay_142, bl, ds_2d_off, strip);
+                AddPso(vs_144_q, ps_ui_mod_q, lay_144, bl, ds_2d_off, strip);
+                AddPso(vs_144_n, ps_ui_mod_n, lay_144, bl, ds_2d_off, strip);
+                AddPso(vs_209f_q, ps_ui_mod_q, lay_209f, bl, ds_2d_off, strip);
+                AddPso(vs_209f_n, ps_ui_mod_n, lay_209f, bl, ds_2d_off, strip);
+                AddPso(vs_209s_q, ps_ui_mod_q, lay_209s, bl, ds_2d_off, strip);
+                AddPso(vs_209s_n, ps_ui_mod_n, lay_209s, bl, ds_2d_off, strip);
+            }
+            // Exact Psi-Ops UI / Font / Menu PSOs (both stage1=DISABLE and stages 1..3 PassMissingTexture)
+            for (int rect = 0; rect <= 1; ++rect) {
+                for (int atest = 0; atest <= 1; ++atest) {
+                    for (int p13 = 0; p13 <= 1; ++p13) {
+                        const uint64_t ps_n = p13 ? ps_ui_p13_mod[rect][0][atest] : ps_ui_mod[rect][0][atest];
+                        const uint64_t ps_q = p13 ? ps_ui_p13_mod[rect][1][atest] : ps_ui_mod[rect][1][atest];
+                        // Non-quad UI & Fonts (Z-test LEQUAL no-write, alpha RGBA/RGB)
+                        for (const auto& bl : {bl_alpha_rgb, bl_alpha_rgba}) {
+                            AddPso(vs_142_n, ps_n, lay_142, bl, ds_3d_trans, strip);
+                            AddPso(vs_209f_n, ps_n, lay_209f, bl, ds_3d_trans, strip);
+                            AddPso(vs_209s_n, ps_n, lay_209s, bl, ds_3d_trans, strip);
+                            AddPso(vs_209f_n, ps_n, lay_209f, bl, ds_2d_off, strip);
+                            AddPso(vs_209s_n, ps_n, lay_209s, bl, ds_2d_off, strip);
+                        }
+                        // Quad UI overlays & stencil masks
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_depth_only, ds_sten_write, strip);
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_alpha_rgb, ds_2d_nods, strip);
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_alpha_rgb, ds_2d_off, strip);
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_alpha_rgb, ds_3d_trans, strip);
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_alpha_rgb, ds_sten_incr, strip);
+                        AddPso(vs_209f_q, ps_q, lay_209f, bl_alpha_rgb, ds_sten_test, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_depth_only, ds_sten_write, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_alpha_rgb, ds_2d_nods, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_alpha_rgb, ds_2d_off, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_alpha_rgb, ds_3d_trans, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_alpha_rgb, ds_sten_incr, strip);
+                        AddPso(vs_209s_q, ps_q, lay_209s, bl_alpha_rgb, ds_sten_test, strip);
+                    }
+
+                    // Stage 0 MODULATE(TEX, CURRENT) + ALPHAOP=DISABLE (LEVEL97C shell/quit-to-menu & 2D UI)
+                    const uint64_t ps_da_n = ps_ui_p13_mod_da[rect][0][atest];
+                    const uint64_t ps_da_q = ps_ui_p13_mod_da[rect][1][atest];
+                    for (const auto& bl : {bl_alpha_rgb, bl_alpha_rgba, bl_opaque_rgb}) {
+                        AddPso(vs_209f_n, ps_da_n, lay_209f, bl, ds_3d_trans, strip);
+                        AddPso(vs_209s_n, ps_da_n, lay_209s, bl, ds_3d_trans, strip);
+                        AddPso(vs_209f_n, ps_da_n, lay_209f, bl, ds_2d_off, strip);
+                        AddPso(vs_209s_n, ps_da_n, lay_209s, bl, ds_2d_off, strip);
+                        AddPso(vs_209f_q, ps_da_q, lay_209f, bl, ds_3d_trans, strip);
+                        AddPso(vs_209s_q, ps_da_q, lay_209s, bl, ds_3d_trans, strip);
+                        AddPso(vs_209f_q, ps_da_q, lay_209f, bl, ds_2d_off, strip);
+                        AddPso(vs_209s_q, ps_da_q, lay_209s, bl, ds_2d_off, strip);
+                        AddPso(vs_209f_q, ps_da_q, lay_209f, bl, ds_2d_nods, strip);
+                        AddPso(vs_209s_q, ps_da_q, lay_209s, bl, ds_2d_nods, strip);
+                    }
+                }
+            }
+            for (int atest = 0; atest <= 1; ++atest) {
+                AddPso(vs_209f_q, ps_ui_p13_notex[1][atest], lay_209f, bl_depth_only, ds_sten_write, strip);
+                AddPso(vs_209f_q, ps_ui_p13_notex[1][atest], lay_209f, bl_alpha_rgb, ds_2d_nods, strip);
+                AddPso(vs_209f_q, ps_ui_p13_notex[1][atest], lay_209f, bl_alpha_rgb, ds_2d_off, strip);
+                AddPso(vs_209f_q, ps_ui_p13_notex[1][atest], lay_209f, bl_alpha_rgb, ds_3d_trans, strip);
+                AddPso(vs_209f_q, ps_ui_p13_notex[1][atest], lay_209f, bl_alpha_rgb, ds_sten_incr, strip);
+                AddPso(vs_209f_n, ps_ui_p13_notex[0][atest], lay_209f, bl_alpha_rgb, ds_3d_trans, strip);
+                AddPso(vs_209s_n, ps_ui_p13_notex[0][atest], lay_209s, bl_alpha_rgb, ds_3d_trans, strip);
+            }
+            AddPso(vs_209f_q, ps_ui_notex_q, lay_209f, bl_alpha_rgb, ds_2d_off, strip);
+            AddPso(vs_209f_n, ps_ui_notex_n, lay_209f, bl_alpha_rgb, ds_2d_off, strip);
+            AddPso(vs_209f_q, ps_ui_notex_q, lay_209f, bl_depth_only, ds_sten_write, strip);
+            AddPso(vs_209f_q, ps_ui_notex_q, lay_209f, bl_depth_only, ds_sten_incr, strip);
+            AddPso(vs_209f_n, ps_ui_mod_n, lay_209f, bl_alpha_rgb, ds_sten_test, strip);
+            for (uint64_t ps : sat_ps) {
+                AddPso(vs_142_q, ps, lay_142, bl_opaque_rgb, ds_2d_off, strip);
+                AddPso(vs_142_q, ps, lay_142, bl_alpha_rgb, ds_2d_off, strip);
+            }
+
+            // 2. 3D Mesh VS (zoneMesh, mesh, meshUnlit, skinMesh) x Material Layer PS (UV-count matched)
+            for (const auto& vs : mesh_vs) {
+                for (const LayerPsRef& lps : layer_ps) {
+                    if (lps.num_tex > vs.num_uvs && !(lps.num_tex == 2 && lps.additive)) continue;
+                    AddPso(vs.hash, lps.hash, vs.layout, bl_opaque_rgb, ds_3d_opaque, strip);
+                    AddPso(vs.hash, lps.hash, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    if (lps.num_tex == 1 || lps.additive) AddPso(vs.hash, lps.hash, vs.layout, bl_additive, ds_3d_trans, strip);
+                    if (lps.num_tex == 1 || lps.subtractive) AddPso(vs.hash, lps.hash, vs.layout, bl_subtractive, ds_3d_trans, strip);
+                    // Depth-only Z-prepass (wmask=0) & character/prop shadow stencil clear pass
+                    if (lps.num_tex <= 2) {
+                        AddPso(vs.hash, lps.hash, vs.layout, bl_depth_only, ds_3d_opaque, strip);
+                    }
+                    if (lps.num_tex == 1) {
+                        AddPso(vs.hash, lps.hash, vs.layout, bl_opaque_rgb, ds_3d_opaque_sten_zero, strip);
+                        AddPso(vs.hash, lps.hash, vs.layout, bl_opaque_rgb, ds_3d_trans, strip);
+                        AddPso(vs.hash, lps.hash, vs.layout, bl_alpha_rgb, ds_3d_opaque, strip);
+                        AddPso(vs.hash, lps.hash, vs.layout, bl_alpha_rgb, ds_3d_shadow_test, strip);
+                    }
+                }
+            }
+
+            // 3. Shadow VS (shadow, shadowSkinned) x shadow.psh
+            for (const auto& vs : shadow_vs) {
+                for (uint64_t ps : shadow_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_3d_opaque, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_shadow_test, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_depth_only, ds_sten_incr, strip);
+                }
+            }
+
+            // 4. Particles (ParticleSimple, ParticleDistortion)
+            for (const auto& vs : psimple_vs) {
+                for (uint64_t ps : psimple_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_2d_off, strip);
+                }
+            }
+            for (const auto& vs : pdistort_vs) {
+                for (uint64_t ps : pdistort_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                }
+            }
+
+            // 5. GenericMesh, GenericMesh2D, MotionBlurMesh, PerPixelFog
+            for (const auto& vs : generic_vs) {
+                for (uint64_t ps : generic_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_3d_opaque, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgba, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_depth_only, ds_3d_opaque, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_2d_off, strip);
+                }
+            }
+            for (const auto& vs : generic2d_vs) {
+                for (uint64_t ps : generic2d_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgba, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_sten_test, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_2d_off, strip);
+                }
+            }
+            for (const auto& vs : mblur_vs) {
+                for (uint64_t ps : mblur_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgba, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_sten_test, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_sten_test, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_subtractive, ds_2d_off, strip);
+                }
+            }
+            for (const auto& vs : fog_vs) {
+                for (uint64_t ps : fog_ps) {
+                    AddPso(vs.hash, ps, vs.layout, bl_opaque_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_2d_nods, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_alpha_rgb, ds_3d_trans, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_2d_off, strip);
+                    AddPso(vs.hash, ps, vs.layout, bl_additive, ds_3d_trans, strip);
+                }
+            }
+        }
+    }
+};
