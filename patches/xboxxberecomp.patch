+void TrySetWindowIcon(SDL_Window* win) {
+    if (!win) return;
+    std::error_code ec;
+    fs::path dir = ExeDir();
+    fs::path icon_path;
+    std::string icon_file = (kGame.log && *kGame.log) ? (std::string(kGame.log) + ".png") : "app.png";
+    for (int i = 0; i < 5; ++i) {
+        if (fs::is_regular_file(dir / icon_file, ec)) {
+            icon_path = dir / icon_file;
+            break;
+        }
+        if (fs::is_regular_file(dir / "resources" / icon_file, ec)) {
+            icon_path = dir / "resources" / icon_file;
+            break;
+        }
+        if (fs::is_regular_file(dir / "src" / "res" / icon_file, ec)) {
+            icon_path = dir / "src" / "res" / icon_file;
+            break;
+        }
+        if (!dir.has_parent_path() || dir.parent_path() == dir) break;
+        dir = dir.parent_path();
+    }
+    if (icon_path.empty()) return;
+    uint32_t w = 0, h = 0;
+    std::vector<uint8_t> rgba;
+    if (!DecodePngRgba(icon_path, w, h, rgba)) return;
+    if (SDL_Surface* surf = SDL_CreateSurfaceFrom(int(w), int(h), SDL_PIXELFORMAT_RGBA32, rgba.data(), int(w * 4))) {
+        SDL_SetWindowIcon(win, surf);
+        SDL_DestroySurface(surf);
+    }
+}
