+
+WRange ProjectionWRange(const float* m) {
+    float m33 = m[10], m34 = m[11], m43 = m[14], m44 = m[15];
+    if (m33 == m34 || m33 == 0) return {0, 1};
+    return {m44 - m43 / m33 * m34, (m44 - m43) / (m33 - m34) * m34 + m44};
+}
+
+WRange DrawWRange(const State& s, bool program) {
+    WRange r{0, s.zscale};
+    if (!program) {
+        r = ProjectionWRange(s.transforms[3].data());
+    } else if (SimpleState(s, 0x398)) {
+        r.near_w = Bits(SimpleState(s, 0x394));
+    }
+    if (r.near_w <= 0 || r.near_w >= r.far_w) r.near_w = r.far_w * (1.0f / 65536.0f);
+    return r;
+}
