+bool ShouldBypassLauncher() {
+    const auto& args = ProcessArgs();
+    if (HasCliFlag(args, "--launcher") || HasCliFlag(args, "--capture-launcher-bmp") ||
+        HasCliFlag(args, "--launcher-autoplay-ms") || EnvTruthy("XBE_SHOW_LAUNCHER") ||
+        EnvTruthy("XBE_LAUNCHER_AUTOPLAY_MS"))
+        return false;
+    if (HasCliFlag(args, "--validate-iso") || HasCliFlag(args, "--create-shortcut") ||
+        HasCliFlag(args, "--relaunched") || HasCliFlag(args, "--no-launcher") || EnvTruthy("XBE_NO_LAUNCHER") ||
+        HasCliFlag(args, "--replay-input") || EnvTruthy("XBE_INPUT_REPLAY") ||
+        HasCliFlag(args, "--record-input") || EnvTruthy("XBE_INPUT_RECORD") ||
+        HasCliFlag(args, "--replay-mode") || HasCliFlag(args, "--replay-exit") || HasCliFlag(args, "--state-log") ||
+        EnvTruthy("XBE_AUTOTEST") || EnvTruthy("PSIOPS_AUTOTEST") || EnvTruthy("XBE_MKB_AUTOTEST") ||
+        HasCliFlag(args, "--auto-start") || EnvTruthy("XBE_AUTO_START") ||
+        HasCliFlag(args, "--non-interactive") || HasCliFlag(args, "--open-settings") ||
+        EnvTruthy("XBE_OPEN_SETTINGS") || HasCliFlag(args, "--capture-ui-bmp") || EnvTruthy("XBE_CAPTURE_UI_BMP") ||
+        HasCliFlag(args, "--capture-bmp") || HasCliFlag(args, "--capture-at-gframe") ||
+        HasCliFlag(args, "--capture-after-frames") || HasCliFlag(args, "--capture-after-3d-frames")) {
+        return true;
+    }
+    if (SDL_WasInit(SDL_INIT_VIDEO) && ((SDL_GetModState() & SDL_KMOD_SHIFT) != 0)) return false;
