+void D3D12Backend::RunAotPrecompile() {
+    if (!cache_enabled_) return;
+    auto t0 = PerfClock::now();
+    const uint64_t expected_sig = ComputeAotContentSignature("d3d12");
+    const std::filesystem::path stamp_path = AotStampPath("d3d12", adapter_desc_.VendorId, adapter_desc_.DeviceId);
