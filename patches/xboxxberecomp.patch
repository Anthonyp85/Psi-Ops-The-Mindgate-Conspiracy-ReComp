+#else
+#include "gpu/dxgi_compat.h"
+#endif
+
+#include "app/app.h"
+#include "core/log.h"
+#include "gpu/vertex.h"
+#include "imgui.h"
+#include "kernel/disc.h"
+
+extern const char kImageSha1[];
+
+namespace gpu {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+constexpr uint64_t kDeclarationSalt = 0x10000ull;
+constexpr uint64_t kPretransformedSalt = 0x5A5Aull;
+constexpr uint64_t kQuadSalt = 0xC3C30000ull;
+constexpr uint64_t kSpriteSalt = 0x3C3C0000ull;
+constexpr uint64_t kPixelKeySalt = 0x9E3779B97F4A7C15ull;
+
+FILE* OpenRead(const fs::path& p) {
+#ifdef _WIN32
+    return _wfopen(p.c_str(), L"rb");
+#else
+    return std::fopen(p.c_str(), "rb");
+#endif
+}
+
+FILE* OpenWrite(const fs::path& p) {
+#ifdef _WIN32
+    return _wfopen(p.c_str(), L"wb");
+#else
+    return std::fopen(p.c_str(), "wb");
+#endif
+}
+
+struct DiskD3D12ShaderHeader {
+    char magic[4];
+    uint32_t version;
+    uint32_t ptr_size;
+    uint32_t reserved;
+};
+static_assert(sizeof(DiskD3D12ShaderHeader) == 16);
+
+struct DiskVkShaderHeader {
+    char magic[4];
+    uint32_t version;
+    uint32_t abi;
+    uint32_t reserved;
+};
+static_assert(sizeof(DiskVkShaderHeader) == 16);
+
+struct DiskD3D12MetaHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t sizeof_pso_key;
+    uint32_t vendor_id;
+    uint32_t device_id;
+    uint32_t subsys_id;
+    uint32_t revision;
+    uint32_t src_count;
+    uint32_t pso_count;
+    uint32_t reserved;
+};
+static_assert(sizeof(DiskD3D12MetaHeader) == 40);
+
+struct DiskVkMetaHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t sizeof_pso_key;
+    uint32_t vendor_id;
+    uint32_t device_id;
+    uint32_t driver_version;
+    uint8_t uuid[16];
+    uint32_t src_count;
+    uint32_t pso_count;
+};
+static_assert(sizeof(DiskVkMetaHeader) == 48);
+
+// ESPx v6 container headers used by .xbox archives on the mounted disc
+struct EspxV6Header {
+    char magic[4];            // "ESPx"
+    uint32_t version;         // 6
+    uint32_t build_id;
+    uint32_t type_dir_off;
+    uint32_t type_dir_size;
+    uint32_t entry_tbl_off;
+    uint32_t entry_tbl_size;
+    uint32_t reloc_off;
+    uint32_t reloc_size;
+    uint32_t str_tbl_off;
+    uint32_t str_tbl_size;
+};
+static_assert(sizeof(EspxV6Header) == 44);
+
+struct EspxTypeRecord {
+    char fourcc[4];
+    uint32_t count;
+    uint32_t flag;
+    uint32_t entry_rel_off;
+};
+static_assert(sizeof(EspxTypeRecord) == 16);
+
+struct EspxEntryRecord {
+    char fourcc[4];
+    uint32_t unk04;
+    uint32_t data_size;
+    uint32_t name_str_off;
+    uint32_t data_file_off;
+    uint32_t unk14;
+};
+static_assert(sizeof(EspxEntryRecord) == 24);
+
+uint32_t ReadLe32(const uint8_t* p) {
+    uint32_t v = 0;
+    std::memcpy(&v, p, 4);
+    return v;
+}
+
+std::string LowerAscii(std::string_view sv) {
+    std::string out(sv.size(), '\0');
+    for (size_t i = 0; i < sv.size(); ++i) {
+        out[i] = char(std::tolower(static_cast<unsigned char>(sv[i])));
+    }
+    return out;
+}
+
+bool EndsWith(std::string_view s, std::string_view suffix) {
+    return s.size() >= suffix.size() && s.compare(s.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+std::string BaseLowerName(std::string_view raw) {
+    size_t pos = raw.find_last_of("\\/");
+    std::string_view base = (pos == std::string_view::npos) ? raw : raw.substr(pos + 1);
+    return LowerAscii(base);
+}
+
+std::string SpriteSizeHlslLocal(std::string s) {
+    const char* tc3 = "    o.tc3 = oT3;\n";
+    size_t at = s.find(tc3);
+    if (at != std::string::npos) {
+        s.replace(at, std::strlen(tc3), "    o.tc3 = oPts;\n");
+    }
+    return s;
+}
+
+uint32_t PackElem(uint8_t fmt, uint8_t buf, uint16_t off) {
+    return uint32_t(fmt) | (uint32_t(buf) << 8) | (uint32_t(off) << 16);
+}
+
+struct VertexLayoutSeed {
+    uint16_t regs = 0;
+    uint64_t decode = 0;
+    uint32_t elements[16] = {};
+    uint32_t buf_count = 1;
+    uint16_t strides[16] = {};
+    bool pretransformed = false;
+    uint32_t fvf_or_handle = 1u;  // 1u = decl-only, else FVF value
+};
+
+struct BlendSeed {
+    uint32_t blend = 0;
+    uint32_t src = 0;
+    uint32_t dst = 0;
+    uint32_t op = 0;
+    uint32_t wmask = 15;
+};
+
+struct DepthStencilSeed {
+    uint32_t has_ds = 1;
+    uint32_t zen = 0;
+    uint32_t zwrite = 0;
+    uint32_t zfunc = 0;
+    uint32_t sten = 0;
+    uint32_t sfunc = 0;
+    uint32_t smask = 0;
+    uint32_t swmask = 0;
+    uint32_t sfail = 0;
+    uint32_t szfail = 0;
+    uint32_t spass = 0;
+};
+
+// Copyright-clean standard D3D8/NV2A numeric pipeline state enums
+constexpr uint32_t kBlendOne = 1;
+constexpr uint32_t kBlendSrcAlpha = 0x0302;     // 770
+constexpr uint32_t kBlendInvSrcAlpha = 0x0303;  // 771
+constexpr uint32_t kBlendOpAdd = 0x8006;        // 32774
+constexpr uint32_t kBlendOpRevSub = 0x800B;     // 32779
+constexpr uint32_t kCmpEqual = 0x0202;          // 514
+constexpr uint32_t kCmpLessEqual = 0x0203;      // 515
+constexpr uint32_t kCmpAlways = 0x0207;         // 519
+constexpr uint32_t kStenZero = 0;
+constexpr uint32_t kStenKeep = 0x1E00;          // 7680
+constexpr uint32_t kStenIncr = 0x1E02;          // 7682
+
+// Standard D3D8 Texture Stage State enums (D3DTOP / D3DTA)
+constexpr uint32_t kTopDisable = 1;
+constexpr uint32_t kTopSelectArg1 = 2;
+constexpr uint32_t kTopSelectArg2 = 3;
+constexpr uint32_t kTopModulate = 4;
+constexpr uint32_t kTaDiffuse = 0;
+constexpr uint32_t kTaCurrent = 1;
+constexpr uint32_t kTaTexture = 2;
+
+// Fixed-function layouts (FVF 0x104, 0x142, 0x144, Font custom decl 0x209)
+VertexLayoutSeed MakeLayout_Fvf104() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0201;  // v0 (XYZRHW), v9 (TEX0)
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0);
+    v.elements[9] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 16);
+    v.buf_count = 1;
+    v.strides[0] = 24;
+    v.pretransformed = true;
+    v.fvf_or_handle = 0x104u;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Fvf142() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0209;  // v0 (XYZ), v3 (DIFFUSE), v9 (TEX0)
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 0);
+    v.elements[3] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 12);
+    v.elements[9] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 16);
+    v.buf_count = 1;
+    v.strides[0] = 24;
+    v.pretransformed = false;
+    v.fvf_or_handle = 0x142u;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Fvf144() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0209;  // v0 (XYZRHW), v3 (DIFFUSE), v9 (TEX0)
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0);
+    v.elements[3] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 16);
+    v.elements[9] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 20);
+    v.buf_count = 1;
+    v.strides[0] = 28;
+    v.pretransformed = true;
+    v.fvf_or_handle = 0x144u;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Decl209Float() {
+    VertexLayoutSeed v = MakeLayout_Fvf142();
+    v.fvf_or_handle = 1u;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Decl209Short2() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0209;  // Font decl: v0 FLOAT3, v3 D3DCOLOR, v9 SHORT2 (kDecodeInt)
+    v.decode = uint64_t(kDecodeInt) << (9 * 4);
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 0);
+    v.elements[3] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 12);
+    v.elements[9] = PackElem(DXGI_FORMAT_R16G16_SINT, 0, 16);
+    v.buf_count = 1;
+    v.strides[0] = 20;
+    v.pretransformed = false;
+    v.fvf_or_handle = 1u;
+    return v;
+}
+
+// Programmable NV2A vertex layouts
+VertexLayoutSeed MakeLayout_Prog025() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0025;  // v0 pos, v2 diffuse, v5 uv0
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 0);
+    v.elements[2] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 12);
+    v.elements[5] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 16);
+    v.buf_count = 1;
+    v.strides[0] = 24;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog065() {
+    VertexLayoutSeed v = MakeLayout_Prog025();
+    v.regs = 0x0065;  // + v6 uv1 (ParticleDistortion)
+    v.elements[6] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 24);
+    v.strides[0] = 32;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog027() {
+    VertexLayoutSeed v{};
+    v.regs = 0x0027;  // v0 pos, v1 norm, v2 diffuse, v5 uv0
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 0);
+    v.elements[1] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 12);
+    v.elements[2] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 24);
+    v.elements[5] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 28);
+    v.buf_count = 1;
+    v.strides[0] = 36;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog067() {
+    VertexLayoutSeed v = MakeLayout_Prog027();
+    v.regs = 0x0067;  // + v6 uv1
+    v.elements[6] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 36);
+    v.strides[0] = 44;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog0E7() {
+    VertexLayoutSeed v = MakeLayout_Prog067();
+    v.regs = 0x00E7;  // + v7 uv2
+    v.elements[7] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 44);
+    v.strides[0] = 52;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog1E7() {
+    VertexLayoutSeed v = MakeLayout_Prog0E7();
+    v.regs = 0x01E7;  // + v8 uv3 (4-UV zoneMesh material)
+    v.elements[8] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, 52);
+    v.strides[0] = 60;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog03F(bool raw_int_decode = true) {
+    VertexLayoutSeed v{};
+    v.regs = 0x003F;  // v0 pos, v1 norm, v2 color, v3 bone idx (SHORT4), v4 weights (FLOAT4), v5 uv0
+    v.decode = raw_int_decode ? (uint64_t(kDecodeInt) << (3 * 4)) : 0ull;
+    v.elements[0] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 0);
+    v.elements[1] = PackElem(DXGI_FORMAT_R32G32B32_FLOAT, 0, 12);
+    v.elements[2] = PackElem(DXGI_FORMAT_B8G8R8A8_UNORM, 0, 24);
+    v.elements[3] = PackElem(raw_int_decode ? DXGI_FORMAT_R16G16B16A16_SINT : DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 28);
+    v.elements[4] = PackElem(DXGI_FORMAT_R32G32B32A32_FLOAT, 0, raw_int_decode ? 36 : 44);
+    v.elements[5] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, raw_int_decode ? 52 : 60);
+    v.buf_count = 1;
+    v.strides[0] = raw_int_decode ? 60 : 68;
+    return v;
+}
+
+VertexLayoutSeed MakeLayout_Prog07F(bool raw_int_decode = true) {
+    VertexLayoutSeed v = MakeLayout_Prog03F(raw_int_decode);
+    v.regs = 0x007F;  // + v6 uv1 (2-UV skinned mesh material)
+    v.elements[6] = PackElem(DXGI_FORMAT_R32G32_FLOAT, 0, raw_int_decode ? 60 : 68);
+    v.strides[0] = raw_int_decode ? 68 : 76;
+    return v;
+}
+
+bool IsValidNv2aVertexProgram(const uint32_t* words, uint32_t instr_count) {
+    if (!words || instr_count < 2 || instr_count > 136) return false;
+    bool writes_opos = false;
+    for (uint32_t i = 0; i < instr_count; ++i) {
+        const uint32_t w0 = words[i * 4 + 0];
+        const uint32_t w1 = words[i * 4 + 1];
+        const uint32_t w3 = words[i * 4 + 3];
+        if (w0 != 0u) return false;
+        const uint32_t mac = (w1 >> 21) & 0xFu;
+        const uint32_t ilu = (w1 >> 25) & 0x7u;
+        if (mac > 13u || ilu > 7u) return false;
+        const bool is_last = (w3 & 1u) != 0u;
+        if (i + 1u < instr_count && is_last) return false;
+        if (i + 1u == instr_count && !is_last) return false;
+        const uint32_t r = (w3 >> 20) & 0xFu;
+        const uint32_t omask = (w3 >> 12) & 0xFu;
+        if (r == 12u && (((w3 >> 24) & 0xFu) != 0u || ((w3 >> 16) & 0xFu) != 0u)) writes_opos = true;
+        if (omask != 0u && ((w3 >> 11) & 1u) != 0u && (((w3 >> 3) & 0xFu) == 0u)) writes_opos = true;
+    }
+    return writes_opos;
+}
+
+uint16_t DetectReferencedInputs(const std::vector<uint32_t>& prog) {
+    uint16_t mask = 0;
+    for (size_t i = 0; i + 4 <= prog.size(); i += 4) {
+        const uint32_t w1 = prog[i + 1];
+        const uint32_t w2 = prog[i + 2];
+        const uint32_t w3 = prog[i + 3];
+        const bool uses_in =
+            (((w2 >> 26) & 3u) == 2u) || (((w2 >> 11) & 3u) == 2u) || (((w3 >> 28) & 3u) == 2u);
+        if (uses_in) {
+            uint32_t v = (w1 >> 9) & 0xFu;
+            mask |= uint16_t(1u << v);
+        }
+    }
+    return mask;
+}
+
+// Replicates gpu::MakePixelKey for programmable D3DPIXELSHADERDEF (240 bytes / 60 dwords)
+PixelKey BuildProgPixelKey(const uint32_t def[60], const TexInfo tex[4], uint32_t quad, uint32_t alphatest) {
+    PixelKey k{};
+    std::memset(&k, 0, sizeof(k));
+    k.programmable = 1;
+    k.count = def[53];
+    for (int i = 0; i < 8; ++i) {
+        k.a_in[i] = def[i];
+        k.a_out[i] = def[26 + i];
+        k.rgb_in[i] = def[34 + i];
+        k.rgb_out[i] = def[45 + i];
+    }
+    k.final_abcd = def[8];
+    k.final_efg = def[9];
+    k.compare_mode = def[42];
+    k.dot_mapping = def[55];
+    k.input_texture = def[56];
+    k.quad = quad;
+    k.alphatest = alphatest;
+
+    const uint32_t modes = def[54];
+    for (int i = 0; i < 4; ++i) {
+        k.tex[i] = tex[i];
+        uint32_t m = (modes >> (i * 5)) & 0x1Fu;
+        const TexInfo& t = tex[i];
+        if (!t.kind && m != 4u && m != 5u && m != 0xAu && m != 0x11u) m = 0u;
+        else if (m >= 1u && m <= 3u) m = t.kind == kTexCube ? 3u : (t.kind == kTex3D || t.shadow) ? 2u : 1u;
+        else if (m == 0xDu || m == 0xEu) m = t.kind == kTexCube ? 0xEu : 0xDu;
+        k.tex_modes |= m << (i * 5);
+    }
+    return k;
+}
