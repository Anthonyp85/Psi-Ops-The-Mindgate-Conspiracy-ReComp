+void DecodeYuv422RowSse2(const uint8_t* src_row, uint8_t* dst_row, uint32_t w, bool yuy2) {
+    const __m128i kMaskLo16 = _mm_set1_epi16(0x00FF);
+    const __m128i kMaskLo32 = _mm_set1_epi32(0x0000FFFF);
+    const __m128i k16 = _mm_set1_epi16(16);
+    const __m128i k128 = _mm_set1_epi16(128);
+    const __m128i kRound = _mm_set1_epi16(4);
+    const __m128i kCY = _mm_set1_epi16(298 * 32);
+    const __m128i kRV = _mm_set1_epi16(409 * 32);
+    const __m128i kGU = _mm_set1_epi16(-100 * 32);
+    const __m128i kGV = _mm_set1_epi16(-208 * 32);
+    const __m128i kBU = _mm_set1_epi16(516 * 32);
+    const __m128i kAlpha = _mm_set1_epi8(static_cast<char>(0xFF));
