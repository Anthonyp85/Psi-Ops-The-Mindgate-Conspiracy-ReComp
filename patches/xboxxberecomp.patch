+bool WriteBmp32(const std::filesystem::path& path, uint32_t w, uint32_t h, const std::vector<uint8_t>& px,
+                bool swizzle_rb) {
+    if (!w || !h || px.size() < size_t(w) * h * 4) return false;
+    std::error_code ec;
+    if (path.has_parent_path()) std::filesystem::create_directories(path.parent_path(), ec);
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) return false;
+    uint8_t hd[54] = {'B', 'M'};
+    auto put = [&](int o, uint32_t v) { std::memcpy(hd + o, &v, 4); };
+    uint32_t img_bytes = uint32_t(size_t(w) * h * 4);
+    put(2, 54u + img_bytes);
+    put(10, 54u);
+    put(14, 40u);
+    put(18, w);
+    put(22, uint32_t(-int32_t(h)));
+    hd[26] = 1;
+    hd[28] = 32;
+    put(34, img_bytes);
+    bool ok = std::fwrite(hd, 1, 54, f) == 54;
+    if (ok) {
+        if (!swizzle_rb) {
+            ok = std::fwrite(px.data(), 1, img_bytes, f) == img_bytes;
+        } else {
+            std::vector<uint8_t> bgra(img_bytes);
+            for (size_t i = 0; i < img_bytes; i += 4) {
+                bgra[i + 0] = px[i + 2];
+                bgra[i + 1] = px[i + 1];
+                bgra[i + 2] = px[i + 0];
+                bgra[i + 3] = px[i + 3];
+            }
+            ok = std::fwrite(bgra.data(), 1, img_bytes, f) == img_bytes;
+        }
+    }
+    std::fclose(f);
+    return ok;
+}
