+uint32_t RefreshRate() {
+    static const uint32_t sim_hz = [] {
+        const auto& args = ProcessArgs();
+        for (size_t i = 1; i < args.size(); ++i) {
+            if (args[i] == "--simulate-refresh-hz" && i + 1 < args.size()) {
+                int v = std::atoi(args[i + 1].c_str());
+                if (v > 0) return uint32_t(v);
+            } else if (args[i].rfind("--simulate-refresh-hz=", 0) == 0) {
+                int v = std::atoi(args[i].c_str() + 22);
+                if (v > 0) return uint32_t(v);
+            }
+        }
+        return 0u;
+    }();
+    if (sim_hz) return sim_hz;
+    static std::atomic<uint32_t> rate{0};
+    static std::atomic<uint64_t> next_ms{0};
+    uint64_t now_ms = uint64_t(
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+    if (g_refresh_dirty.exchange(false, std::memory_order_acq_rel) || now_ms >= next_ms.load(std::memory_order_relaxed)) {
+        next_ms.store(now_ms + 1000, std::memory_order_relaxed);
+        uint32_t r = 60;
+        if (SDL_WasInit(SDL_INIT_VIDEO)) {
+            SDL_DisplayID did = 0;
+            if (g_window && (SDL_GetWindowFlags(g_window) & SDL_WINDOW_HIDDEN) == 0) {
+                did = SDL_GetDisplayForWindow(g_window);
+            }
+            if (!did) did = ResolveTargetDisplay();
+            if (did) {
+                const SDL_DisplayMode* dm = SDL_GetCurrentDisplayMode(did);
+                if (!dm || dm->refresh_rate <= 1.0f) dm = SDL_GetDesktopDisplayMode(did);
+                if (dm && dm->refresh_rate > 1.0f) {
+                    r = uint32_t(std::lround(dm->refresh_rate));
+                }
+            }
+        }
+        rate.store(r, std::memory_order_relaxed);
+    }
+    return rate.load(std::memory_order_relaxed);
+}
