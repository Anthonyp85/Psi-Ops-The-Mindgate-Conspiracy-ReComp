+int main(int /*argc*/, char** /*argv*/) {
+    app::g_main_tid = pthread_self();
+    app::g_main_tid_valid.store(true, std::memory_order_release);
+    app::InstallCrashHandlers();
+
+    const auto& args = app::ProcessArgs();
+    bool relaunched = app::HasCliFlag(args, "--relaunched");
+    std::string log = app::kGame.log;
+    if (app::Instance() > 1) log += "-" + std::to_string(app::Instance());
+    logx::Init((app::ExeDir() / "logs").string(), log, relaunched);
+
+    app::Load();
+    if (int cli_rc = 0; app::HandleEarlyUtilityCli(cli_rc)) return cli_rc;
+
+    SDL_SetHint(SDL_HINT_MOUSE_RELATIVE_SYSTEM_SCALE, "0");
+    SDL_SetHint(SDL_HINT_VIDEO_MINIMIZE_ON_FOCUS_LOSS, "0");
+    if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD | SDL_INIT_AUDIO)) {
+        // Headless CI or environments without audio daemon: fall back to video + gamepad
+        LOGW("SDL_Init(VIDEO|GAMEPAD|AUDIO) failed (%s); retrying without AUDIO", SDL_GetError());
+        if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+            LOGE("SDL_Init(VIDEO|GAMEPAD) failed: %s", SDL_GetError());
+            logx::Flush();
+            return 1;
+        }
+    }
+
+    perf::Init();
+    if (app::kGame.init) app::kGame.init();
+    if (relaunched && !logx::kVerbose) LOGR("Relaunched: %s", IMAGE_XBE);
+    else app::LogSystem();
+
+    if (app::kGame.launcher && !app::ShouldBypassLauncher()) {
+        if (!app::kGame.launcher(nullptr)) {
+            input::Shutdown();
+            perf::Shutdown();
+            logx::Flush();
+            SDL_Quit();
+            return 0;
+        }
+        // Drain any quit/window events left by tearing down the SDL_Renderer launcher window.
+        SDL_PumpEvents();
+        SDL_FlushEvent(SDL_EVENT_QUIT);
+        SDL_FlushEvents(SDL_EVENT_WINDOW_FIRST, SDL_EVENT_WINDOW_LAST);
+    }
+
+    app::GameFiles game;
+    if (!app::FindGame(game)) {
+        perf::Shutdown();
+        logx::Flush();
+        SDL_Quit();
+        return 1;
+    }
+    if (!app::PrepareGameCode(game)) {
+        perf::Shutdown();
+        logx::Flush();
+        SDL_Quit();
+        return 1;
+    }
+
+    // Drain any stray quit/window events emitted by pre-game windows (launcher or code builder)
+    // before creating the Vulkan game window.
+    SDL_PumpEvents();
+    SDL_FlushEvent(SDL_EVENT_QUIT);
+    SDL_FlushEvents(SDL_EVENT_WINDOW_FIRST, SDL_EVENT_WINDOW_LAST);
+
+    bool splash = app::OpenSplash(), handover = app::StartHandover();
+
+    std::string title = app::WideToUtf8(app::kGame.title);
+    if (app::Instance()) title += " [" + std::to_string(app::Instance()) + "]";
+    int init_w = 1280, init_h = 720;
+    {
+        const app::Settings& s = app::Get();
+        SDL_DisplayID did = app::ResolveTargetDisplay();
+        SDL_Rect bounds{0, 0, 1280, 720};
+        if (did) SDL_GetDisplayBounds(did, &bounds);
+        app::Mode out = app::Output();
+        if (s.display_mode == app::DisplayMode::Windowed) {
+            SDL_Rect usable = bounds;
+            if (did) SDL_GetDisplayUsableBounds(did, &usable);
+            init_w = std::min(int(out.width ? out.width : 1280), std::max(320, usable.w));
+            init_h = std::min(int(out.height ? out.height : 720), std::max(240, usable.h));
+        } else {
+            init_w = std::max(320, bounds.w);
+            init_h = std::max(240, bounds.h);
+            if (s.display_mode == app::DisplayMode::Fullscreen && s.width && s.height) {
+                const SDL_DisplayMode* desk = did ? SDL_GetDesktopDisplayMode(did) : nullptr;
+                if (!desk || int(s.width) != desk->w || int(s.height) != desk->h) {
+                    SDL_DisplayMode dm{};
+                    if (did && SDL_GetClosestFullscreenDisplayMode(did, int(s.width), int(s.height), 0.0f, true, &dm)) {
+                        init_w = std::max(320, dm.w);
+                        init_h = std::max(240, dm.h);
+                    }
+                }
+            }
+        }
+    }
+    SDL_WindowFlags wflags =
+        SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_HIDDEN;
+    if (app::Get().display_mode != app::DisplayMode::Windowed) wflags |= SDL_WINDOW_BORDERLESS;
+    app::g_window = SDL_CreateWindow(title.c_str(), init_w, init_h, wflags);
+    if (!app::g_window) {
+        LOGE("SDL_CreateWindow(VULKAN) failed: %s", SDL_GetError());
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, app::WideToUtf8(app::kGame.short_title).c_str(),
+                                 "Failed to create Vulkan game window. Verify Vulkan 1.2 drivers are installed.",
+                                 nullptr);
+        perf::Shutdown();
+        logx::Flush();
+        SDL_Quit();
+        return 1;
+    }
+    app::TrySetWindowIcon(app::g_window);
+
+    if (handover) {
+        app::ApplyNow();
+    } else if (!splash) {
+        app::ApplyNow();
+        SDL_ShowWindow(app::g_window);
+        SDL_RaiseWindow(app::g_window);
+    }
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad |
+                      ImGuiConfigFlags_NoMouseCursorChange | ImGuiConfigFlags_NoMouse;
+    io.MouseDrawCursor = false;
+    ImGui_ImplSDL3_InitForVulkan(app::g_window);
+    // Keep gamepad polling strictly in core/input.cpp + FeedPadToImGui to prevent duplicate SDL_Gamepad opens.
+    ImGui_ImplSDL3_SetGamepadMode(ImGui_ImplSDL3_GamepadMode_Manual, nullptr, 0);
+
+    input::Init();
+    if (app::kGame.window) app::kGame.window(app::g_window);
+
+    std::string hdd = app::Instance() > 1 ? "hdd" + std::to_string(app::Instance()) : "hdd";
+    app::g_running.store(true, std::memory_order_release);
+    if (!kernel::Boot(std::move(game.xbe), IMAGE_XBE, game.dir.string(), (app::ExeDir() / hdd).string())) {
+        app::g_running.store(false, std::memory_order_release);
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, app::WideToUtf8(app::kGame.short_title).c_str(),
+                                 "The game failed to start, see the log in the logs folder.", app::g_window);
+        SDL_DestroyWindow(app::g_window);
+        app::g_window = nullptr;
+        perf::Shutdown();
+        logx::Flush();
+        SDL_Quit();
+        return 1;
+    }
+
+    SDL_Event ev{};
+    bool quit = false;
+    while (!quit && SDL_WaitEvent(&ev)) {
+        do {
+            if (ev.type == SDL_EVENT_USER) {
+                if (ev.user.code == app::kEvApplyDisplay) {
+                    app::ApplyNow();
+                    continue;
+                }
+                if (ev.user.code == app::kEvOpenWindow) {
+                    app::DoOpenGameWindow(ev.user.data1 != nullptr);
+                    if (app::kGame.window && app::g_window) app::kGame.window(app::g_window);
+                    {
+                        std::lock_guard<std::mutex> lock(app::g_open_lock);
+                        app::g_open_done = true;
+                    }
+                    app::g_open_cv.notify_all();
+                    continue;
+                }
+                if (ev.user.code == app::kEvSyncCursor) {
+                    intptr_t res = 0;
+                    if (app::kGame.message) {
+                        app::kGame.message(app::g_window, ev.type, static_cast<uintptr_t>(ev.user.code),
+                                           reinterpret_cast<intptr_t>(&ev), &res);
+                    }
+                    continue;
+                }
+            }
+
+            const SDL_WindowID game_win_id = app::g_window ? SDL_GetWindowID(app::g_window) : 0;
+            bool is_close = (ev.type == SDL_EVENT_QUIT) ||
+                            (ev.type == SDL_EVENT_WINDOW_CLOSE_REQUESTED && game_win_id != 0 &&
+                             ev.window.windowID == game_win_id);
+
+            uintptr_t wp = (ev.type == SDL_EVENT_USER) ? static_cast<uintptr_t>(ev.user.code) : 0;
+            intptr_t result = 0;
+            bool handled = app::kGame.message &&
+                           app::kGame.message(app::g_window, ev.type, wp, reinterpret_cast<intptr_t>(&ev), &result);
+
+            if (is_close) {
+                quit = true;
+                break;
+            }
+
+            // Feed ImGui on the main thread under UiLock(), strictly gating mouse events while the
+            // F1 overlay is closed (ImGuiConfigFlags_NoMouse / NoMouseCursorChange) or relative mode is active.
+            if (!handled) {
+                const bool is_window_ev = (ev.type >= SDL_EVENT_WINDOW_FIRST && ev.type <= SDL_EVENT_WINDOW_LAST);
+                const bool is_mouse_ev = (ev.type == SDL_EVENT_MOUSE_MOTION || ev.type == SDL_EVENT_MOUSE_BUTTON_DOWN ||
+                                          ev.type == SDL_EVENT_MOUSE_BUTTON_UP || ev.type == SDL_EVENT_MOUSE_WHEEL);
+                const bool rel_mouse = app::g_window && SDL_GetWindowRelativeMouseMode(app::g_window);
+                if (!rel_mouse || is_window_ev) {
+                    std::lock_guard<std::recursive_mutex> lock(app::UiLock());
+                    if (ImGui::GetCurrentContext()) {
+                        const ImGuiConfigFlags flags = ImGui::GetIO().ConfigFlags;
+                        const bool overlay_mouse_enabled =
+                            (flags & (ImGuiConfigFlags_NoMouse | ImGuiConfigFlags_NoMouseCursorChange)) == 0;
+                        if (!is_mouse_ev || overlay_mouse_enabled) {
+                            SDL_Event scaled_ev = ev;
+                            if (app::g_window && (scaled_ev.type == SDL_EVENT_MOUSE_MOTION ||
+                                                  scaled_ev.type == SDL_EVENT_MOUSE_BUTTON_DOWN ||
+                                                  scaled_ev.type == SDL_EVENT_MOUSE_BUTTON_UP)) {
+                                int lw = 0, lh = 0, pw = 0, ph = 0;
+                                SDL_GetWindowSize(app::g_window, &lw, &lh);
+                                SDL_GetWindowSizeInPixels(app::g_window, &pw, &ph);
+                                if (lw > 0 && lh > 0 && pw > 0 && ph > 0 && (lw != pw || lh != ph)) {
+                                    float sx = float(pw) / float(lw);
+                                    float sy = float(ph) / float(lh);
+                                    if (scaled_ev.type == SDL_EVENT_MOUSE_MOTION) {
+                                        scaled_ev.motion.x *= sx;
+                                        scaled_ev.motion.y *= sy;
+                                    } else {
+                                        scaled_ev.button.x *= sx;
+                                        scaled_ev.button.y *= sy;
+                                    }
+                                }
+                            }
+                            ImGui_ImplSDL3_ProcessEvent(&scaled_ev);
+                        }
+                    }
+                }
+            }
+            if (handled) continue;
+
+            switch (ev.type) {
+                case SDL_EVENT_KEY_DOWN:
+                    if (ev.key.key == SDLK_F3 && !ev.key.repeat) app::DumpThreads();
+                    break;
+                case SDL_EVENT_WINDOW_FOCUS_LOST:
+                    audio::SetFocusMuted(app::Get().mute_unfocused);
+                    break;
+                case SDL_EVENT_WINDOW_FOCUS_GAINED:
+                    audio::SetFocusMuted(false);
+                    break;
+                case SDL_EVENT_WINDOW_DISPLAY_CHANGED:
+                case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+                case SDL_EVENT_WINDOW_RESIZED:
+                case SDL_EVENT_WINDOW_MOVED:
+                    app::InvalidateRefreshCache();
+                    break;
+                default:
+                    break;
+            }
+        } while (!quit && SDL_PollEvent(&ev));
+    }
+
+    app::g_running.store(false, std::memory_order_release);
+    input::Shutdown();
+    d3d::FlushCaches();
+    perf::Shutdown();
+    logx::Flush();
+    if (app::g_window) {
+        SDL_SetWindowRelativeMouseMode(app::g_window, false);
+        SDL_SetWindowMouseGrab(app::g_window, false);
+        SDL_SetWindowMouseRect(app::g_window, nullptr);
+        SDL_ShowCursor();
+        SDL_DestroyWindow(app::g_window);
+        app::g_window = nullptr;
+    }
+    kernel::Shutdown(0);
+}
