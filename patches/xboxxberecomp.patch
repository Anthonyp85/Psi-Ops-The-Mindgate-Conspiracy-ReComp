+            // Perform OS I/O outside stripe mutexes; coalesce contiguous 128 KiB read-ahead on multi-block or
+            // sequential misses to cut OS read syscalls in half during .XBox/.msx/.SFD streaming.
+            const uint64_t block_off = block_idx << kCacheBlockShift;
+            const bool seq_prefetch = (last_miss_block != ~uint64_t(0) && block_idx == last_miss_block + 1u);
+            const bool want_two = (seq_prefetch || rem > chunk) && (size_ > block_off + kCacheBlockSize);
+            const uint32_t to_read =
+                want_two
+                    ? uint32_t(std::min<uint64_t>(uint64_t(kCacheBlockSize) * 2u, size_ - block_off))
+                    : ((size_ > block_off) ? uint32_t(std::min<uint64_t>(kCacheBlockSize, size_ - block_off))
+                                           : kCacheBlockSize);
+            auto os_t0 = perf::Enabled() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+            const uint32_t got_raw = ReadRawAt(block_off, scratch.data(), to_read);
+            const uint32_t got_block = std::min<uint32_t>(got_raw, kCacheBlockSize);
+            if (perf::Enabled()) {
+                double os_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - os_t0).count();
+                perf::RecordDiscCacheMiss(got_block);
+                perf::RecordDiscOsRead(got_raw, os_ms);
+            }
+            if (got_block == 0) break;
+
+            insert_block(block_idx, scratch.data(), got_block);
+            if (got_raw > kCacheBlockSize) {
+                insert_block(block_idx + 1u, scratch.data() + kCacheBlockSize, got_raw - kCacheBlockSize);
+                last_miss_block = block_idx + 1u;
+            } else {
+                last_miss_block = block_idx;
+            }
+
+            if (off_in_block < got_block) {
+                avail = std::min<uint32_t>(chunk, got_block - off_in_block);
+                std::memcpy(dst + total_got, scratch.data() + off_in_block, avail);
+            }
+            total_got += avail;
+            if (avail < chunk) break;
+            cur_at += avail;
+            rem -= avail;
+        }
+    }
+
+    if (perf::Enabled()) {
+        double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        perf::RecordDiscRead(total_got, ms);
+    }
+    return total_got;
 }
 
