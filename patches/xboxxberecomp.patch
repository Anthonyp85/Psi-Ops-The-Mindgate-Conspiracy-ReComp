+    add_util_shader(kBlitHlsl, "psmain", "ps_5_0");
+    add_util_shader(kClearHlsl, "vs", "vs_5_0");
+    add_util_shader(kClearHlsl, "psmain", "ps_5_0");
+    add_util_shader(kDepthHlsl, "vs", "vs_5_0");
+    add_util_shader(kDepthHlsl, "psmain", "ps_5_0");
+    add_util_shader(PointHlsl(), "main", "gs_5_0");
+    add_util_shader(SpriteHlsl(), "main", "gs_5_0");
+
