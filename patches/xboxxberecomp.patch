+void D3D12Backend::PrewarmCachedPsos() {
+    if (!cache_enabled_ || cache_dir_.empty()) return;
+    std::filesystem::path meta_path = PsoMetaPath();
+    std::error_code ec;
+    auto fsize = std::filesystem::file_size(meta_path, ec);
+    if (ec || fsize < sizeof(PsoMetaHeader)) return;
+    FILE* f = _wfopen(meta_path.c_str(), L"rb");
+    if (!f) return;
+    PsoMetaHeader hdr{};
+    bool ok = std::fread(&hdr, sizeof(hdr), 1, f) == 1 && hdr.magic == kPsoMetaMagic && hdr.version == kPsoMetaVersion &&
+              hdr.sizeof_pso_key == sizeof(PsoKey) && hdr.vendor_id == adapter_desc_.VendorId &&
+              hdr.device_id == adapter_desc_.DeviceId && hdr.subsys_id == adapter_desc_.SubSysId &&
+              hdr.revision == adapter_desc_.Revision && hdr.src_count <= 65536u && hdr.pso_count <= 65536u;
+    uint64_t expect = uint64_t(sizeof(PsoMetaHeader)) + uint64_t(hdr.src_count) * sizeof(SrcMetaEntry) +
+                      uint64_t(hdr.pso_count) * sizeof(PsoKey);
+    if (!ok || expect != fsize) {
+        std::fclose(f);
+        return;
+    }
+    std::vector<SrcMetaEntry> src_loaded(hdr.src_count);
+    std::vector<PsoKey> pso_loaded(hdr.pso_count);
+    if (hdr.src_count && std::fread(src_loaded.data(), sizeof(SrcMetaEntry), hdr.src_count, f) != hdr.src_count) ok = false;
+    if (ok && hdr.pso_count && std::fread(pso_loaded.data(), sizeof(PsoKey), hdr.pso_count, f) != hdr.pso_count) ok = false;
+    std::fclose(f);
+    if (!ok) return;
+
+    auto t0 = PerfClock::now();
+    size_t restored_src = 0;
+    for (const auto& e : src_loaded) {
+        auto bit = blobs_.find(e.blob_hash);
+        if (bit != blobs_.end() && bit->second) {
+            shader_src_[e.src_key] = e.blob_hash;
+            if (known_src_keys_.insert(e.src_key).second) src_meta_entries_.push_back(e);
+            restored_src++;
+        }
+    }
+
+    // Single-threaded prep: pre-compile point/sprite GS if needed before spawning workers
+    bool need_point_gs = false, need_sprite_gs = false;
+    for (const auto& k : pso_loaded) {
+        if (k.topo == uint32_t(Topology::Points)) {
+            if (k.sprite) need_sprite_gs = true;
+            else need_point_gs = true;
+        }
+    }
+    ID3DBlob* point_gs = nullptr;
+    ID3DBlob* sprite_gs = nullptr;
+    if (need_point_gs) {
+        uint64_t gh = 0;
+        point_gs = Compile(PointHlsl(), "main", "gs_5_0", gh);
+    }
+    if (need_sprite_gs) {
+        uint64_t gh = 0;
+        sprite_gs = Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+    }
+
+    struct PrepItem {
+        uint64_t hash = 0;
+        PsoKey k{};
+        ID3DBlob* vs = nullptr;
+        ID3DBlob* ps = nullptr;
+        ID3DBlob* gs = nullptr;
+    };
+    std::vector<PrepItem> items;
+    items.reserve(pso_loaded.size());
+    std::unordered_set<uint64_t> seen_hashes;
+    for (const auto& k : pso_loaded) {
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h) || !seen_hashes.insert(h).second) continue;
+        auto vit = blobs_.find(k.vs);
+        auto pit = blobs_.find(k.ps);
+        if (vit == blobs_.end() || !vit->second || pit == blobs_.end() || !pit->second) continue;
+        ID3DBlob* gs = nullptr;
+        if (k.topo == uint32_t(Topology::Points)) {
+            gs = k.sprite ? sprite_gs : point_gs;
+            if (!gs) continue;
+        }
+        items.push_back(PrepItem{h, k, vit->second.Get(), pit->second.Get(), gs});
+    }
+    if (items.empty()) {
+        LOGR("d3d12: metadata restored (%zu src mappings, 0 PSOs to prewarm)", restored_src);
+        return;
+    }
+
+    struct PrepOut {
+        ComPtr<ID3D12PipelineState> pso;
+        bool lib_hit = false;
+        bool lib_miss = false;
+    };
+    std::vector<PrepOut> results(items.size());
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({4u, max_jobs, uint32_t(items.size())});
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= items.size()) break;
+            const PrepItem& it = items[idx];
+            D3D12_INPUT_ELEMENT_DESC el[16];
+            uint32_t n = FillInputLayout(it.k, el);
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC d{};
+            d.InputLayout = {el, n};
+            FillPipelineDesc(it.k, it.vs, it.ps, d);
+            if (it.gs) {
+                d.GS = {it.gs->GetBufferPointer(), it.gs->GetBufferSize()};
+                d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+                d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+                d.RasterizerState.FrontCounterClockwise = FALSE;
+            }
+            wchar_t wname[32];
+            std::swprintf(wname, 32, L"draw_%016llX", (unsigned long long)it.hash);
+            ComPtr<ID3D12PipelineState> pso;
+            if (pso_lib_ && SUCCEEDED(pso_lib_->LoadGraphicsPipeline(wname, &d, IID_PPV_ARGS(&pso))) && pso) {
+                results[idx].pso = std::move(pso);
+                results[idx].lib_hit = true;
+            } else if (SUCCEEDED(dev_->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pso))) && pso) {
+                results[idx].pso = std::move(pso);
+                results[idx].lib_miss = true;
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t hits = 0, misses = 0;
+    for (size_t i = 0; i < items.size(); ++i) {
+        if (!results[i].pso) continue;
+        const PrepItem& it = items[i];
+        psos_[it.hash] = results[i].pso;
+        if (known_pso_keys_.insert(it.hash).second) pso_meta_entries_.push_back(it.k);
+        if (results[i].lib_hit) {
+            hits++;
+            if (perf::Enabled()) perf::RecordPsoCacheHit();
+        } else if (results[i].lib_miss) {
+            misses++;
+            if (pso_lib_) {
+                wchar_t wname[32];
+                std::swprintf(wname, 32, L"draw_%016llX", (unsigned long long)it.hash);
+                if (SUCCEEDED(pso_lib_->StorePipeline(wname, results[i].pso.Get()))) {
+                    pso_dirty_ = true;
+                    cache_dirty_frame_ = presents_;
+                }
+            }
+        }
+    }
+    double prewarm_ms = PerfMs(t0);
+    perf::RecordBootPrewarm(prewarm_ms, uint32_t(hits + misses));
+    LOGR("d3d12: startup prewarm done in %.1f ms (src=%zu, psos=%zu/%zu, hits=%zu, misses=%zu, threads=%u)",
+         prewarm_ms, restored_src, hits + misses, items.size(), hits, misses, n_threads);
+}
