+void D3D12Backend::RenderPrecompileProgressFrame(const char* stage, uint32_t done, uint32_t total, uint32_t sh_done,
+                                                 uint32_t sh_total, uint32_t pso_done, uint32_t pso_total) {
+    if (!swap_ || !cl_) return;
+    uint32_t bi = swap_->GetCurrentBackBufferIndex();
+    if (!bb_[bi]) return;
+
+    D3D12_RESOURCE_STATES bs = D3D12_RESOURCE_STATE_PRESENT;
+    Transition(bb_[bi].Get(), bs, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    D3D12_CPU_DESCRIPTOR_HANDLE rh = Cpu(rtv_heap_.Get(), kRtvCount + bi, rtv_inc_);
+    const float bg[4] = {0.045f, 0.062f, 0.090f, 1.0f};
+    cl_->ClearRenderTargetView(rh, bg, 0, nullptr);
+    cl_->OMSetRenderTargets(1, &rh, FALSE, nullptr);
+    bound_rt_ = bound_ds_ = nullptr;
+
+    {
+        std::lock_guard<std::recursive_mutex> lock(app::UiLock());
+        ImGui_ImplDX12_NewFrame();
+        ImGui_ImplWin32_NewFrame();
+        ImGui::NewFrame();
+        DrawPrecompileProgressUi(stage, done, total, sh_done, sh_total, pso_done, pso_total);
+        ImGui::Render();
+        ID3D12DescriptorHeap* uh[] = {ui_heap_.Get()};
+        cl_->SetDescriptorHeaps(1, uh);
+        ImGui_ImplDX12_RenderDrawData(ImGui::GetDrawData(), cl_.Get());
+    }
+
+    Transition(bb_[bi].Get(), bs, D3D12_RESOURCE_STATE_PRESENT);
+    Submit(false);
+    swap_->Present(0, 0);
+    WaitFence(fence_value_);
+    Frame& f = CurrentFrame();
+    f.alloc->Reset();
+    f.garbage.clear();
