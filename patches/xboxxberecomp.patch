+                if (std::getline(f, line) && SiblingListContainsZero(line)) item.shares_cpu0 = true;
+            }
+            std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpufreq/cpuinfo_max_freq", c);
+            if (std::ifstream f(path); f) {
