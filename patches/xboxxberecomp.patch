+// SPDX-License-Identifier: GPL-2.0-or-later
+// Ahead-of-Time (AOT) NV2A Vertex/Pixel Shader & Pipeline Pre-Compiler
+// shared across Win64 D3D12 and Native Linux Vulkan 1.2 backends.
+//
+// Copyright hygiene: ZERO copyrighted game shader microcode or asset bytes are
+// embedded here. At cold boot this module scans the user's mounted read-only
+// XISO disc image (or extracted game data folder) for ESPx v6 'shrx' shader
+// entries (.vsh NV2A vertex microcode + 240-byte .psh D3DPIXELSHADERDEF blobs),
+// translates every discovered shader through gpu::VertexProgramHlsl /
+// gpu::PixelHlsl, and pairs them with copyright-clean numeric D3D8/NV2A
+// render-state pipeline key seeds.
+
+#include "gpu/shader_precompile.h"
+
+#include <algorithm>
