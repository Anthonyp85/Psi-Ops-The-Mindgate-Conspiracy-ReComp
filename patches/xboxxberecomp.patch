+        __m128i v = _mm_loadu_si128(reinterpret_cast<const __m128i*>(src_row + x * 2));
+        __m128i y16 = yuy2 ? _mm_and_si128(v, kMaskLo16) : _mm_srli_epi16(v, 8);
+        __m128i uv16 = yuy2 ? _mm_srli_epi16(v, 8) : _mm_and_si128(v, kMaskLo16);
+        __m128i u32 = _mm_and_si128(uv16, kMaskLo32);
+        __m128i v32 = _mm_srli_epi32(uv16, 16);
+        __m128i u16 = _mm_or_si128(u32, _mm_slli_epi32(u32, 16));
+        __m128i v16 = _mm_or_si128(v32, _mm_slli_epi32(v32, 16));
+
+        __m128i c6 = _mm_slli_epi16(_mm_sub_epi16(y16, k16), 6);
+        __m128i d6 = _mm_slli_epi16(_mm_sub_epi16(u16, k128), 6);
+        __m128i e6 = _mm_slli_epi16(_mm_sub_epi16(v16, k128), 6);
+
+        __m128i yq3 = _mm_add_epi16(_mm_mulhi_epi16(c6, kCY), kRound);
+        __m128i r16 = _mm_srai_epi16(_mm_add_epi16(yq3, _mm_mulhi_epi16(e6, kRV)), 3);
+        __m128i g16 = _mm_srai_epi16(_mm_add_epi16(_mm_add_epi16(yq3, _mm_mulhi_epi16(d6, kGU)),
