+uint64_t Clock100ns(clockid_t clk) {
+    timespec ts{};
+    if (clock_gettime(clk, &ts) != 0) return 0;
+    return uint64_t(ts.tv_sec) * 10000000ull + uint64_t(ts.tv_nsec) / 100ull;
+}
