+    const uint32_t n_threads = std::min<uint32_t>(16u, hw_threads);
+    const uint32_t sh_total = uint32_t(missing_idx.size());
+    const uint32_t est_pso_total = uint32_t(plan.psos.size()) + 5u;
+    const uint32_t grand_total = sh_total + est_pso_total;
