+bool VulkanBackend::CreateFrames() {
+    VkSemaphoreTypeCreateInfo tci{VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO};
+    tci.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+    tci.initialValue = 0;
+    VkSemaphoreCreateInfo sci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, &tci};
+    if (vk_.create_sem(dev_, &sci, nullptr, &timeline_sem_) != VK_SUCCESS) return false;
+
+    for (int i = 0; i < kFrames; ++i) {
+        VkSemaphoreCreateInfo bsi{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        if (vk_.create_sem(dev_, &bsi, nullptr, &img_avail_sems_[i]) != VK_SUCCESS) return false;
+    }
+
+    static constexpr uint64_t kSizes[] = {64ull << 20, 32ull << 20, 16ull << 20, 8ull << 20};
+    VkBufferUsageFlags up_usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                                  VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    VkMemoryPropertyFlags up_props = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+
+    bool allocated = false;
+    for (uint64_t try_sz : kSizes) {
+        if (try_sz > upload_size_) continue;
+        bool ok = true;
+        for (auto& f : frames_) {
+            if (f.upload_buf != VK_NULL_HANDLE) { vk_.destroy_buf(dev_, f.upload_buf, nullptr); f.upload_buf = VK_NULL_HANDLE; }
+            if (f.upload_mem != VK_NULL_HANDLE) { vk_.free_mem(dev_, f.upload_mem, nullptr); f.upload_mem = VK_NULL_HANDLE; }
+            f.map = nullptr;
+            if (!CreateBuffer(try_sz, up_usage, up_props, f.upload_buf, f.upload_mem, &f.map)) {
+                ok = false;
+                break;
+            }
+        }
+        if (ok) {
+            upload_size_ = try_sz;
+            upload_reserve_ = std::max<uint64_t>(1ull << 20, try_sz / 8);
+            caps_.upload_ring_bytes = upload_size_;
+            {
+                std::lock_guard<std::mutex> lock(g_caps_lock);
+                g_gpu_caps.upload_ring_bytes = upload_size_;
+            }
+            allocated = true;
+            break;
+        }
+    }
+    if (!allocated) return false;
+
+    VkDescriptorPoolSize psizes[3] = {
+        {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, kDescSetsPerFrame * 2},
+        {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, kDescSetsPerFrame * 4},
+        {VK_DESCRIPTOR_TYPE_SAMPLER, kDescSetsPerFrame * 4},
+    };
+    for (auto& f : frames_) {
+        VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        cpci.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+        cpci.queueFamilyIndex = queue_family_;
+        if (vk_.create_cmd_pool(dev_, &cpci, nullptr, &f.cmd_pool) != VK_SUCCESS) return false;
+        VkCommandBufferAllocateInfo cbai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cbai.commandPool = f.cmd_pool;
+        cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cbai.commandBufferCount = 1;
+        if (vk_.alloc_cmd_bufs(dev_, &cbai, &f.cmd) != VK_SUCCESS) return false;
+
+        VkDescriptorPoolCreateInfo dpci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        dpci.maxSets = kDescSetsPerFrame;
+        dpci.poolSizeCount = 3;
+        dpci.pPoolSizes = psizes;
+        if (vk_.create_desc_pool(dev_, &dpci, nullptr, &f.desc_pool) != VK_SUCCESS) return false;
+    }
+    cmd_ = frames_[0].cmd;
+    return true;
+}
+
+bool VulkanBackend::CreateDummyTextures() {
+    auto make = [&](DummyTex& d, VkImageType type, VkImageViewType vtype, VkFormat fmt, uint32_t layers,
+                    VkImageCreateFlags flags, VkImageAspectFlags aspect, VkImageUsageFlags usage) -> bool {
+        if (!CreateImage(1, 1, 1, layers, 1, fmt, type, flags, usage, d.img, d.mem)) return false;
+        d.view = CreateImageView(d.img, vtype, fmt, aspect, 1, layers);
+        return d.view != VK_NULL_HANDLE;
+    };
+    return make(dummy_2d_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, 1, 0,
+                VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_3d_, VK_IMAGE_TYPE_3D, VK_IMAGE_VIEW_TYPE_3D, VK_FORMAT_B8G8R8A8_UNORM, 1, 0,
+                VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_cube_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_CUBE, VK_FORMAT_B8G8R8A8_UNORM, 6,
+                VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT, VK_IMAGE_ASPECT_COLOR_BIT,
+                VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_depth_2d_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, depth_fmt_, 1, 0, VK_IMAGE_ASPECT_DEPTH_BIT,
+                VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
+}
+
+bool VulkanBackend::CreateGammaLut() {
+    if (!CreateImage(256, 1, 1, 1, 1, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_TYPE_2D, 0,
+                     VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, lut_img_, lut_mem_)) {
+        return false;
+    }
+    lut_view_ = CreateImageView(lut_img_, VK_IMAGE_VIEW_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_ASPECT_COLOR_BIT);
+    lut_layout_ = VK_IMAGE_LAYOUT_UNDEFINED;
+    return lut_view_ != VK_NULL_HANDLE;
+}
+
+bool VulkanBackend::CreateQueries() {
+    VkQueryPoolCreateInfo oci{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    oci.queryType = VK_QUERY_TYPE_OCCLUSION;
+    oci.queryCount = kQueries;
+    if (vk_.create_query_pool(dev_, &oci, nullptr, &occ_pool_) == VK_SUCCESS) {
+        uint8_t* mapped = nullptr;
+        if (CreateBuffer(uint64_t(kQueries) * sizeof(uint64_t), VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                             VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                         occ_rb_, occ_rb_mem_, &mapped, &occ_coherent_)) {
+            occ_counts_ = reinterpret_cast<const uint64_t*>(mapped);
+        }
+    }
+    if (phys_props_.limits.timestampComputeAndGraphics && phys_props_.limits.timestampPeriod > 0.0f) {
+        VkQueryPoolCreateInfo tci{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+        tci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        tci.queryCount = uint32_t(kFrames * 2);
+        vk_.create_query_pool(dev_, &tci, nullptr, &ts_pool_);
+    }
+    return true;
+}
