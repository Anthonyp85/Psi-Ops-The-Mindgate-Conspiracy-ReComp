+    }
+    textures_.clear();
+    pack_textures_.clear();
+    upload_tex_.Reset();
+    rb_buf_.Reset();
+    sync_down_.Reset();
+    for (auto& f : frames_) {
+        f.garbage.clear();
+        f.slab_garbage.clear();
+    }
+    tex_slabs_.clear();
+    if (event_) {
+        CloseHandle(event_);
+        event_ = nullptr;
+    }
+}
