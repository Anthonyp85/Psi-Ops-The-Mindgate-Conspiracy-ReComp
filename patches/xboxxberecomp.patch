+std::string WideToUtf8(const std::wstring& w) {
+    if (w.empty()) return {};
+    int n = WideCharToMultiByte(CP_UTF8, 0, w.data(), int(w.size()), nullptr, 0, nullptr, nullptr);
+    if (n <= 0) return {};
+    std::string out(size_t(n), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, w.data(), int(w.size()), out.data(), n, nullptr, nullptr);
+    return out;
+}
+
+std::wstring StripQuotes(std::wstring s) {
+    while (!s.empty() && std::iswspace(s.front())) s.erase(s.begin());
+    while (!s.empty() && std::iswspace(s.back())) s.pop_back();
+    if (s.size() >= 2 && s.front() == L'"' && s.back() == L'"') s = s.substr(1, s.size() - 2);
+    return s;
+}
+
+std::string ParsePerfPath() {
+    std::string out;
+    if (const wchar_t* env = _wgetenv(L"XBE_PERF_LOG"); env && *env) {
+        out = WideToUtf8(StripQuotes(env));
+    }
+    const wchar_t* cmd = GetCommandLineW();
+    if (!cmd) return out;
+    std::vector<std::wstring> args;
+    const wchar_t* p = cmd;
+    while (*p) {
+        while (*p && std::iswspace(*p)) ++p;
+        if (!*p) break;
+        std::wstring a;
+        bool q = false;
+        while (*p && (q || !std::iswspace(*p))) {
+            if (*p == L'"') q = !q;
+            else a.push_back(*p);
+            ++p;
+        }
+        args.push_back(std::move(a));
+    }
+    for (size_t i = 1; i < args.size(); ++i) {
+        if (args[i] == L"--perf-log" && i + 1 < args.size()) {
+            out = WideToUtf8(StripQuotes(args[++i]));
+        } else if (args[i].rfind(L"--perf-log=", 0) == 0) {
+            out = WideToUtf8(StripQuotes(args[i].substr(11)));
+        }
+    }
+    return out;
+}
