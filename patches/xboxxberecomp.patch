+// --- Persistent Disk Caches (cache/vk_shaders.bin & cache/vk_psos_<VID>_<DID>.bin) ---
+
+std::filesystem::path VulkanBackend::PsoCachePath() const {
+    char name[64];
+    std::snprintf(name, sizeof(name), "vk_psos_%04X_%04X.bin", phys_props_.vendorID, phys_props_.deviceID);
+    return cache_dir_ / name;
+}
+
+std::filesystem::path VulkanBackend::PsoMetaPath() const {
+    char name[64];
+    std::snprintf(name, sizeof(name), "vk_pso_meta_%04X_%04X.bin", phys_props_.vendorID, phys_props_.deviceID);
+    return cache_dir_ / name;
+}
+
+void VulkanBackend::StartSaveThread() {
+    std::lock_guard<std::mutex> lock(save_mtx_);
+    if (save_thread_.joinable()) return;
+    save_stop_ = false;
+    save_thread_ = std::thread([this] { SaveWorkerLoop(); });
+}
+
+void VulkanBackend::DrainSaveThread() {
+    std::unique_lock<std::mutex> lock(save_mtx_);
+    save_done_cv_.wait(lock, [this] { return !save_has_pending_ && !save_writing_; });
+}
+
+void VulkanBackend::StopSaveThread() {
+    {
+        std::lock_guard<std::mutex> lock(save_mtx_);
+        save_stop_ = true;
+    }
+    save_cv_.notify_all();
+    if (save_thread_.joinable()) save_thread_.join();
+}
+
+void VulkanBackend::SaveWorkerLoop() {
+    for (;;) {
+        CacheSaveJob job{};
+        {
+            std::unique_lock<std::mutex> lock(save_mtx_);
+            save_cv_.wait(lock, [this] { return save_has_pending_ || save_stop_; });
+            if (!save_has_pending_) {
+                if (save_stop_) break;
+                continue;
+            }
+            job = std::move(save_pending_);
+            save_pending_ = CacheSaveJob{};
+            save_has_pending_ = false;
+            save_writing_ = true;
+        }
+        std::error_code ec;
+        std::filesystem::create_directories(job.dir, ec);
+        if (job.write_shaders) WriteAtomicFilePosix(job.dir / "vk_shaders.bin", job.shaders_bytes);
+        if (job.write_pso) WriteAtomicFilePosix(job.pso_path, job.pso_bytes);
+        if (job.write_meta) WriteAtomicFilePosix(job.meta_path, job.meta_bytes);
+        if (job.write_shaders || job.write_pso || job.write_meta) {
+            perf::RecordCacheWrite(false);
+            uint64_t bytes = 0;
+            std::error_code sz_ec;
+            auto ssz = std::filesystem::file_size(job.dir / "vk_shaders.bin", sz_ec);
+            if (!sz_ec) bytes += ssz;
+            sz_ec.clear();
+            auto psz = std::filesystem::file_size(PsoCachePath(), sz_ec);
+            if (!sz_ec) bytes += psz;
+            sz_ec.clear();
+            auto msz = std::filesystem::file_size(PsoMetaPath(), sz_ec);
+            if (!sz_ec) bytes += msz;
+            sz_ec.clear();
+            auto asz = std::filesystem::file_size(AotStampPath("vk", phys_props_.vendorID, phys_props_.deviceID), sz_ec);
+            if (!sz_ec) bytes += asz;
+            g_cache_bytes_stat.store(bytes, std::memory_order_relaxed);
+        }
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_writing_ = false;
+        }
+        save_done_cv_.notify_all();
+    }
+}
+
+void VulkanBackend::PublishCacheStats() {
+    g_cache_enabled_stat.store(cache_enabled_, std::memory_order_relaxed);
+    g_cache_shaders_stat.store(uint32_t(shader_cache_entries_.size()), std::memory_order_relaxed);
+    g_cache_psos_stat.store(uint32_t(psos_.size() + blit_psos_.size()), std::memory_order_relaxed);
+    g_cache_aot_ready_stat.store(aot_ready_, std::memory_order_relaxed);
+    g_cache_aot_shaders_stat.store(uint32_t(aot_compiled_shaders_), std::memory_order_relaxed);
+    g_cache_aot_psos_stat.store(uint32_t(aot_built_psos_), std::memory_order_relaxed);
+    g_cache_aot_ms_stat.store(aot_ms_, std::memory_order_relaxed);
+    uint64_t bytes = 0;
+    if (cache_enabled_ && !cache_dir_.empty()) {
+        std::error_code ec;
+        auto ssz = std::filesystem::file_size(cache_dir_ / "vk_shaders.bin", ec);
+        if (!ec) bytes += ssz;
+        ec.clear();
+        auto psz = std::filesystem::file_size(PsoCachePath(), ec);
+        if (!ec) bytes += psz;
+        ec.clear();
+        auto msz = std::filesystem::file_size(PsoMetaPath(), ec);
+        if (!ec) bytes += msz;
+        ec.clear();
+        auto asz = std::filesystem::file_size(AotStampPath("vk", phys_props_.vendorID, phys_props_.deviceID), ec);
+        if (!ec) bytes += asz;
+    }
+    g_cache_bytes_stat.store(bytes, std::memory_order_relaxed);
+}
+
+void VulkanBackend::InitCaches() {
+    cache_enabled_ = !NoShaderCacheFlag();
+    perf::SetShaderCacheEnabled(cache_enabled_);
+    cache_dir_ = app::ExeDir() / "cache";
+
+    if (cache_enabled_ && ConsumeAotRebuildFlag()) {
+        std::error_code ec;
+        std::filesystem::remove(cache_dir_ / "vk_shaders.bin", ec);
+        std::filesystem::remove(cache_dir_ / "vk_shaders.bin.tmp", ec);
+        for (auto& e : std::filesystem::directory_iterator(cache_dir_, ec)) {
+            std::string fn = e.path().filename().string();
+            if (fn.rfind("vk_psos_", 0) == 0 || fn.rfind("vk_pso_meta_", 0) == 0 || fn.rfind("vk_aot_stamp_", 0) == 0) {
+                std::filesystem::remove(e.path(), ec);
+            }
+        }
+        LOGR("vulkan: scheduled shader cache rebuild requested; cleared disk caches before AOT precompile");
+    }
+
+    size_t loaded_shaders = 0;
+    std::vector<uint8_t> pso_init_data;
+    if (cache_enabled_) {
+        if (FILE* sf = std::fopen((cache_dir_ / "vk_shaders.bin").c_str(), "rb")) {
+            VkShaderCacheHeader hdr{};
+            if (std::fread(&hdr, sizeof(hdr), 1, sf) == 1 && std::memcmp(hdr.magic, "VKSC", 4) == 0 &&
+                hdr.version == 1 && hdr.abi == 1) {
+                while (true) {
+                    uint64_t h = 0;
+                    uint32_t wc = 0;
+                    if (std::fread(&h, sizeof(h), 1, sf) != 1 || std::fread(&wc, sizeof(wc), 1, sf) != 1) break;
+                    if (wc == 0 || wc > (4u << 20)) break;
+                    std::vector<uint32_t> words(wc);
+                    if (std::fread(words.data(), sizeof(uint32_t), wc, sf) != wc) break;
+                    VkShaderModuleCreateInfo smci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+                    smci.codeSize = words.size() * sizeof(uint32_t);
+                    smci.pCode = words.data();
+                    VkShaderModule mod = VK_NULL_HANDLE;
+                    if (vk_.create_shader(dev_, &smci, nullptr, &mod) == VK_SUCCESS) {
+                        shader_mods_[h] = mod;
+                        disk_blob_pending_.insert(h);
+                        shader_cache_entries_.emplace_back(h, std::move(words));
+                        loaded_shaders++;
+                    }
+                }
+            }
+            std::fclose(sf);
+        }
+
+        if (FILE* pf = std::fopen(PsoCachePath().c_str(), "rb")) {
+            VkPsoCacheHeader hdr{};
+            if (std::fread(&hdr, sizeof(hdr), 1, pf) == 1 && std::memcmp(hdr.magic, "VKPC", 4) == 0 &&
+                hdr.version == 1 && hdr.vendor_id == phys_props_.vendorID && hdr.device_id == phys_props_.deviceID &&
+                hdr.driver_version == phys_props_.driverVersion &&
+                std::memcmp(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE) == 0 && hdr.blob_size > 0 &&
+                hdr.blob_size < (256u << 20)) {
+                pso_init_data.resize(hdr.blob_size);
+                if (std::fread(pso_init_data.data(), 1, hdr.blob_size, pf) != hdr.blob_size) pso_init_data.clear();
+            }
+            std::fclose(pf);
+        }
+    }
+
+    VkPipelineCacheCreateInfo pcci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+    pcci.initialDataSize = pso_init_data.size();
+    pcci.pInitialData = pso_init_data.empty() ? nullptr : pso_init_data.data();
+    vk_.create_pipe_cache(dev_, &pcci, nullptr, &pipe_cache_);
+
+    LOGR("vulkan: cache initialized (enabled=%s, shaders_loaded=%zu, pso_blob=%zu B)",
+         cache_enabled_ ? "true" : "false", loaded_shaders, pso_init_data.size());
+    PrewarmCachedPsos();
+    PublishCacheStats();
+}
+
+void VulkanBackend::SaveCaches(bool sync) {
+    if (!cache_enabled_) return;
+    CacheSaveJob job{};
+    job.dir = cache_dir_;
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        if (!shaders_dirty_ && !pso_dirty_ && !meta_dirty_) {
+            if (!sync) return;
+        } else {
+            cache_dirty_frame_ = presents_;
+            if (shaders_dirty_) {
+                VkShaderCacheHeader hdr{{'V', 'K', 'S', 'C'}, 1u, 1u, 0u};
+                size_t total = sizeof(hdr);
+                for (const auto& [h, words] : shader_cache_entries_)
+                    total += sizeof(uint64_t) + sizeof(uint32_t) + words.size() * sizeof(uint32_t);
+                job.shaders_bytes.resize(total);
+                uint8_t* p = job.shaders_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                for (const auto& [h, words] : shader_cache_entries_) {
+                    uint32_t wc = uint32_t(words.size());
+                    size_t wbytes = size_t(wc) * sizeof(uint32_t);
+                    std::memcpy(p, &h, sizeof(h));
+                    p += sizeof(h);
+                    std::memcpy(p, &wc, sizeof(wc));
+                    p += sizeof(wc);
+                    if (wbytes) {
+                        std::memcpy(p, words.data(), wbytes);
+                        p += wbytes;
+                    }
+                }
+                job.write_shaders = true;
+                shaders_dirty_ = false;
+            }
+            if (pso_dirty_ && pipe_cache_ != VK_NULL_HANDLE) {
+                size_t sz = 0;
+                if (vk_.get_pipe_cache_data(dev_, pipe_cache_, &sz, nullptr) == VK_SUCCESS && sz > 0 &&
+                    sz < (256u << 20)) {
+                    job.pso_bytes.resize(sizeof(VkPsoCacheHeader) + sz);
+                    if (vk_.get_pipe_cache_data(dev_, pipe_cache_, &sz, job.pso_bytes.data() + sizeof(VkPsoCacheHeader)) ==
+                        VK_SUCCESS) {
+                        job.pso_bytes.resize(sizeof(VkPsoCacheHeader) + sz);
+                        VkPsoCacheHeader hdr{{'V', 'K', 'P', 'C'}, 1u, phys_props_.vendorID, phys_props_.deviceID,
+                                             phys_props_.driverVersion, {}, uint32_t(sz), 0u};
+                        std::memcpy(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE);
+                        std::memcpy(job.pso_bytes.data(), &hdr, sizeof(hdr));
+                        job.pso_path = PsoCachePath();
+                        job.write_pso = true;
+                    } else {
+                        job.pso_bytes.clear();
+                    }
+                }
+                pso_dirty_ = false;
+            }
+            if (meta_dirty_) {
+                VkPsoMetaHeader hdr{};
+                hdr.magic = kVkPsoMetaMagic;
+                hdr.version = kVkPsoMetaVersion;
+                hdr.sizeof_pso_key = uint32_t(sizeof(PsoKey));
+                hdr.vendor_id = phys_props_.vendorID;
+                hdr.device_id = phys_props_.deviceID;
+                hdr.driver_version = phys_props_.driverVersion;
+                std::memcpy(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE);
+                hdr.src_count = uint32_t(src_meta_entries_.size());
+                hdr.pso_count = uint32_t(pso_meta_entries_.size());
+                size_t src_bytes = src_meta_entries_.size() * sizeof(SrcMetaEntry);
+                size_t pso_bytes = pso_meta_entries_.size() * sizeof(PsoKey);
+                job.meta_bytes.resize(sizeof(hdr) + src_bytes + pso_bytes);
+                uint8_t* p = job.meta_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                if (src_bytes) {
+                    std::memcpy(p, src_meta_entries_.data(), src_bytes);
+                    p += src_bytes;
+                }
+                if (pso_bytes) std::memcpy(p, pso_meta_entries_.data(), pso_bytes);
+                job.meta_path = PsoMetaPath();
+                job.write_meta = true;
+                meta_dirty_ = false;
+            }
+        }
+    }
+    if (job.write_shaders || job.write_pso || job.write_meta) {
+        StartSaveThread();
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_pending_.dir = job.dir;
+            if (job.write_shaders) {
+                save_pending_.write_shaders = true;
+                save_pending_.shaders_bytes = std::move(job.shaders_bytes);
+            }
+            if (job.write_pso) {
+                save_pending_.write_pso = true;
+                save_pending_.pso_path = std::move(job.pso_path);
+                save_pending_.pso_bytes = std::move(job.pso_bytes);
+            }
+            if (job.write_meta) {
+                save_pending_.write_meta = true;
+                save_pending_.meta_path = std::move(job.meta_path);
+                save_pending_.meta_bytes = std::move(job.meta_bytes);
+            }
+            save_has_pending_ = true;
+        }
+        save_cv_.notify_one();
+    }
+    if (sync) DrainSaveThread();
+}
+
+void VulkanBackend::ResetCaches() {
+    Flush();
+    DrainSaveThread();
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        shader_cache_entries_.clear();
+        disk_blob_pending_.clear();
+        known_src_keys_.clear();
+        known_pso_keys_.clear();
+        src_meta_entries_.clear();
+        pso_meta_entries_.clear();
+        shaders_dirty_ = false;
+        pso_dirty_ = false;
+        meta_dirty_ = false;
+        aot_ready_ = false;
+        if (pipe_cache_ != VK_NULL_HANDLE) {
+            vk_.destroy_pipe_cache(dev_, pipe_cache_, nullptr);
+            pipe_cache_ = VK_NULL_HANDLE;
+        }
+        if (!cache_dir_.empty()) {
+            std::error_code ec;
+            std::filesystem::remove(cache_dir_ / "vk_shaders.bin", ec);
+            std::filesystem::remove(cache_dir_ / "vk_shaders.bin.tmp", ec);
+            for (auto& e : std::filesystem::directory_iterator(cache_dir_, ec)) {
+                std::string fn = e.path().filename().string();
+                if (fn.rfind("vk_psos_", 0) == 0 || fn.rfind("vk_pso_meta_", 0) == 0 ||
+                    fn.rfind("vk_aot_stamp_", 0) == 0)
+                    std::filesystem::remove(e.path(), ec);
+            }
+        }
+        VkPipelineCacheCreateInfo pcci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+        vk_.create_pipe_cache(dev_, &pcci, nullptr, &pipe_cache_);
+    }
+    PublishCacheStats();
+    LOGR("vulkan: shader/PSO disk cache cleared by user");
+}
+
+void VulkanBackend::FlushCaches() {
+    SaveCaches(true);
+    PublishCacheStats();
+    if (boot_init_complete_ && !session_summary_logged_) {
+        session_summary_logged_ = true;
+        LOGR("vulkan: session shader summary (aot_compiled=%zu, aot_psos=%zu, runtime_compiles=%zu, runtime_psos=%zu)",
+             aot_compiled_shaders_, aot_built_psos_, runtime_shader_compiles_, runtime_pso_creates_);
+    }
+}
+
+void VulkanBackend::Flush() {
+    Submit(true);
+    DeliverReports();
+}
