+            uint32_t cpu = 0;
+            uint64_t max_freq = 0;
+            bool shares_cpu0 = false;
+        };
+        std::vector<Cand> cands;
+        for (uint32_t c = 0; c < CPU_SETSIZE; ++c) {
+            if (!CPU_ISSET(c, &proc_set)) continue;
+            Cand item;
+            item.cpu = c;
+            item.shares_cpu0 = (c == 0);
+            char path[128];
