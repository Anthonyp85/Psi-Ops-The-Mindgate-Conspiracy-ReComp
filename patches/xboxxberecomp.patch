+bool ValidateAndLoadDisc(const fs::path& path, DiscValidation& out, std::unique_ptr<kernel::Disc>* out_disc,
+                         std::vector<uint8_t>* out_xbe) {
+    out = DiscValidation{};
+    std::error_code ec;
+    if (path.empty() || !fs::exists(path, ec)) {
+        out.code = "ERR_NOT_FOUND";
+        out.error = "Disc image file does not exist: " + path.string();
+        return false;
+    }
+    if (fs::is_directory(path, ec)) {
+        out.code = "ERR_IS_DIRECTORY";
+        out.error = "Selected path is a folder, not an Xbox disc image (.xiso.iso / .iso).";
+        return false;
+    }
+    uint8_t hdr[8] = {};
+#ifdef _WIN32
+    HANDLE h = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (h == INVALID_HANDLE_VALUE) {
+        out.code = "ERR_OPEN_FAILED";
+        out.error = "Cannot read disc image (file is locked or permission denied).";
+        return false;
+    }
+    DWORD got = 0;
+    BOOL read_ok = ReadFile(h, hdr, sizeof(hdr), &got, nullptr);
+    CloseHandle(h);
+    if (!read_ok || got < 6) {
+        out.code = "ERR_OPEN_FAILED";
+        out.error = "Disc image is empty or unreadable.";
+        return false;
+    }
+#else
+    int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        out.code = "ERR_OPEN_FAILED";
+        out.error = "Cannot read disc image (permission denied or unreadable).";
+        return false;
+    }
+    ssize_t got = ::read(fd, hdr, sizeof(hdr));
+    ::close(fd);
+    if (got < 6) {
+        out.code = "ERR_OPEN_FAILED";
+        out.error = "Disc image is empty or unreadable.";
+        return false;
+    }
+#endif
+    // Detect compressed archives before XDVDFS scan so the user gets immediate extraction guidance
+    const uint8_t k7z[6] = {0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C};
+    const uint8_t kZip[4] = {0x50, 0x4B, 0x03, 0x04};
+    const uint8_t kRar[4] = {0x52, 0x61, 0x72, 0x21};
+    const uint8_t kGz[2] = {0x1F, 0x8B};
+    if (std::memcmp(hdr, k7z, 6) == 0 || std::memcmp(hdr, kZip, 4) == 0 || std::memcmp(hdr, kRar, 4) == 0 ||
+        std::memcmp(hdr, kGz, 2) == 0) {
+        out.code = "ERR_COMPRESSED_ARCHIVE";
+        out.error = "Selected file is a compressed archive (.7z/.zip/.rar/.gz). Extract the .xiso.iso or .iso file first, then select the extracted disc image.";
+        return false;
+    }
+
+    auto disc = std::make_unique<kernel::Disc>();
+    std::string disc_err;
+    if (!disc->Open(path, disc_err)) {
+        out.code = "ERR_NOT_XISO";
+        out.error = "Not a valid Original Xbox XISO / DVD image (missing MICROSOFT*XBOX*MEDIA header): " + disc_err;
+        return false;
+    }
+
+    std::vector<uint8_t> xbe_bytes;
+    if (!disc->Load(IMAGE_XBE, xbe_bytes)) {
+        out.code = "ERR_NO_DEFAULT_XBE";
+        out.error = std::string("Xbox disc image does not contain ") + IMAGE_XBE + ".";
+        return false;
+    }
+
+    out.sha1 = Sha1(xbe_bytes);
