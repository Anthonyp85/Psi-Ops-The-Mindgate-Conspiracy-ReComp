+PacingPolicy ComputePacingPolicy(uint32_t refresh_hz, uint32_t fps_cap, PresentMode mode, bool tearing_supported) {
+    PacingPolicy p{};
+    p.refresh_hz = refresh_hz;
+    uint32_t cap = (fps_cap == kFpsCapRefresh) ? refresh_hz : fps_cap;
+    if (cap == 0) cap = 60;
+    p.fps_cap = cap;
+    p.mode = mode;
+    p.pace_target_ms = 1000.0 / double(cap);
