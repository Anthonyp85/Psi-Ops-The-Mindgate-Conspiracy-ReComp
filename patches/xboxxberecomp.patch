+void D3D12Backend::ComputeRenderExtents(uint32_t& out_rw, uint32_t& out_rh, uint32_t& out_vpx, uint32_t& out_vpy,
+                                        uint32_t& out_vpw, uint32_t& out_vph) const {
+    bool wide = app::Widescreen();
+    float aspect = wide ? 16.0f / 9.0f : 4.0f / 3.0f;
+    float w = float(std::max(bb_w_, 1u));
+    float h = float(std::max(bb_h_, 1u));
+    float vw = std::min(w, h * aspect);
+    float vh = vw / aspect;
+    out_vpw = std::max(1u, uint32_t(std::lround(vw)));
+    out_vph = std::max(1u, uint32_t(std::lround(vh)));
+    out_vpx = (bb_w_ > out_vpw) ? (bb_w_ - out_vpw) / 2u : 0u;
+    out_vpy = (bb_h_ > out_vph) ? (bb_h_ - out_vph) / 2u : 0u;
+
+    const app::Settings& s = app::Get();
+    if (Upscaler* u = g_upscaler.load(std::memory_order_acquire); u && upscaler_inited_) {
+        u->ResolveRenderSize(out_vpw, out_vph, guest_w_, guest_h_, wide, out_rw, out_rh);
+    } else {
+        float factor = std::clamp(float(s.render_percent) / 100.0f, 0.33f, 2.0f);
+        if (s.aspect_correct_render) {
+            out_rw = std::max(320u, uint32_t(std::lround(out_vpw * factor)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(out_vph * factor)) & ~1u);
+        } else {
+            float sc = std::max((out_vph * factor) / float(guest_h_), 0.5f);
+            out_rw = std::max(320u, uint32_t(std::lround(guest_w_ * sc)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(guest_h_ * sc)) & ~1u);
+        }
+    }
+    out_rw = std::max(320u, out_rw & ~1u);
+    out_rh = std::max(240u, out_rh & ~1u);
+}
