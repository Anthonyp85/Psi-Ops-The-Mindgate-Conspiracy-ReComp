+template <typename Enum, size_t N>
+bool ParseEnum(const std::string& v, const char* const (&names)[N], Enum& out) {
+    std::string lv = LowerAscii(v);
+    for (size_t i = 0; i < N; ++i) {
+        if (lv == names[i]) {
+            out = Enum(i);
+            return true;
+        }
+    }
+    return false;
+}
