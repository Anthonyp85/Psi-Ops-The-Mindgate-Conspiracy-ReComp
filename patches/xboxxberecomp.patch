+std::vector<std::wstring> SplitArgs(const wchar_t* cmd) {
+    std::vector<std::wstring> args;
+    if (!cmd) return args;
+    const wchar_t* p = cmd;
+    while (*p) {
+        while (*p && std::iswspace(*p)) ++p;
+        if (!*p) break;
+        std::wstring a;
+        bool q = false;
+        while (*p && (q || !std::iswspace(*p))) {
+            if (*p == L'"') q = !q;
+            else a.push_back(*p);
+            ++p;
+        }
+        args.push_back(std::move(a));
+    }
+    return args;
+}
+
+std::string JsonEsc(const std::string& s) {
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (unsigned char c : s) {
+        switch (c) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    char b[8];
+                    std::snprintf(b, sizeof(b), "\\u%04X", c);
+                    out += b;
+                } else {
+                    out.push_back(char(c));
+                }
+        }
+    }
+    return out;
+}
+
+void WriteStdoutLine(const std::string& line) {
+    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (h && h != INVALID_HANDLE_VALUE) {
+        std::string s = line + "\n";
+        DWORD written = 0;
+        WriteFile(h, s.data(), DWORD(s.size()), &written, nullptr);
+    }
+}
