+        }
+        coordinator.join();
+
+        for (size_t i = 0; i < pso_items.size(); ++i) {
+            if (!out_psos[i]) continue;
+            const AotPsoItem& it = pso_items[i];
+            psos_[it.hash] = out_psos[i];
+            if (known_pso_keys_.insert(it.hash).second) {
