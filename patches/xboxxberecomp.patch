+void FlushLocked(PerfState& st) {
+    if (st.json_path.empty()) return;
+    double wall_s = std::chrono::duration<double>(Clock::now() - st.start_tp).count();
+    if (wall_s <= 0.0) wall_s = 0.001;
+
+    uint64_t proc_cpu_delta = ProcessCpu100ns() - st.proc_cpu_start;
+#ifdef _WIN32
+    uint64_t title_cpu_delta = st.title_thread ? (ThreadCpu100ns(st.title_thread) - st.title_cpu_start) : 0;
+    uint64_t render_cpu_delta = st.render_thread ? (ThreadCpu100ns(st.render_thread) - st.render_cpu_start) : 0;
+#else
+    uint64_t title_cpu_delta = st.has_title_clock ? (Clock100ns(st.title_clock) - st.title_cpu_start) : 0;
+    uint64_t render_cpu_delta = st.has_render_clock ? (Clock100ns(st.render_clock) - st.render_cpu_start) : 0;
+#endif
+    double wall_100ns = wall_s * 1e7;
+    double proc_cpu_pct = 100.0 * double(proc_cpu_delta) / (wall_100ns * double(std::max(1u, st.logical_cpus)));
+    double title_cpu_pct = 100.0 * double(title_cpu_delta) / wall_100ns;
+    double render_cpu_pct = 100.0 * double(render_cpu_delta) / wall_100ns;
+
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS_EX pmc{};
+    pmc.cb = sizeof(pmc);
+    K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc));
+    uint64_t host_ws_final = pmc.WorkingSetSize;
+    uint64_t host_ws_peak = std::max<uint64_t>(st.host_ws_peak, pmc.PeakWorkingSetSize);
+    uint64_t host_priv_final = pmc.PrivateUsage;
+    uint64_t host_priv_peak = std::max<uint64_t>(st.host_priv_peak, pmc.PrivateUsage);
+    uint64_t page_faults = pmc.PageFaultCount >= st.page_faults_start ? pmc.PageFaultCount - st.page_faults_start : 0;
+#else
+    LinuxMemInfo lm = QueryLinuxMem();
+    uint64_t host_ws_final = lm.rss;
+    uint64_t host_ws_peak = std::max<uint64_t>(st.host_ws_peak, lm.hwm);
+    uint64_t host_priv_final = lm.priv;
+    uint64_t host_priv_peak = std::max<uint64_t>(st.host_priv_peak, lm.priv);
+    uint64_t page_faults = lm.page_faults >= st.page_faults_start ? lm.page_faults - st.page_faults_start : 0;
+#endif
+
+    mem::Stats ms = mem::Query();
+    st.guest_contig_peak_pages = std::max<uint64_t>(st.guest_contig_peak_pages, ms.contiguous_used);
+    st.guest_virt_peak_pages = std::max<uint64_t>(st.guest_virt_peak_pages, ms.virtual_committed);
+    st.guest_sys_peak_pages = std::max<uint64_t>(st.guest_sys_peak_pages, ms.system_used);
+
+    std::vector<FrameSample> snap;
+    {
+        std::lock_guard<std::mutex> lock(st.samples_lock);
+        snap = st.samples;
+    }
+
+    std::error_code ec;
+    std::filesystem::path jp(st.json_path);
+    if (jp.has_parent_path()) std::filesystem::create_directories(jp.parent_path(), ec);
+
+    // 1. Write per-frame CSV
+    if (!st.csv_path.empty()) {
+        if (FILE* cf = std::fopen(st.csv_path.c_str(), "wb")) {
+            std::fprintf(cf,
+                         "frame,t_s,phase,render_ms,guest_ms,guest_capture_ms,pace_ms,swap_phase1_ms,wait_gpu_ms,"
+                         "draw_ms,assemble_ms,bind_ms,sig_ms,texup_ms,clear_ms,copy_ms,sync_ms,present_ms,swap_call_ms,"
+                         "fence_wait_ms,gpu_ms,compile_ms,pso_ms,shaders,psos,wait_res_ms,glock_bg_ms,disc_ms,z_write_ms,"
+                         "draws,upload_bytes,contig_alloc_bytes,g_dt_ms,g_elapsed_s,g_frame\n");
+            for (const FrameSample& f : snap) {
+                std::fprintf(cf,
+                             "%llu,%.4f,%s,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
+                             "%.3f,%.3f,%.3f,%.3f,%.3f,%u,%u,%.3f,%.3f,%.3f,%.3f,%u,%llu,%llu,%.2f,%.4f,%u\n",
+                             (unsigned long long)f.index, f.t_s, kPhaseNames[size_t(f.phase)], f.render_ms, f.guest_ms,
+                             f.guest_capture_ms, f.pace_ms, f.swap_phase1_ms, f.wait_gpu_frame_ms, f.draw_ms,
+                             f.assemble_ms, f.bind_ms, f.sig_ms, f.texup_ms, f.clear_ms, f.copy_ms, f.sync_ms,
+                             f.present_ms, f.swap_call_ms, f.fence_wait_ms, f.gpu_ms, f.compile_ms, f.pso_ms, f.shaders,
+                             f.psos, f.wait_resource_ms, f.glock_bg_wait_ms, f.disc_ms, f.z_write_ms, f.draws,
+                             (unsigned long long)f.upload_bytes, (unsigned long long)f.contig_alloc_bytes, f.g_dt_ms,
+                             f.g_elapsed_s, f.g_frame);
+            }
+            std::fclose(cf);
+        }
+    }
+
+    // 2. Partition frames by phase (skip frame 0 which has no prior present interval)
+    std::vector<const FrameSample*> all_valid;
+    std::array<std::vector<const FrameSample*>, size_t(Phase::Count)> by_phase;
+    double compile_max_frame = 0.0, pso_max_frame = 0.0, fence_wait_total = 0.0;
+    uint64_t contig_max_frame = 0;
+    for (const FrameSample& f : snap) {
+        if (f.index == 0) continue;
+        all_valid.push_back(&f);
+        by_phase[size_t(f.phase)].push_back(&f);
+        compile_max_frame = std::max(compile_max_frame, f.compile_ms);
+        pso_max_frame = std::max(pso_max_frame, f.pso_ms);
+        fence_wait_total += f.fence_wait_ms;
+        contig_max_frame = std::max(contig_max_frame, f.contig_alloc_bytes);
+    }
+
+    FILE* fp = std::fopen(st.json_path.c_str(), "wb");
+    if (!fp) {
+        LOGE("perf: cannot open %s for writing", st.json_path.c_str());
+        return;
+    }
