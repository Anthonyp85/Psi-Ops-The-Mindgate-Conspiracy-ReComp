+bool BrowseDiscImage(void* owner_hwnd, fs::path& picked) {
+#ifdef _WIN32
+    ComPtr<IFileOpenDialog> dlg;
+    HRESULT hr = CoCreateInstance(CLSID_FileOpenDialog, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&dlg));
+    if (FAILED(hr) || !dlg) return false;
+    DWORD opts = 0;
+    if (SUCCEEDED(dlg->GetOptions(&opts))) {
+        dlg->SetOptions(opts | FOS_FILEMUSTEXIST | FOS_PATHMUSTEXIST | FOS_FORCEFILESYSTEM | FOS_NOCHANGEDIR);
+    }
+    const COMDLG_FILTERSPEC filters[] = {
+        {L"Xbox Disc Images (*.xiso.iso; *.iso)", L"*.xiso.iso;*.iso"},
+        {L"All Files (*.*)", L"*.*"},
+    };
+    dlg->SetFileTypes(2, filters);
+    dlg->SetFileTypeIndex(1);
+    std::wstring title = std::wstring(L"Select ") + kGame.title + L" Xbox Disc Image (.xiso.iso / .iso)";
+    dlg->SetTitle(title.c_str());
+
+    hr = dlg->Show(static_cast<HWND>(owner_hwnd));
+    if (FAILED(hr)) return false;
+
+    ComPtr<IShellItem> item;
+    if (FAILED(dlg->GetResult(&item)) || !item) return false;
+    PWSTR raw = nullptr;
+    if (FAILED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw)) || !raw) return false;
+    picked = fs::path(raw);
