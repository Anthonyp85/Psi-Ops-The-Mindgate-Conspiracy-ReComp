+struct PlanBuilder {
+    AotPlan plan{};
+    bool is_vulkan = false;
+    uint32_t scanned_archives = 0;
+
+    std::unordered_set<uint64_t> seen_shader_src;
+    std::unordered_set<uint64_t> seen_blob_hashes;
+
+    std::unordered_map<uint64_t, ScannedVs> scanned_vs;
+    std::vector<uint64_t> scanned_vs_order;
+    std::unordered_map<uint64_t, ScannedPs> scanned_ps;
+    std::vector<uint64_t> scanned_ps_order;
+
+    // Compiled shader hashes indexed by game role for accurate PSO seeding
+    std::vector<CompiledVsRef> mesh_vs;      // zoneMesh, mesh, meshUnlit, skinMesh
+    std::vector<CompiledVsRef> shadow_vs;    // shadow, shadowSkinned
+    std::vector<CompiledVsRef> generic_vs;   // GenericMesh
+    std::vector<CompiledVsRef> generic2d_vs; // GenericMesh2D
+    std::vector<CompiledVsRef> mblur_vs;     // MotionBlurMesh
+    std::vector<CompiledVsRef> fog_vs;       // PerPixelFog
+    std::vector<CompiledVsRef> psimple_vs;   // ParticleSimple
+    std::vector<CompiledVsRef> pdistort_vs;  // ParticleDistortion
+
+    std::vector<LayerPsRef> layer_ps;        // layer1*, layer2*, layer3*, layer4* (opaque/atest)
+    std::vector<uint64_t> shadow_ps;         // shadow.psh
+    std::vector<uint64_t> generic_ps;        // GenericMesh.psh / layer1.psh
+    std::vector<uint64_t> generic2d_ps;      // GenericMesh2D.psh
+    std::vector<uint64_t> mblur_ps;          // MotionBlurMesh.psh / fullScreenEffect*.psh
+    std::vector<uint64_t> sat_ps;            // SaturationAdjustPPMesh.psh
+    std::vector<uint64_t> fog_ps;            // PerPixelFog.psh
+    std::vector<uint64_t> psimple_ps;        // ParticleSimple.psh
+    std::vector<uint64_t> pdistort_ps;       // ParticleDistortion.psh
+
+    uint64_t AddShaderJob(const std::string& hlsl, uint64_t src_key, const char* entry, const char* profile,
+                          bool is_pixel) {
+        uint64_t blob_hash = ComputeShaderBlobHash(hlsl, entry, profile);
+        uint64_t dedup = src_key ? (src_key ^ (blob_hash * 0x9E3779B97F4A7C15ull)) : blob_hash;
+        if (seen_shader_src.insert(dedup).second) {
+            seen_blob_hashes.insert(blob_hash);
+            plan.shaders.push_back(AotShaderJob{blob_hash, src_key, hlsl, entry, profile, is_pixel});
+        }
+        return blob_hash;
+    }
+
+    uint64_t AddFixedVs(const VertexLayoutSeed& lay, const FixedKey& fk, bool quad) {
+        uint32_t hkey = lay.fvf_or_handle;
+        uint64_t seed = Hash(&hkey, 4, uint64_t(lay.regs) | kDeclarationSalt);
+        uint64_t vkey = Hash(&lay.decode, 8, seed);
+        if (lay.pretransformed) vkey ^= kPretransformedSalt;
+        if (quad) vkey ^= kQuadSalt;
+        vkey = Hash(&fk, sizeof(fk), vkey);
+
+        std::string src = ReversedDepthHlsl(FixedVertexHlsl(lay.regs, lay.pretransformed, lay.decode, fk));
+        if (quad) src = QuadHlsl(std::move(src));
+        return AddShaderJob(src, vkey, "main", "vs_5_0", false);
+    }
+
+    uint64_t AddProgVs(const std::vector<uint32_t>& prog, const VertexLayoutSeed& lay, bool quad, bool sprite) {
+        uint64_t prog_hash = Hash(prog.data(), prog.size() * 4) | 1ull;
+        uint64_t vkey = Hash(&lay.decode, 8, prog_hash ^ uint64_t(lay.regs));
+        if (quad) vkey ^= kQuadSalt;
+        if (sprite) vkey ^= kSpriteSalt;
+
+        std::string src = VertexProgramHlsl(prog, lay.regs, lay.decode);
+        if (sprite) src = SpriteSizeHlslLocal(std::move(src));
+        src = ReversedDepthHlsl(std::move(src));
+        if (quad) src = QuadHlsl(std::move(src));
+        return AddShaderJob(src, vkey, "main", "vs_5_0", false);
+    }
+
+    uint64_t AddPixelShader(const PixelKey& pk) {
+        uint64_t pkey = Hash(&pk, sizeof(pk));
+        uint64_t src_key = pkey ^ kPixelKeySalt;
+        std::string src = PixelHlsl(pk);
+        return AddShaderJob(src, src_key, "main", "ps_5_0", true);
+    }
+
+    void AddPso(uint64_t vs_hash, uint64_t ps_hash, const VertexLayoutSeed& lay, const BlendSeed& bl,
+                const DepthStencilSeed& ds, uint32_t strip = 0, uint32_t has_rt = 1) {
+        if (!vs_hash || !ps_hash) return;
+        AotPsoSeed s{};
+        s.vs_hash = vs_hash;
+        s.ps_hash = ps_hash;
+        s.regs = lay.regs;
+        std::memcpy(s.elements, lay.elements, sizeof(s.elements));
+        s.buf_count = lay.buf_count;
+        std::memcpy(s.strides, lay.strides, sizeof(s.strides));
+        s.topo = uint32_t(Topology::Triangles);
+        s.strip = strip;
+        s.has_rt = has_rt;
+        s.has_ds = ds.has_ds;
+        s.blend = bl.blend;
+        s.src = bl.src;
+        s.dst = bl.dst;
+        s.op = bl.op;
+        s.wmask = bl.wmask;
+        s.zen = ds.zen;
+        s.zwrite = ds.zwrite;
+        s.zfunc = ds.zfunc;
+        s.sten = ds.sten;
+        s.sfunc = ds.sfunc;
+        s.smask = ds.smask;
+        s.swmask = ds.swmask;
+        s.sfail = ds.sfail;
+        s.szfail = ds.szfail;
+        s.spass = ds.spass;
+        s.cull = 0;
+        s.ccw = 0;
+        s.fill = 0x1B02;  // D3DFILL_SOLID
+        plan.psos.push_back(s);
+    }
+
+    void RecordShrxVertexProgram(const std::string& lower_name, const std::vector<uint32_t>& words) {
+        uint64_t ph = Hash(words.data(), words.size() * 4) | 1ull;
+        if (scanned_vs.find(ph) != scanned_vs.end()) return;
+        scanned_vs[ph] = ScannedVs{lower_name, words};
+        scanned_vs_order.push_back(ph);
+    }
+
+    void RecordShrxPixelShader(const std::string& lower_name, const uint32_t def[60]) {
+        uint64_t dh = Hash(def, 60 * sizeof(uint32_t));
+        auto it = scanned_ps.find(dh);
+        if (it == scanned_ps.end()) {
+            ScannedPs sp{};
+            sp.names.push_back(lower_name);
+            std::memcpy(sp.def, def, sizeof(sp.def));
+            scanned_ps[dh] = std::move(sp);
+            scanned_ps_order.push_back(dh);
+        } else {
+            auto& names = it->second.names;
+            if (std::find(names.begin(), names.end(), lower_name) == names.end()) {
+                names.push_back(lower_name);
+            }
+        }
+    }
+
+    template <typename ReadFn>
+    void ScanEspxArchive(uint64_t file_size, ReadFn&& read_at) {
+        if (file_size < sizeof(EspxV6Header)) return;
+        EspxV6Header hdr{};
+        if (read_at(0, &hdr, uint32_t(sizeof(hdr))) != sizeof(hdr)) return;
+        if (std::memcmp(hdr.magic, "ESPx", 4) != 0 || hdr.version != 6u) return;
+        if (hdr.type_dir_size < 4u || hdr.type_dir_size > (1u << 20)) return;
+        if (uint64_t(hdr.type_dir_off) + hdr.type_dir_size > file_size) return;
+        if (uint64_t(hdr.entry_tbl_off) + hdr.entry_tbl_size > file_size) return;
+        if (uint64_t(hdr.str_tbl_off) + hdr.str_tbl_size > file_size) return;
+
+        scanned_archives++;
+
+        std::vector<uint8_t> type_dir(hdr.type_dir_size);
+        if (read_at(hdr.type_dir_off, type_dir.data(), hdr.type_dir_size) != hdr.type_dir_size) return;
+        const uint32_t num_types = ReadLe32(type_dir.data());
+        if (4ull + uint64_t(num_types) * sizeof(EspxTypeRecord) > type_dir.size()) return;
+
+        for (uint32_t t = 0; t < num_types; ++t) {
+            EspxTypeRecord tr{};
+            std::memcpy(&tr, type_dir.data() + 4 + size_t(t) * sizeof(EspxTypeRecord), sizeof(tr));
+            if (std::memcmp(tr.fourcc, "shrx", 4) != 0) continue;
+            if (tr.count == 0u || tr.count > 4096u) continue;
+            const uint64_t entries_bytes = uint64_t(tr.count) * sizeof(EspxEntryRecord);
+            if (uint64_t(tr.entry_rel_off) + entries_bytes > hdr.entry_tbl_size) continue;
+
+            std::vector<EspxEntryRecord> entries(tr.count);
+            if (read_at(uint64_t(hdr.entry_tbl_off) + tr.entry_rel_off, entries.data(), uint32_t(entries_bytes)) !=
+                entries_bytes) {
+                continue;
+            }
+
+            std::vector<uint8_t> payload;
+            for (const EspxEntryRecord& er : entries) {
+                if (er.data_size < 12u || er.data_size > (256u << 10)) continue;
+                if (uint64_t(er.data_file_off) + er.data_size > file_size) continue;
+
+                // Read entry name from string table (bounded 128-byte slice)
+                char name_buf[129] = {};
+                if (er.name_str_off < hdr.str_tbl_size) {
+                    uint32_t nlen = uint32_t(std::min<uint64_t>(128ull, hdr.str_tbl_size - er.name_str_off));
+                    read_at(uint64_t(hdr.str_tbl_off) + er.name_str_off, name_buf, nlen);
+                    name_buf[nlen] = '\0';
+                }
+                const std::string base_name = BaseLowerName(name_buf);
+
+                payload.resize(er.data_size);
+                if (read_at(er.data_file_off, payload.data(), er.data_size) != er.data_size) continue;
+                const uint32_t body_size = ReadLe32(payload.data() + 4);
+                if (body_size == 0u || body_size > er.data_size - 8u) continue;
+                const uint8_t* body = payload.data() + 8;
+
+                if (EndsWith(base_name, ".vsh")) {
+                    if (body_size < 20u) continue;
+                    const uint32_t vsh_hdr = ReadLe32(body);
+                    const uint32_t magic = vsh_hdr & 0xFFFFu;
+                    const uint32_t insns = vsh_hdr >> 16;
+                    if (magic != 0x2078u || insns < 2u || insns > 136u) continue;
+                    if (4u + insns * 16u > body_size) continue;
+                    std::vector<uint32_t> words(size_t(insns) * 4u);
+                    std::memcpy(words.data(), body + 4, size_t(insns) * 16u);
+                    if (IsValidNv2aVertexProgram(words.data(), insns)) {
+                        RecordShrxVertexProgram(base_name, words);
+                    }
+                } else if (EndsWith(base_name, ".psh")) {
+                    if (body_size != 240u) continue;
+                    uint32_t def[60];
+                    std::memcpy(def, body, sizeof(def));
+                    RecordShrxPixelShader(base_name, def);
+                }
+            }
+        }
+    }
+
+    void WalkDiscEntry(const kernel::Disc& disc, const kernel::Disc::Entry& entry) {
+        if (entry.dir) {
+            for (const auto& child : entry.children) {
+                WalkDiscEntry(disc, child);
+            }
+            return;
+        }
+        if (EndsWith(LowerAscii(entry.name), ".xbox")) {
+            ScanEspxArchive(entry.size, [&](uint64_t pos, void* out, uint32_t len) -> uint32_t {
+                return disc.Read(entry, pos, out, len);
+            });
+        }
+    }
+
+    void ScanExtractedAssetsFolder() {
+        fs::path dir = app::ExeDir();
+        std::error_code ec;
+        fs::path assets_root;
+        for (int i = 0; i < 6; ++i) {
+            if (fs::is_directory(dir / "assets" / "data", ec)) {
+                assets_root = dir / "assets" / "data";
+                break;
+            }
+            if (!dir.has_parent_path() || dir.parent_path() == dir) break;
+            dir = dir.parent_path();
+        }
+        if (assets_root.empty()) return;
+
+        for (auto it = fs::recursive_directory_iterator(assets_root, ec); !ec && it != fs::recursive_directory_iterator();
+             it.increment(ec)) {
+            if (!it->is_regular_file(ec)) continue;
+            if (!EndsWith(LowerAscii(it->path().filename().string()), ".xbox")) continue;
+            uint64_t fsz = it->file_size(ec);
+            if (ec || fsz < sizeof(EspxV6Header)) continue;
+            FILE* f = OpenRead(it->path());
+            if (!f) continue;
+            ScanEspxArchive(fsz, [&](uint64_t pos, void* out, uint32_t len) -> uint32_t {
+                if (pos >= fsz) return 0u;
+#ifdef _WIN32
+                if (_fseeki64(f, static_cast<__int64>(pos), SEEK_SET) != 0) return 0u;
+#else
+                if (std::fseek(f, static_cast<long>(pos), SEEK_SET) != 0) return 0u;
+#endif
+                return uint32_t(std::fread(out, 1, len, f));
+            });
+            std::fclose(f);
+        }
+    }
+
+    void ScanMountedSources() {
+        if (const kernel::Disc* disc = kernel::MountedDisc()) {
+            if (const kernel::Disc::Entry* root = disc->Find("")) {
+                WalkDiscEntry(*disc, *root);
+            }
+        } else {
+            ScanExtractedAssetsFolder();
+        }
+        plan.scanned_vs_programs = uint32_t(scanned_vs.size());
+        plan.scanned_ps_defs = uint32_t(scanned_ps.size());
+    }
+
+    void EmitScannedProgrammableShaders() {
+        // 1. Translate all discovered .vsh NV2A vertex programs with their exact runtime declaration permutations
+        const VertexLayoutSeed lay_025 = MakeLayout_Prog025();
+        const VertexLayoutSeed lay_065 = MakeLayout_Prog065();
+        const VertexLayoutSeed lay_027 = MakeLayout_Prog027();
+        const VertexLayoutSeed lay_067 = MakeLayout_Prog067();
+        const VertexLayoutSeed lay_0e7 = MakeLayout_Prog0E7();
+        const VertexLayoutSeed lay_1e7 = MakeLayout_Prog1E7();
+        const VertexLayoutSeed lay_03f_raw = MakeLayout_Prog03F(true);
+        const VertexLayoutSeed lay_03f_flt = MakeLayout_Prog03F(false);
+        const VertexLayoutSeed lay_07f_raw = MakeLayout_Prog07F(true);
+        const VertexLayoutSeed lay_07f_flt = MakeLayout_Prog07F(false);
+
