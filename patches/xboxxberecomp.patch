+bool HasValidConfiguredGame() {
+    auto check_iso = [](const fs::path& p) -> bool {
+        if (p.empty()) return false;
+        DiscValidation v;
+        return ValidateAndLoadDisc(p, v, nullptr, nullptr);
+    };
+    if (fs::path cli = CliOrEnvIso(); !cli.empty()) return check_iso(cli);
+    if (fs::path cfg = ConfiguredSettingsIso(); !cfg.empty() && check_iso(cfg)) return true;
+    fs::path assets = FindAssets();
+    if (!assets.empty()) {
+        std::vector<uint8_t> xbe_bytes;
+        fs::path xbe_path = FindCaseInsensitiveFile(assets, IMAGE_XBE);
+        if (!xbe_path.empty() && ReadHostFile(xbe_path, xbe_bytes) && Runs(Sha1(xbe_bytes))) return true;
+        std::error_code ec;
+        for (auto& e : fs::directory_iterator(assets, ec)) {
+            std::string ext = LowerAsciiStr(e.path().extension().string());
+            if (ext == ".iso" && e.is_regular_file(ec) && check_iso(e.path())) return true;
+        }
+    }
+    for (const fs::path& iso : FindWorkspaceIsos()) {
+        if (check_iso(iso)) return true;
+    }
+    return false;
