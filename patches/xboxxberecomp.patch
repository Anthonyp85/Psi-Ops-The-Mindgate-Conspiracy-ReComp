+void ApplyRadialDeadzone(int16_t& x, int16_t& y, uint32_t dz_pct) {
+    if (dz_pct == 0u) return;
+    double dz = std::clamp(double(dz_pct) / 100.0, 0.0, 0.45);
+    double nx = double(x) / 32767.0;
+    double ny = double(y) / 32767.0;
+    double mag = std::hypot(nx, ny);
+    if (mag <= dz) {
+        x = 0;
+        y = 0;
+        return;
+    }
+    double scaled = std::min(1.0, (mag - dz) / (1.0 - dz));
+    double factor = (scaled / mag) * 32767.0;
+    x = int16_t(std::clamp(std::lround(nx * factor), -32768L, 32767L));
+    y = int16_t(std::clamp(std::lround(ny * factor), -32768L, 32767L));
+}
