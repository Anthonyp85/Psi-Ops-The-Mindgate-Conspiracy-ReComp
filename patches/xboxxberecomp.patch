+    static constexpr uint8_t kSig[8] = {137, 80, 78, 71, 13, 10, 26, 10};
+    std::vector<uint8_t> png(kSig, kSig + 8);
+    std::vector<uint8_t> ihdr;
+    ihdr.reserve(13);
+    WriteBe32(ihdr, img.width);
+    WriteBe32(ihdr, img.height);
+    ihdr.push_back(8);  // bit depth
+    ihdr.push_back(6);  // RGBA
+    ihdr.push_back(0);  // deflate
+    ihdr.push_back(0);  // filter
+    ihdr.push_back(0);  // non-interlaced
+    AppendPngChunk(png, "IHDR", ihdr.data(), ihdr.size());
+    AppendPngChunk(png, "IDAT", comp.data(), comp.size());
+    AppendPngChunk(png, "IEND", nullptr, 0);
+
+    std::ofstream out(path, std::ios::binary);
+    out.write(reinterpret_cast<const char*>(png.data()), std::streamsize(png.size()));
+    if (!out) LOGE("texture dump: %s not written", Utf8(path).c_str());
+}
