+VkPipeline VulkanBackend::EnsureClearPipeline(VkFormat rtv, uint8_t mask) {
+    uint64_t key = 0x4000000000000000ull | (uint64_t(rtv) << 8) | mask;
+    auto it = blit_psos_.find(key);
