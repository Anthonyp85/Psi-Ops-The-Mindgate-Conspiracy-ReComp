+        for (const Cand& c : cands) best_freq = std::max(best_freq, c.max_freq);
+        std::vector<Cand> top;
+        for (const Cand& c : cands)
+            if (c.max_freq == best_freq) top.push_back(c);
+        bool has_non_cpu0 = false;
+        for (const Cand& c : top)
