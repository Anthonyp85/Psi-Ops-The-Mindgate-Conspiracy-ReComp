+fs::path FindCaseInsensitiveFile(const fs::path& dir, const char* want_name) {
+    std::error_code ec;
+    fs::path exact = dir / want_name;
+    if (fs::is_regular_file(exact, ec)) return exact;
+    std::string want = LowerAsciiStr(want_name);
+    for (auto& e : fs::directory_iterator(dir, ec)) {
+        if (e.is_regular_file(ec) && LowerAsciiStr(e.path().filename().string()) == want) return e.path();
+    }
+    return {};
