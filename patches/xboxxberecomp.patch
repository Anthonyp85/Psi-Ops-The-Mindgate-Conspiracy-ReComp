+std::string SanitizeHlslForGlslang(std::string s) {
+    // 1. FXC-only INF literals
+    ReplaceAll(s, "-1.#INF", "asfloat(0xFF800000u)");
+    ReplaceAll(s, "1.#INF", "asfloat(0x7F800000u)");
+
+    // 2. Vector bool4 || bool4 in mac_mul
+    ReplaceAll(s,
+               "float4 mac_mul(float4 a, float4 b) { return (a == 0 || b == 0) ? (float4)0 : a * b; }",
+               "float4 mac_mul(float4 a, float4 b) { return float4((a.x == 0.0 || b.x == 0.0) ? 0.0 : a.x * b.x, "
+               "(a.y == 0.0 || b.y == 0.0) ? 0.0 : a.y * b.y, (a.z == 0.0 || b.z == 0.0) ? 0.0 : a.z * b.z, "
+               "(a.w == 0.0 || b.w == 0.0) ? 0.0 : a.w * b.w); }");
+
+    // 3. UnpackNp3 implicit int -> float3 max()
+    ReplaceAll(s, "max(float3(v) / float3(1023, 1023, 511), -1)",
+               "max(float3(v) / float3(1023.0, 1023.0, 511.0), float3(-1.0, -1.0, -1.0))");
+
+    // 4. QuadHlsl unstretch float ternary + scalar 0 branch
+    ReplaceAll(s,
+               "return t + (d.x ? d.x / g.x * ddx(t) : 0) + (d.y ? d.y / g.y * ddy(t) : 0);",
+               "return t + (d.x != 0.0 ? (d.x / g.x) * ddx(t) : float4(0.0, 0.0, 0.0, 0.0)) + "
+               "(d.y != 0.0 ? (d.y / g.y) * ddy(t) : float4(0.0, 0.0, 0.0, 0.0));");
+
+    // 5. sbyte vector ternary with scalar branches
+    ReplaceAll(s,
+               "float3 sbyte(float3 u, float lo, float hi, float d) { float3 b = u * 255; return (b - (b >= 128 ? hi : lo)) / d; }",
+               "float3 sbyte(float3 u, float lo, float hi, float d) { float3 b = u * 255.0; return (b - "
+               "float3(b.x >= 128.0 ? hi : lo, b.y >= 128.0 ? hi : lo, b.z >= 128.0 ? hi : lo)) / d; }");
+
+    // 6. Macro-inline shadow() to eliminate opaque Texture2D/SamplerComparisonState function parameters
+    const char* kShadowRev =
+        "float4 shadow(Texture2D<float> t, SamplerComparisonState s, float2 uv, float z, int fmt, float2 px, float2 size) {\n"
+        "    float mx = fmt == 2 ? 65535.0 : 16777215.0;\n"
+        "    return t.SampleCmpLevelZero(s, uv, 1 - clamp(z, 0, mx) / mx).xxxx;\n"
+        "}";
+    const char* kShadowRevRepl =
+        "float _shadow_ref(float z, int fmt) { float mx = fmt == 2 ? 65535.0 : 16777215.0; return 1.0 - clamp(z, 0.0, mx) / mx; }\n"
+        "#define shadow(t, s, uv, z, fmt, px, size) ((t).SampleCmpLevelZero((s), (uv), _shadow_ref((z), (fmt))).xxxx)";
+    ReplaceAll(s, kShadowRev, kShadowRevRepl);
+
+    // 7. Specialize spreadtap() per stage (eliminates opaque Texture2D/SamplerState function parameters)
+    const char* kSpreadDef =
+        "float4 spreadtap(Texture2D t, SamplerState s, float2 uv, float4 w, float m) {\n"
+        "    float4 c = 0;\n"
+        "    int n = (int)w.z;\n"
+        "    for (int y = 0; y < n; y++)\n"
+        "        for (int x = 0; x < n; x++) {\n"
+        "            float4 v = t.SampleLevel(s, uv + w.xy * (float2(x, y) - (n - 1) * 0.5), 0);\n"
+        "            c += float4(saturate(v.rgb * m), v.a);\n"
+        "        }\n"
+        "    return c / (n * n);\n"
+        "}\n";
+    if (size_t sp_pos = s.find(kSpreadDef); sp_pos != std::string::npos) {
+        s.erase(sp_pos, std::strlen(kSpreadDef));
+        std::string helpers;
+        for (int i = 0; i < 4; ++i) {
+            char call[32];
+            std::snprintf(call, sizeof(call), "spreadtap(tex%d, smp%d, ", i, i);
+            if (s.find(call) != std::string::npos) {
+                char repl[32];
+                std::snprintf(repl, sizeof(repl), "spreadtap_%d(", i);
+                ReplaceAll(s, call, repl);
+                char fn[512];
+                std::snprintf(fn, sizeof(fn),
+                              "float4 spreadtap_%d(float2 uv, float4 w, float m) {\n"
+                              "    float4 c = float4(0.0, 0.0, 0.0, 0.0);\n"
+                              "    int n = (int)w.z;\n"
+                              "    for (int y = 0; y < n; y++)\n"
+                              "        for (int x = 0; x < n; x++) {\n"
+                              "            float4 v = tex%d.SampleLevel(smp%d, uv + w.xy * (float2(x, y) - (n - 1) * 0.5), 0);\n"
+                              "            c += float4(saturate(v.rgb * m), v.a);\n"
+                              "        }\n"
+                              "    return c / float(n * n);\n"
+                              "}\n",
+                              i, i, i);
+                helpers += fn;
+            }
+        }
+        if (!helpers.empty()) {
+            size_t main_pos = s.find("float4 main(");
+            if (main_pos != std::string::npos) s.insert(main_pos, helpers);
+        }
+    }
+
+    // 8. (shaderStorageImageWriteWithoutFormat is enabled on VkDevice; no [[vk::image_format]] needed for glslang 11.8)
+
+    // 9. Inject explicit [[vk::location(N)]] on sparse ATTR0..15 and fixed VOut/O/VSOut varyings
+    for (int r = 0; r < 16; ++r) {
+        const char* types[3] = {"float4", "int4", "uint"};
+        for (const char* ty : types) {
+            char from[64], to[96];
+            std::snprintf(from, sizeof(from), "    %s v%d : ATTR%d;", ty, r, r);
+            std::snprintf(to, sizeof(to), "    [[vk::location(%d)]] %s v%d : ATTR%d;", r, ty, r, r);
+            ReplaceAll(s, from, to);
+        }
+    }
+    struct SemLoc {
+        const char* pat;
+        const char* repl;
+    };
+    static constexpr SemLoc kVaryings[] = {
+        {"    float4 d0 : COLOR0;", "    [[vk::location(0)]] float4 d0 : COLOR0;"},
+        {"    float4 d1 : COLOR1;", "    [[vk::location(1)]] float4 d1 : COLOR1;"},
+        {"    float4 b0 : COLOR2;", "    [[vk::location(2)]] float4 b0 : COLOR2;"},
+        {"    float4 b1 : COLOR3;", "    [[vk::location(3)]] float4 b1 : COLOR3;"},
+        {"    float4 tc0 : TEXCOORD0;", "    [[vk::location(4)]] float4 tc0 : TEXCOORD0;"},
+        {"    float4 tc1 : TEXCOORD1;", "    [[vk::location(5)]] float4 tc1 : TEXCOORD1;"},
+        {"    float4 tc2 : TEXCOORD2;", "    [[vk::location(6)]] float4 tc2 : TEXCOORD2;"},
+        {"    float4 tc3 : TEXCOORD3;", "    [[vk::location(7)]] float4 tc3 : TEXCOORD3;"},
+        {"    float fogamt : TEXCOORD4;", "    [[vk::location(8)]] float fogamt : TEXCOORD4;"},
+        {"    noperspective float4 e : TEXCOORD5;", "    [[vk::location(9)]] noperspective float4 e : TEXCOORD5;"},
+        {"float2 uv : TEXCOORD0;", "[[vk::location(4)]] float2 uv : TEXCOORD0;"},
+    };
+    for (const auto& sl : kVaryings) ReplaceAll(s, sl.pat, sl.repl);
+
+    return s;
+}
+
+EShLanguage ProfileToStage(const char* profile) {
+    if (!profile || !profile[0]) return EShLangFragment;
+    if (profile[0] == 'v' || profile[0] == 'V') return EShLangVertex;
+    if (profile[0] == 'p' || profile[0] == 'P') return EShLangFragment;
+    if (profile[0] == 'g' || profile[0] == 'G') return EShLangGeometry;
+    if (profile[0] == 'c' || profile[0] == 'C') return EShLangCompute;
+    return EShLangFragment;
+}
+
+bool CompileHlslToSpirv(const std::string& raw_src, const char* entry, const char* profile,
+                        std::vector<uint32_t>& out_spv, std::string& out_err) {
+    static std::once_flag init_once;
+    std::call_once(init_once, [] { glslang::InitializeProcess(); });
+
+    std::string src = SanitizeHlslForGlslang(raw_src);
+    EShLanguage stage = ProfileToStage(profile);
+    glslang::TShader shader(stage);
+    const char* strs[1] = {src.c_str()};
+    int lens[1] = {int(src.size())};
+    shader.setStringsWithLengths(strs, lens, 1);
+    shader.setEntryPoint("main");
+    shader.setSourceEntryPoint(entry);
+    shader.setEnvInput(glslang::EShSourceHlsl, stage, glslang::EShClientVulkan, 100);
+    shader.setEnvClient(glslang::EShClientVulkan, glslang::EShTargetVulkan_1_2);
+    shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_5);
+    shader.setHlslIoMapping(true);
+    shader.setAutoMapBindings(true);
+    shader.setAutoMapLocations(true);
+    shader.setShiftBinding(glslang::EResUbo, 0);
+    shader.setShiftBinding(glslang::EResTexture, 4);
+    shader.setShiftBinding(glslang::EResSampler, 12);
+    shader.setShiftBinding(glslang::EResUav, 20);
+    shader.setShiftBinding(glslang::EResImage, 20);
+
+    EShMessages msgs = static_cast<EShMessages>(EShMsgSpvRules | EShMsgVulkanRules | EShMsgReadHlsl |
+                                                EShMsgHlslOffsets | EShMsgHlslLegalization);
+    if (!shader.parse(&GlslangDefaultResources(), 100, false, msgs)) {
+        out_err = shader.getInfoLog();
+        return false;
+    }
+
+    glslang::TProgram program;
+    program.addShader(&shader);
+    if (!program.link(msgs) || !program.mapIO()) {
+        out_err = program.getInfoLog();
+        return false;
+    }
+
+    glslang::TIntermediate* inter = program.getIntermediate(stage);
+    if (!inter) {
+        out_err = "glslang: missing intermediate representation";
+        return false;
+    }
+
+    spv::SpvBuildLogger logger;
+    glslang::SpvOptions opts{};
+    opts.disableOptimizer = true;
+    opts.optimizeSize = false;
+    opts.validate = false;
+    out_spv.clear();
+    glslang::GlslangToSpv(*inter, out_spv, &logger, &opts);
+    if (out_spv.empty()) {
+        out_err = logger.getAllMessages();
+        return false;
+    }
+    return true;
+}
