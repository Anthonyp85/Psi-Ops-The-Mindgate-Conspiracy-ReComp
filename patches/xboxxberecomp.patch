+}  // namespace
+
+void Init() {
+    std::string path = ParsePerfPath();
+    if (path.empty()) return;
+    PerfState& st = State();
+    st.json_path = std::move(path);
+    std::filesystem::path p(st.json_path);
+    std::filesystem::path csv = p;
+    csv.replace_extension(".frames.csv");
+    st.csv_path = csv.string();
+    st.start_tp = Clock::now();
+    st.proc_cpu_start = ProcessCpu100ns();
+#ifdef _WIN32
+    SYSTEM_INFO si{};
+    GetSystemInfo(&si);
+    st.logical_cpus = std::max<uint32_t>(1, si.dwNumberOfProcessors);
+
+    PROCESS_MEMORY_COUNTERS_EX pmc{};
+    pmc.cb = sizeof(pmc);
+    if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc))) {
+        st.host_ws_start = pmc.WorkingSetSize;
+        st.host_ws_peak = pmc.PeakWorkingSetSize;
+        st.host_priv_start = pmc.PrivateUsage;
+        st.host_priv_peak = pmc.PrivateUsage;
+        st.page_faults_start = pmc.PageFaultCount;
+    }
+#else
+    long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    st.logical_cpus = ncpu > 0 ? uint32_t(ncpu) : 1u;
+    LinuxMemInfo lm = QueryLinuxMem();
+    st.host_ws_start = lm.rss;
+    st.host_ws_peak = lm.hwm;
+    st.host_priv_start = lm.priv;
+    st.host_priv_peak = lm.priv;
+    st.page_faults_start = lm.page_faults;
+#endif
+    st.samples.reserve(16384);
+    g_enabled.store(true, std::memory_order_release);
+    LOGR("perf: telemetry enabled -> %s", st.json_path.c_str());
+}
+
+void Shutdown() {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    std::call_once(st.flush_once, [&] { FlushLocked(st); });
+}
+
+void SetPhaseCallback(PhaseCallback cb) { State().phase_cb.store(cb, std::memory_order_release); }
+
+Phase CurrentPhase() {
+    if (PhaseCallback cb = State().phase_cb.load(std::memory_order_acquire)) {
+        return cb().phase;
+    }
+    return Phase::TitleMenu;
+}
+
+void SetShaderCacheEnabled(bool enabled) { State().shader_cache_enabled = enabled; }
+
+void SetAdapterInfo(const char* name, uint32_t vendor_id, uint32_t device_id, bool uma, uint64_t upload_ring_cap) {
+    PerfState& st = State();
+    {
+        std::lock_guard<std::mutex> lock(st.meta_lock);
+        st.adapter_name = name ? name : "";
+        st.adapter_vid = vendor_id;
+        st.adapter_did = device_id;
+        st.adapter_uma = uma;
+    }
+    if (upload_ring_cap > 0) {
+        std::lock_guard<std::mutex> lock(st.samples_lock);
+        st.upload_ring_cap = std::max(st.upload_ring_cap, upload_ring_cap);
+    }
+}
+
+void RecordBootPrewarm(double ms, uint32_t psos) {
+    PerfState& st = State();
+    st.boot_prewarm_ms.store(std::max(0.0, ms), std::memory_order_relaxed);
