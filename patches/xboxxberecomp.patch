+std::string JsonEscape(const std::string& s) {
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (unsigned char c : s) {
+        if (c == '\\') out += "\\\\";
+        else if (c == '"') out += "\\\"";
+        else if (c >= 0x20 && c < 0x7F) out.push_back(char(c));
+    }
+    return out;
+}
+
+double Percentile(std::vector<double>& v, double p) {
+    if (v.empty()) return 0.0;
+    std::sort(v.begin(), v.end());
+    double idx = p * double(v.size() - 1);
+    size_t lo = size_t(std::floor(idx));
+    size_t hi = std::min(v.size() - 1, lo + 1);
+    double frac = idx - double(lo);
+    return v[lo] * (1.0 - frac) + v[hi] * frac;
+}
+
+const char* ClassifySpikeCause(const FrameSample& f) {
+    if (f.compile_ms + f.pso_ms >= 5.0) return "shader_pso_compile";
+    if (f.wait_resource_ms + f.wait_readback_ms + f.wait_fence_ms + f.wait_flush_ms >= 5.0) return "render_wait";
+    if (f.disc_ms + f.z_write_ms + f.z_read_ms >= 5.0) return "io_stall";
+    if (f.fence_wait_ms + f.wait_gpu_frame_ms >= 5.0) return "gpu_wait";
+    if (f.swap_call_ms >= 20.0) return "swap_vsync";
+    if (f.draw_ms + f.present_ms >= 10.0) return "render_cpu";
+    if (f.guest_ms - f.pace_ms >= 10.0) return "guest_cpu";
+    return "pacing_or_other";
+}
