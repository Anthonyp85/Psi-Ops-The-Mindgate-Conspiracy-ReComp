+#include "gpu/backend.h"
+#include "gpu/shaders.h"
+
+namespace gpu {
+
+inline constexpr uint32_t kAotStampMagic = 0x414F5453u;  // "AOTS"
+inline constexpr uint32_t kAotSchemaVersion = 4u;
+
+struct AotStamp {
+    uint32_t magic = kAotStampMagic;
+    uint32_t version = kAotSchemaVersion;
+    uint32_t vendor_id = 0;
+    uint32_t device_id = 0;
+    uint32_t subsys_id = 0;
+    uint32_t revision = 0;
+    uint32_t shader_count = 0;
+    uint32_t pso_count = 0;
+    uint64_t content_sig = 0;
+};
+
+struct AotShaderJob {
+    uint64_t blob_hash = 0;
+    uint64_t src_key = 0;  // 0 if blob-only (e.g., utility / GS shader)
+    std::string hlsl;
+    std::string entry;
+    std::string profile;
+    bool is_pixel = false;
+};
+
+struct AotPsoSeed {
+    uint64_t vs_hash = 0;
+    uint64_t ps_hash = 0;
+    uint32_t regs = 0;
+    uint32_t elements[16] = {};
+    uint32_t buf_count = 1;
+    uint16_t strides[16] = {};
+    uint32_t topo = 2;   // Topology::Triangles
+    uint32_t strip = 0;  // 0 = list, 1 = strip
+    uint32_t has_rt = 1;
+    uint32_t has_ds = 1;
+    uint32_t blend = 0;
+    uint32_t src = 0;
+    uint32_t dst = 0;
+    uint32_t op = 0;
+    uint32_t wmask = 15;
+    uint32_t zen = 0;
+    uint32_t zwrite = 0;
+    uint32_t zfunc = 0;
+    uint32_t sten = 0;
+    uint32_t sfunc = 0;
+    uint32_t smask = 0;
+    uint32_t swmask = 0;
+    uint32_t sfail = 0;
+    uint32_t szfail = 0;
+    uint32_t spass = 0;
+    uint32_t cull = 0;
+    uint32_t ccw = 0;
+    uint32_t fill = 0x1B02;  // D3DFILL_SOLID
+    int32_t zbias = 0;
+    float zslope = 0.0f;
+    uint32_t sprite = 0;
+};
+
+struct AotPlan {
+    uint32_t scanned_vs_programs = 0;
+    uint32_t scanned_ps_defs = 0;
+    uint64_t content_sig = 0;
+    std::vector<AotShaderJob> shaders;
+    std::vector<AotPsoSeed> psos;
+};
+
+// Exact shader blob hash matching D3D12Backend::Compile and VulkanBackend::Compile.
+uint64_t ComputeShaderBlobHash(const std::string& src, const char* entry, const char* profile);
+
+// Computes deterministic content signature for AOT stamp validation (XBE SHA-1 + schema version + backend tag).
+uint64_t ComputeAotContentSignature(const char* backend_tag);
+
+// Disk cache path & stamp helpers shared by D3D12, Vulkan, and Pre-Game Launcher.
+std::filesystem::path AotCacheDir();
+std::filesystem::path AotRebuildFlagPath();
+std::filesystem::path AotStampPath(const char* backend_prefix, uint32_t vendor_id, uint32_t device_id);
+bool IsAotRebuildFlagSet();
+bool ConsumeAotRebuildFlag();
+void ClearDiskCachesAndScheduleRebuild();
+bool LoadAotStamp(const std::filesystem::path& path, uint32_t vendor_id, uint32_t device_id, uint32_t subsys_id,
+                  uint32_t revision, uint64_t expected_sig, AotStamp& out);
+bool WriteAotStamp(const std::filesystem::path& path, const AotStamp& stamp);
+
+// Inspects on-disk shader/PSO cache counts and byte size when no GPU backend is active yet (Pre-Game Launcher).
+CacheStats InspectDiskCacheStats(bool is_vulkan);
+
+// Builds the full cold-start AOT shader + PSO compilation plan from mounted read-only XBE/XISO + numeric seed table.
+// Extra backend utility shaders (blit/clear/depth) can be appended by the caller before deduplication/compilation.
+AotPlan BuildAotPrecompilePlan(const char* backend_tag);
+
+// Renders a sleek centered Mindgate boot progress card inside an active ImGui frame.
+void DrawPrecompileProgressUi(const char* stage_label, uint32_t done, uint32_t total, uint32_t shaders_done,
+                              uint32_t shaders_total, uint32_t psos_done, uint32_t psos_total);
+
+}  // namespace gpu
