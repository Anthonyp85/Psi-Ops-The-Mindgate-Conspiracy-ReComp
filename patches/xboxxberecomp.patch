+
+uint64_t ComputeShaderBlobHash(const std::string& src, const char* entry, const char* profile) {
+    uint64_t profile_seed = Hash(profile, std::strlen(profile));
+    uint64_t entry_seed = Hash(entry, std::strlen(entry), profile_seed);
+    return Hash(src.data(), src.size(), entry_seed);
+}
+
+uint64_t ComputeAotContentSignature(const char* backend_tag) {
+    uint64_t h = Hash(&kAotSchemaVersion, sizeof(kAotSchemaVersion));
+    const char* sha = kImageSha1;
+    h = Hash(sha, std::strlen(sha), h);
+    if (backend_tag) h = Hash(backend_tag, std::strlen(backend_tag), h);
+    uint32_t rev = g_reversed_depth ? 1u : 0u;
+    h = Hash(&rev, sizeof(rev), h);
+    if (const kernel::Disc* disc = kernel::MountedDisc()) {
+        uint64_t dt = disc->Time();
+        h = Hash(&dt, sizeof(dt), h);
+    }
+    return h;
+}
+
+fs::path AotCacheDir() { return app::ExeDir() / "cache"; }
+
+fs::path AotRebuildFlagPath() { return AotCacheDir() / "aot_rebuild.flag"; }
+
+fs::path AotStampPath(const char* backend_prefix, uint32_t vendor_id, uint32_t device_id) {
+    char name[64];
+    std::snprintf(name, sizeof(name), "%s_aot_stamp_%04X_%04X.bin", backend_prefix ? backend_prefix : "gpu", vendor_id,
+                  device_id);
+    return AotCacheDir() / name;
+}
+
+bool IsAotRebuildFlagSet() {
+    std::error_code ec;
+    return fs::exists(AotRebuildFlagPath(), ec);
+}
+
+bool ConsumeAotRebuildFlag() {
+    std::error_code ec;
+    fs::path p = AotRebuildFlagPath();
+    if (!fs::exists(p, ec)) return false;
+    fs::remove(p, ec);
+    return true;
+}
+
+void ClearDiskCachesAndScheduleRebuild() {
+    fs::path dir = AotCacheDir();
+    std::error_code ec;
+    fs::create_directories(dir, ec);
+    for (auto& e : fs::directory_iterator(dir, ec)) {
+        std::string fn = e.path().filename().string();
+        if (fn == "shaders.bin" || fn == "shaders.bin.tmp" || fn == "vk_shaders.bin" || fn == "vk_shaders.bin.tmp" ||
+            fn.rfind("psos_", 0) == 0 || fn.rfind("pso_meta_", 0) == 0 || fn.rfind("d3d12_aot_stamp_", 0) == 0 ||
+            fn.rfind("vk_psos_", 0) == 0 || fn.rfind("vk_pso_meta_", 0) == 0 || fn.rfind("vk_aot_stamp_", 0) == 0) {
+            fs::remove(e.path(), ec);
+        }
+    }
+    if (FILE* f = OpenWrite(AotRebuildFlagPath())) {
+        const char msg[] = "rebuild=1\n";
+        std::fwrite(msg, 1, sizeof(msg) - 1, f);
+        std::fclose(f);
+    }
+    LOGR("gpu: scheduled full AOT shader/PSO cache rebuild on next launch");
+}
+
+bool LoadAotStamp(const fs::path& path, uint32_t vendor_id, uint32_t device_id, uint32_t subsys_id, uint32_t revision,
+                  uint64_t expected_sig, AotStamp& out) {
+    FILE* f = OpenRead(path);
+    if (!f) return false;
+    AotStamp s{};
+    bool ok = std::fread(&s, sizeof(s), 1, f) == 1;
+    std::fclose(f);
+    if (!ok) return false;
+    if (s.magic != kAotStampMagic || s.version != kAotSchemaVersion) return false;
+    if (s.vendor_id != vendor_id || s.device_id != device_id || s.subsys_id != subsys_id || s.revision != revision) {
+        return false;
+    }
+    if (s.content_sig != expected_sig) return false;
+    out = s;
+    return true;
+}
+
+bool WriteAotStamp(const fs::path& path, const AotStamp& stamp) {
+    std::error_code ec;
+    fs::create_directories(path.parent_path(), ec);
+    fs::path tmp = path;
+    tmp += ".tmp";
+    FILE* f = OpenWrite(tmp);
+    if (!f) return false;
+    bool ok = std::fwrite(&stamp, sizeof(stamp), 1, f) == 1;
+    std::fflush(f);
+    std::fclose(f);
+    if (!ok) {
+        fs::remove(tmp, ec);
+        return false;
+    }
+    fs::rename(tmp, path, ec);
+    if (ec) {
+        fs::remove(path, ec);
+        ec.clear();
+        fs::rename(tmp, path, ec);
+    }
+    return !ec;
+}
+
+CacheStats InspectDiskCacheStats(bool is_vulkan) {
+    CacheStats cs{};
+    cs.enabled = true;
+    cs.rebuild_pending = IsAotRebuildFlagSet();
+
+    fs::path dir = AotCacheDir();
+    std::error_code ec;
+    if (!fs::is_directory(dir, ec)) return cs;
+
+    const fs::path sh_path = dir / (is_vulkan ? "vk_shaders.bin" : "shaders.bin");
+    if (auto sz = fs::file_size(sh_path, ec); !ec) {
+        cs.disk_bytes += sz;
+        if (FILE* f = OpenRead(sh_path)) {
+            if (is_vulkan) {
+                DiskVkShaderHeader hdr{};
+                if (std::fread(&hdr, sizeof(hdr), 1, f) == 1 && std::memcmp(hdr.magic, "VKSC", 4) == 0 &&
+                    hdr.version == 1 && hdr.abi == 1) {
+                    while (true) {
+                        uint64_t h = 0;
+                        uint32_t wc = 0;
+                        if (std::fread(&h, sizeof(h), 1, f) != 1 || std::fread(&wc, sizeof(wc), 1, f) != 1) break;
+                        if (wc == 0 || wc > (4u << 20)) break;
+                        if (std::fseek(f, long(wc * sizeof(uint32_t)), SEEK_CUR) != 0) break;
+                        cs.shaders++;
+                    }
+                }
+            } else {
+                DiskD3D12ShaderHeader hdr{};
+                if (std::fread(&hdr, sizeof(hdr), 1, f) == 1 && std::memcmp(hdr.magic, "XBSC", 4) == 0 &&
+                    hdr.version == 2) {
+                    while (true) {
+                        uint64_t h = 0;
+                        uint32_t len = 0;
+                        if (std::fread(&h, sizeof(h), 1, f) != 1 || std::fread(&len, sizeof(len), 1, f) != 1) break;
+                        if (len == 0 || len > (16u << 20)) break;
+                        if (std::fseek(f, long(len), SEEK_CUR) != 0) break;
+                        cs.shaders++;
+                    }
+                }
+            }
+            std::fclose(f);
+        }
+    }
+
+    ec.clear();
+    const char* pso_prefix = is_vulkan ? "vk_psos_" : "psos_";
+    const char* meta_prefix = is_vulkan ? "vk_pso_meta_" : "pso_meta_";
+    const char* stamp_prefix = is_vulkan ? "vk_aot_stamp_" : "d3d12_aot_stamp_";
+
+    for (auto& e : fs::directory_iterator(dir, ec)) {
+        if (!e.is_regular_file(ec)) continue;
+        std::string fn = e.path().filename().string();
+        std::error_code sz_ec;
+        uint64_t fsz = e.file_size(sz_ec);
+        if (sz_ec) continue;
+
+        if (fn.rfind(pso_prefix, 0) == 0) {
+            cs.disk_bytes += fsz;
+        } else if (fn.rfind(meta_prefix, 0) == 0) {
+            cs.disk_bytes += fsz;
+            if (FILE* f = OpenRead(e.path())) {
+                if (is_vulkan) {
+                    DiskVkMetaHeader hdr{};
+                    if (std::fread(&hdr, sizeof(hdr), 1, f) == 1 && hdr.magic == 0x50534F4Du && hdr.version == 1u) {
+                        cs.psos = std::max(cs.psos, hdr.pso_count);
+                    }
+                } else {
+                    DiskD3D12MetaHeader hdr{};
+                    if (std::fread(&hdr, sizeof(hdr), 1, f) == 1 && hdr.magic == 0x50534F4Du && hdr.version == 1u) {
+                        cs.psos = std::max(cs.psos, hdr.pso_count);
+                    }
+                }
+                std::fclose(f);
+            }
+        } else if (fn.rfind(stamp_prefix, 0) == 0) {
+            cs.disk_bytes += fsz;
+            if (FILE* f = OpenRead(e.path())) {
+                AotStamp s{};
+                if (std::fread(&s, sizeof(s), 1, f) == 1 && s.magic == kAotStampMagic &&
+                    s.version == kAotSchemaVersion) {
+                    cs.aot_ready = true;
+                    cs.psos = std::max(cs.psos, s.pso_count);
+                    cs.shaders = std::max(cs.shaders, s.shader_count);
+                }
+                std::fclose(f);
+            }
+        }
+    }
+
+    return cs;
+}
+
+AotPlan BuildAotPrecompilePlan(const char* backend_tag) {
+    PlanBuilder b{};
+    b.is_vulkan = (backend_tag && std::strcmp(backend_tag, "vulkan") == 0);
+    b.plan.content_sig = ComputeAotContentSignature(backend_tag);
+    b.ScanMountedSources();
+    b.EmitScannedProgrammableShaders();
+    b.SeedFixedFunctionAndBuildPsos();
+    LOGR("aot: scanned %u .xbox archives (%u unique .vsh, %u unique .psh) -> %zu shader jobs (%zu unique blobs), %zu PSO seeds",
+         b.scanned_archives, b.plan.scanned_vs_programs, b.plan.scanned_ps_defs, b.plan.shaders.size(),
+         b.seen_blob_hashes.size(), b.plan.psos.size());
+    return std::move(b.plan);
+}
+
+void DrawPrecompileProgressUi(const char* stage_label, uint32_t done, uint32_t total, uint32_t shaders_done,
+                              uint32_t shaders_total, uint32_t psos_done, uint32_t psos_total) {
+    const ImGuiIO& io = ImGui::GetIO();
+    const float w = std::clamp(io.DisplaySize.x * 0.46f, 440.0f, 640.0f);
+    const float h = 176.0f;
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                            ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(ImVec2(w, h), ImGuiCond_Always);
+
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 10.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(24.0f, 20.0f));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.5f);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.06f, 0.085f, 0.125f, 0.96f));
+    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.22f, 0.78f, 0.94f, 0.85f));
+    ImGui::PushStyleColor(ImGuiCol_PlotHistogram, ImVec4(0.18f, 0.78f, 0.95f, 1.0f));
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.11f, 0.15f, 0.21f, 1.0f));
+
+    constexpr ImGuiWindowFlags kFlags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove |
+                                        ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings |
+                                        ImGuiWindowFlags_NoInputs;
+    if (ImGui::Begin("##AotShaderPrecompileCard", nullptr, kFlags)) {
+        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.32f, 0.86f, 0.96f, 1.0f));
+        ImGui::TextUnformatted("PSI-OPS: THE MINDGATE CONSPIRACY");
+        ImGui::PopStyleColor();
+        ImGui::Spacing();
+
+        const uint32_t safe_total = std::max(total, 1u);
+        const uint32_t clamped_done = std::min(done, safe_total);
+        const float frac = float(clamped_done) / float(safe_total);
+
+        ImGui::Text("Pre-compiling Shaders & Pipelines (%u / %u)...", clamped_done, safe_total);
+        if (stage_label && *stage_label) {
+            ImGui::TextDisabled("%s", stage_label);
+        }
+        ImGui::Spacing();
+
+        char pct[32];
+        std::snprintf(pct, sizeof(pct), "%u%%", uint32_t(frac * 100.0f + 0.5f));
+        ImGui::ProgressBar(frac, ImVec2(-1.0f, 22.0f), pct);
+        ImGui::Spacing();
+        ImGui::TextDisabled("Shaders: %u / %u   |   Pipelines: %u / %u   |   Cached for instant future launches",
+                            shaders_done, shaders_total, psos_done, psos_total);
+    }
+    ImGui::End();
+
+    ImGui::PopStyleColor(4);
+    ImGui::PopStyleVar(3);
+}
+
