+    out.valid = true;
+    out.code = "OK";
+    if (out.sha1 == kImageSha1) out.revision = "Verified Retail";
+    else out.revision = "Verified Release";
+
+    if (out_disc) *out_disc = std::move(disc);
+    if (out_xbe) *out_xbe = std::move(xbe_bytes);
+    return true;
+}
