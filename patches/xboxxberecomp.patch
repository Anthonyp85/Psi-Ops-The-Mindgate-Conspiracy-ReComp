+    aot_compiled_shaders_ = compiled_ok;
+    aot_built_psos_ = built_psos;
+    aot_ready_ = true;
+    aot_ms_ = PerfMs(t0);
+
+    AotStamp new_stamp{};
+    new_stamp.vendor_id = adapter_desc_.VendorId;
+    new_stamp.device_id = adapter_desc_.DeviceId;
+    new_stamp.subsys_id = adapter_desc_.SubSysId;
+    new_stamp.revision = adapter_desc_.Revision;
+    new_stamp.shader_count = uint32_t(blobs_.size());
