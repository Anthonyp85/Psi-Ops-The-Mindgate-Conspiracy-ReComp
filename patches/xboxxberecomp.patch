+bool D3D12Backend::AllocTexSlab(uint64_t size, uint64_t align, uint32_t& out_slab, uint64_t& out_off) {
+    if (size == 0 || size > kTexSlabMaxAlloc) return false;
+    align = std::max<uint64_t>(align, D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT);
+    for (uint32_t si = 0; si < tex_slabs_.size(); ++si) {
+        auto& fl = tex_slabs_[si].free_list;
+        for (size_t i = 0; i < fl.size(); ++i) {
+            uint64_t aligned = (fl[i].off + align - 1) & ~(align - 1);
+            uint64_t pad = aligned - fl[i].off;
+            if (fl[i].size < pad + size) continue;
+            uint64_t tail_off = aligned + size;
+            uint64_t tail_size = (fl[i].off + fl[i].size) - tail_off;
+            if (pad > 0 && tail_size > 0) {
+                fl[i].size = pad;
+                fl.insert(fl.begin() + ptrdiff_t(i + 1), SlabFree{tail_off, tail_size});
+            } else if (pad > 0) {
+                fl[i].size = pad;
+            } else if (tail_size > 0) {
+                fl[i].off = tail_off;
+                fl[i].size = tail_size;
+            } else {
+                fl.erase(fl.begin() + ptrdiff_t(i));
+            }
+            out_slab = si;
+            out_off = aligned;
+            tex_slab_allocs_++;
+            perf::RecordSlabStats(uint32_t(tex_slabs_.size()), uint64_t(tex_slabs_.size()) * kTexSlabSize, tex_slab_allocs_);
+            return true;
+        }
+    }
+    D3D12_HEAP_DESC hd{};
+    hd.SizeInBytes = kTexSlabSize;
+    hd.Properties = D3D12_HEAP_PROPERTIES{D3D12_HEAP_TYPE_DEFAULT};
+    hd.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    hd.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES;
+    ComPtr<ID3D12Heap> heap;
+    if (FAILED(dev_->CreateHeap(&hd, IID_PPV_ARGS(&heap))) || !heap) return false;
+    uint32_t si = uint32_t(tex_slabs_.size());
+    TexSlab slab;
+    slab.heap = std::move(heap);
+    if (kTexSlabSize > size) slab.free_list.push_back(SlabFree{size, kTexSlabSize - size});
+    tex_slabs_.push_back(std::move(slab));
+    out_slab = si;
+    out_off = 0;
+    tex_slab_allocs_++;
+    perf::RecordSlabStats(uint32_t(tex_slabs_.size()), uint64_t(tex_slabs_.size()) * kTexSlabSize, tex_slab_allocs_);
+    return true;
+}
+
+void D3D12Backend::FreeSlabRange(uint32_t slab, uint64_t off, uint64_t size) {
+    if (slab >= tex_slabs_.size() || size == 0) return;
+    auto& fl = tex_slabs_[slab].free_list;
+    auto it = std::lower_bound(fl.begin(), fl.end(), off,
+                               [](const SlabFree& a, uint64_t b) { return a.off < b; });
+    it = fl.insert(it, SlabFree{off, size});
+    if (it + 1 != fl.end() && it->off + it->size == (it + 1)->off) {
+        it->size += (it + 1)->size;
+        fl.erase(it + 1);
+    }
+    if (it != fl.begin()) {
+        auto prev = it - 1;
+        if (prev->off + prev->size == it->off) {
+            prev->size += it->size;
+            fl.erase(it);
+        }
+    }
+}
+
+void D3D12Backend::FreeSlabGarbage(Frame& f) {
+    for (const auto& r : f.slab_garbage) FreeSlabRange(r.slab, r.off, r.size);
+    f.slab_garbage.clear();
+}
+
+void D3D12Backend::RetireTex(Tex& tx) {
+    if (tx.res) CurrentFrame().garbage.push_back(std::move(tx.res));
+    if (tx.slab_id != UINT32_MAX) {
+        CurrentFrame().slab_garbage.push_back(SlabRetire{tx.slab_id, tx.slab_off, tx.slab_size});
+        tx.slab_id = UINT32_MAX;
+        tx.slab_off = 0;
+        tx.slab_size = 0;
+    }
+}
+
+void D3D12Backend::StartSaveThread() {
+    std::lock_guard<std::mutex> lock(save_mtx_);
+    if (save_thread_.joinable()) return;
+    save_stop_ = false;
+    save_thread_ = std::thread([this] { SaveWorkerLoop(); });
+}
+
+void D3D12Backend::DrainSaveThread() {
+    std::unique_lock<std::mutex> lock(save_mtx_);
+    save_done_cv_.wait(lock, [this] { return !save_has_pending_ && !save_writing_; });
+}
+
+void D3D12Backend::StopSaveThread() {
+    {
+        std::lock_guard<std::mutex> lock(save_mtx_);
+        save_stop_ = true;
+    }
+    save_cv_.notify_all();
+    if (save_thread_.joinable()) save_thread_.join();
+}
+
+void D3D12Backend::SaveWorkerLoop() {
+    for (;;) {
+        CacheSaveJob job{};
+        {
+            std::unique_lock<std::mutex> lock(save_mtx_);
+            save_cv_.wait(lock, [this] { return save_has_pending_ || save_stop_; });
+            if (!save_has_pending_) {
+                if (save_stop_) break;
+                continue;
+            }
+            job = std::move(save_pending_);
+            save_pending_ = CacheSaveJob{};
+            save_has_pending_ = false;
+            save_writing_ = true;
+        }
+        std::error_code ec;
+        std::filesystem::create_directories(job.dir, ec);
+        if (job.write_shaders) WriteAtomicFile(job.dir / "shaders.bin", job.shaders_bytes);
+        if (job.write_pso) WriteAtomicFile(job.pso_path, job.pso_bytes);
+        if (job.write_meta) WriteAtomicFile(job.meta_path, job.meta_bytes);
+        if (job.write_shaders || job.write_pso || job.write_meta) {
+            perf::RecordCacheWrite(false);
+            uint64_t bytes = 0;
+            std::error_code sz_ec;
+            auto ssz = std::filesystem::file_size(job.dir / "shaders.bin", sz_ec);
+            if (!sz_ec) bytes += ssz;
+            sz_ec.clear();
+            auto psz = std::filesystem::file_size(PsoCachePath(), sz_ec);
+            if (!sz_ec) bytes += psz;
+            sz_ec.clear();
+            auto msz = std::filesystem::file_size(PsoMetaPath(), sz_ec);
+            if (!sz_ec) bytes += msz;
+            sz_ec.clear();
+            auto asz = std::filesystem::file_size(
+                AotStampPath("d3d12", adapter_desc_.VendorId, adapter_desc_.DeviceId), sz_ec);
+            if (!sz_ec) bytes += asz;
+            g_cache_bytes_stat.store(bytes, std::memory_order_relaxed);
+        }
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_writing_ = false;
+        }
+        save_done_cv_.notify_all();
+    }
+}
+
+void D3D12Backend::PublishCacheStats() {
+    g_cache_enabled_stat.store(cache_enabled_, std::memory_order_relaxed);
+    g_cache_shaders_stat.store(uint32_t(shader_cache_entries_.size()), std::memory_order_relaxed);
+    g_cache_psos_stat.store(uint32_t(psos_.size() + blit_psos_.size()), std::memory_order_relaxed);
+    g_cache_aot_ready_stat.store(aot_ready_, std::memory_order_relaxed);
+    g_cache_aot_shaders_stat.store(uint32_t(aot_compiled_shaders_), std::memory_order_relaxed);
+    g_cache_aot_psos_stat.store(uint32_t(aot_built_psos_), std::memory_order_relaxed);
+    g_cache_aot_ms_stat.store(aot_ms_, std::memory_order_relaxed);
+    uint64_t bytes = 0;
+    if (cache_enabled_ && !cache_dir_.empty()) {
+        std::error_code ec;
+        auto ssz = std::filesystem::file_size(cache_dir_ / "shaders.bin", ec);
+        if (!ec) bytes += ssz;
+        ec.clear();
+        auto psz = std::filesystem::file_size(PsoCachePath(), ec);
+        if (!ec) bytes += psz;
+        ec.clear();
+        auto msz = std::filesystem::file_size(PsoMetaPath(), ec);
+        if (!ec) bytes += msz;
+        ec.clear();
+        auto asz = std::filesystem::file_size(
+            AotStampPath("d3d12", adapter_desc_.VendorId, adapter_desc_.DeviceId), ec);
+        if (!ec) bytes += asz;
+    }
+    g_cache_bytes_stat.store(bytes, std::memory_order_relaxed);
+}
+
+void D3D12Backend::ResetCaches() {
+    Flush();
+    DrainSaveThread();
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        shader_cache_entries_.clear();
+        disk_blob_pending_.clear();
+        known_src_keys_.clear();
+        known_pso_keys_.clear();
+        src_meta_entries_.clear();
+        pso_meta_entries_.clear();
+        shaders_dirty_ = false;
+        pso_dirty_ = false;
+        meta_dirty_ = false;
+        aot_ready_ = false;
+        pso_lib_.Reset();
+        pso_init_blob_.clear();
+        if (!cache_dir_.empty()) {
+            std::error_code ec;
+            std::filesystem::remove(cache_dir_ / "shaders.bin", ec);
+            std::filesystem::remove(cache_dir_ / "shaders.bin.tmp", ec);
+            std::filesystem::remove(cache_dir_ / "psos.bin", ec);
+            std::filesystem::remove(cache_dir_ / "psos.bin.tmp", ec);
+            for (auto& e : std::filesystem::directory_iterator(cache_dir_, ec)) {
+                std::string fn = e.path().filename().string();
+                if (fn.rfind("psos_", 0) == 0 || fn.rfind("pso_meta_", 0) == 0 ||
+                    fn.rfind("d3d12_aot_stamp_", 0) == 0) {
+                    std::filesystem::remove(e.path(), ec);
+                }
+            }
+        }
+        if (cache_enabled_ && dev1_) {
+            if (FAILED(dev1_->CreatePipelineLibrary(nullptr, 0, IID_PPV_ARGS(&pso_lib_)))) pso_lib_.Reset();
+        }
+    }
+    PublishCacheStats();
+    LOGR("d3d12: shader/PSO disk cache cleared by user");
+}
+
+void D3D12Backend::InitCaches() {
+    cache_enabled_ = !NoShaderCacheFlag();
+    perf::SetShaderCacheEnabled(cache_enabled_);
+    if (!cache_enabled_) {
+        LOGR("d3d12: shader/PSO disk cache disabled (--no-shader-cache)");
+        return;
+    }
+    cache_dir_ = app::ExeDir() / "cache";
+    if (ConsumeAotRebuildFlag()) {
+        std::error_code ec;
+        std::filesystem::remove(cache_dir_ / "shaders.bin", ec);
+        std::filesystem::remove(cache_dir_ / "shaders.bin.tmp", ec);
+        for (auto& e : std::filesystem::directory_iterator(cache_dir_, ec)) {
+            std::string fn = e.path().filename().string();
+            if (fn.rfind("psos_", 0) == 0 || fn.rfind("pso_meta_", 0) == 0 ||
+                fn.rfind("d3d12_aot_stamp_", 0) == 0) {
+                std::filesystem::remove(e.path(), ec);
+            }
+        }
+        LOGR("d3d12: scheduled AOT shader cache rebuild triggered");
+    }
+
+    // 1. Load DXBC shader blob cache (v2: DrawConstants includes rtshift_x/y + jitter)
+    size_t loaded_shaders = 0;
+    if (FILE* sf = _wfopen((cache_dir_ / "shaders.bin").c_str(), L"rb")) {
+        ShaderCacheHeader hdr{};
+        if (std::fread(&hdr, sizeof(hdr), 1, sf) == 1 && std::memcmp(hdr.magic, "XBSC", 4) == 0 && hdr.version == 2 &&
+            hdr.ptr_size == sizeof(void*)) {
+            while (true) {
+                uint64_t hash = 0;
+                uint32_t len = 0;
+                if (std::fread(&hash, sizeof(hash), 1, sf) != 1 || std::fread(&len, sizeof(len), 1, sf) != 1) break;
+                if (len == 0 || len > (16u << 20)) break;
+                std::vector<uint8_t> data(len);
+                if (std::fread(data.data(), 1, len, sf) != len) break;
+                ComPtr<ID3DBlob> code;
+                if (SUCCEEDED(D3DCreateBlob(len, &code))) {
+                    std::memcpy(code->GetBufferPointer(), data.data(), len);
+                    blobs_[hash] = code;
+                    disk_blob_pending_.insert(hash);
+                    shader_cache_entries_.emplace_back(hash, std::move(data));
+                    loaded_shaders++;
+                }
+            }
+        }
+        std::fclose(sf);
+    }
+
+    // 2. Load per-adapter D3D12 Pipeline Library cache (v2)
+    bool loaded_pso_lib = false;
+    if (SUCCEEDED(dev_.As(&dev1_)) && dev1_) {
+        if (FILE* pf = _wfopen(PsoCachePath().c_str(), L"rb")) {
+            PsoCacheHeader hdr{};
+            if (std::fread(&hdr, sizeof(hdr), 1, pf) == 1 && std::memcmp(hdr.magic, "XBPL", 4) == 0 &&
+                hdr.version == 2 && hdr.vendor_id == adapter_desc_.VendorId &&
+                hdr.device_id == adapter_desc_.DeviceId && hdr.subsys_id == adapter_desc_.SubSysId &&
+                hdr.revision == adapter_desc_.Revision && hdr.blob_size > 0 && hdr.blob_size < (256u << 20)) {
+                pso_init_blob_.resize(hdr.blob_size);
+                if (std::fread(pso_init_blob_.data(), 1, hdr.blob_size, pf) == hdr.blob_size) {
+                    HRESULT hr = dev1_->CreatePipelineLibrary(pso_init_blob_.data(), pso_init_blob_.size(),
+                                                              IID_PPV_ARGS(&pso_lib_));
+                    if (SUCCEEDED(hr)) {
+                        loaded_pso_lib = true;
+                    } else {
+                        LOGR("d3d12: discarding stale PSO cache (hr=0x%08lX); rebuilding cleanly", (unsigned long)hr);
+                        pso_init_blob_.clear();
+                    }
+                } else {
+                    pso_init_blob_.clear();
+                }
+            }
+            std::fclose(pf);
+        }
+        if (!pso_lib_) {
+            HRESULT hr = dev1_->CreatePipelineLibrary(nullptr, 0, IID_PPV_ARGS(&pso_lib_));
+            if (FAILED(hr)) {
+                LOGR("d3d12: CreatePipelineLibrary unavailable (hr=0x%08lX)", (unsigned long)hr);
+                pso_lib_.Reset();
+            }
+        }
+    }
+    LOGR("d3d12: cache initialized (shaders_loaded=%zu, pso_library_loaded=%s, pso_file=%s)", loaded_shaders,
+         loaded_pso_lib ? "true" : "false", PsoCachePath().filename().string().c_str());
+    PrewarmCachedPsos();
+    PublishCacheStats();
+}
+
+void D3D12Backend::SaveCaches(bool sync) {
+    if (!cache_enabled_) return;
+    CacheSaveJob job{};
+    job.dir = cache_dir_;
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        if (!shaders_dirty_ && !pso_dirty_ && !meta_dirty_) {
+            if (sync) {
+                // fall through to drain any in-flight background write
+            } else {
+                return;
+            }
+        } else {
+            cache_dirty_frame_ = presents_;
+            if (shaders_dirty_) {
+                ShaderCacheHeader hdr{{'X', 'B', 'S', 'C'}, 2u, uint32_t(sizeof(void*)), 0u};
+                size_t total = sizeof(hdr);
+                for (const auto& [h, data] : shader_cache_entries_) total += sizeof(uint64_t) + sizeof(uint32_t) + data.size();
+                job.shaders_bytes.resize(total);
+                uint8_t* p = job.shaders_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                for (const auto& [h, data] : shader_cache_entries_) {
+                    uint32_t len = uint32_t(data.size());
+                    std::memcpy(p, &h, sizeof(h));
+                    p += sizeof(h);
+                    std::memcpy(p, &len, sizeof(len));
+                    p += sizeof(len);
+                    std::memcpy(p, data.data(), len);
+                    p += len;
+                }
+                job.write_shaders = true;
+                shaders_dirty_ = false;
+            }
+            if (pso_dirty_) {
+                if (pso_lib_) {
+                    SIZE_T sz = pso_lib_->GetSerializedSize();
+                    if (sz > 0 && sz < (256u << 20)) {
+                        job.pso_bytes.resize(sizeof(PsoCacheHeader) + sz);
+                        HRESULT hr = pso_lib_->Serialize(job.pso_bytes.data() + sizeof(PsoCacheHeader), sz);
+                        if (SUCCEEDED(hr)) {
+                            PsoCacheHeader hdr{{'X', 'B', 'P', 'L'},
+                                               2u,
+                                               adapter_desc_.VendorId,
+                                               adapter_desc_.DeviceId,
+                                               adapter_desc_.SubSysId,
+                                               adapter_desc_.Revision,
+                                               uint32_t(sz),
+                                               0u};
+                            std::memcpy(job.pso_bytes.data(), &hdr, sizeof(hdr));
+                            job.pso_path = PsoCachePath();
+                            job.write_pso = true;
+                        } else {
+                            LOG_FIRST(1, "d3d12: pipeline library Serialize failed (hr=0x%08lX); disabling PSO save",
+                                      (unsigned long)hr);
+                            job.pso_bytes.clear();
+                            if (hr == E_NOTIMPL || hr == DXGI_ERROR_UNSUPPORTED) pso_lib_.Reset();
+                        }
+                    } else {
+                        LOG_FIRST(1, "d3d12: pipeline library serialization empty/oversized (sz=%zu); skipping save",
+                                  size_t(sz));
+                    }
+                }
+                pso_dirty_ = false;
+            }
+            if (meta_dirty_) {
+                PsoMetaHeader hdr{};
+                hdr.magic = kPsoMetaMagic;
+                hdr.version = kPsoMetaVersion;
+                hdr.sizeof_pso_key = uint32_t(sizeof(PsoKey));
+                hdr.vendor_id = adapter_desc_.VendorId;
+                hdr.device_id = adapter_desc_.DeviceId;
+                hdr.subsys_id = adapter_desc_.SubSysId;
+                hdr.revision = adapter_desc_.Revision;
+                hdr.src_count = uint32_t(src_meta_entries_.size());
+                hdr.pso_count = uint32_t(pso_meta_entries_.size());
+                size_t src_bytes = src_meta_entries_.size() * sizeof(SrcMetaEntry);
+                size_t pso_bytes = pso_meta_entries_.size() * sizeof(PsoKey);
+                job.meta_bytes.resize(sizeof(hdr) + src_bytes + pso_bytes);
+                uint8_t* p = job.meta_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                if (src_bytes) {
+                    std::memcpy(p, src_meta_entries_.data(), src_bytes);
+                    p += src_bytes;
+                }
+                if (pso_bytes) std::memcpy(p, pso_meta_entries_.data(), pso_bytes);
+                job.meta_path = PsoMetaPath();
+                job.write_meta = true;
+                meta_dirty_ = false;
+            }
+        }
+    }
+    if (job.write_shaders || job.write_pso || job.write_meta) {
+        StartSaveThread();
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_pending_.dir = job.dir;
+            if (job.write_shaders) {
+                save_pending_.write_shaders = true;
+                save_pending_.shaders_bytes = std::move(job.shaders_bytes);
+            }
+            if (job.write_pso) {
+                save_pending_.write_pso = true;
+                save_pending_.pso_path = std::move(job.pso_path);
+                save_pending_.pso_bytes = std::move(job.pso_bytes);
+            }
+            if (job.write_meta) {
+                save_pending_.write_meta = true;
+                save_pending_.meta_path = std::move(job.meta_path);
+                save_pending_.meta_bytes = std::move(job.meta_bytes);
+            }
+            save_has_pending_ = true;
+        }
+        save_cv_.notify_one();
+    }
+    if (sync) DrainSaveThread();
+}
+
+void D3D12Backend::FlushCaches() {
+    if (boot_init_complete_ && !session_summary_logged_) {
+        session_summary_logged_ = true;
+        LOGR("d3d12: session shader summary (aot_compiled=%zu, aot_psos=%zu, runtime_compiles=%zu, runtime_psos=%zu)",
+             aot_compiled_shaders_, aot_built_psos_, runtime_shader_compiles_, runtime_pso_creates_);
+    }
+    SaveCaches(true);
+    PublishCacheStats();
+}
