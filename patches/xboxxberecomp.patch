+                 "    \"cold_z_detected\": %s, \"csv_path\": \"%s\"\n"
+                 "  },\n",
+                 build_str, s.fps_cap, s.vsync ? "true" : "false", app::PresentModeName(s.present_mode), st.render_scale,
+                 st.window_w, st.window_h, hz, st.shader_cache_enabled ? "true" : "false",
+                 JsonEscape(adapter_name_snap).c_str(), vid_hex, did_hex, adapter_uma_snap ? "true" : "false",
+                 st.sync_interval_last.load(), st.vsync_pacing_active.load() ? "true" : "false",
+                 app::RecommendedCompileJobs(), st.logical_cpus, wall_s, snap.size(),
+                 st.z_writes.load() > 10 ? "true" : "false", JsonEscape(st.csv_path).c_str());
+
+    std::fprintf(fp, "  \"phases\": {\n");
+    WritePhaseJson(fp, "overall", all_valid, true);
+    WritePhaseJson(fp, "gameplay_active", by_phase[size_t(Phase::GameplayActive)], true);
+    WritePhaseJson(fp, "loading_transition", by_phase[size_t(Phase::LoadingTransition)], true);
+    WritePhaseJson(fp, "title_menu", by_phase[size_t(Phase::TitleMenu)], true);
+    WritePhaseJson(fp, "fmv", by_phase[size_t(Phase::Fmv)], true);
+    WritePhaseJson(fp, "paused", by_phase[size_t(Phase::Paused)], false);
+    std::fprintf(fp, "  },\n");
+
+    std::fprintf(fp,
+                 "  \"workload\": {\n"
+                 "    \"process_cpu_pct_avg\": %.2f, \"title_thread_cpu_pct\": %.2f, \"render_thread_cpu_pct\": %.2f\n"
+                 "  },\n",
+                 proc_cpu_pct, title_cpu_pct, render_cpu_pct);
+
+    uint64_t rwaits = st.total_render_waits.load();
+    std::fprintf(fp,
+                 "  \"stalls\": {\n"
+                 "    \"render_waits_total\": %llu, \"lock_stalls\": %llu, \"mid_frame_flushes\": %llu,\n"
+                 "    \"wait_readback_ms_total\": %.3f, \"wait_resource_ms_total\": %.3f,\n"
+                 "    \"wait_fence_ms_total\": %.3f, \"wait_flush_ms_total\": %.3f, \"wait_copy_ms_total\": %.3f,\n"
+                 "    \"wait_next_frame_ms_total\": %.3f, \"wait_gpu_frame_ms_total\": %.3f,\n"
+                 "    \"render_fence_wait_ms_total\": %.3f, \"swap_phase1_ms_avg\": %.4f,\n"
+                 "    \"d3d_glock_bg_wait_ms_total\": %.3f, \"d3d_glock_bg_wait_ms_max\": %.3f, \"d3d_glock_title_wait_ms_total\": %.3f\n"
+                 "  },\n",
+                 (unsigned long long)rwaits, (unsigned long long)rwaits, (unsigned long long)st.mid_frame_flushes.load(),
+                 st.total_wait_kind_ns[0].load() / 1e6, st.total_wait_kind_ns[1].load() / 1e6,
+                 st.total_wait_kind_ns[2].load() / 1e6, st.total_wait_kind_ns[3].load() / 1e6,
+                 st.total_wait_kind_ns[4].load() / 1e6, st.total_wait_kind_ns[5].load() / 1e6,
+                 st.total_wait_gpu_ns.load() / 1e6, fence_wait_total,
+                 p1_cnt ? (st.total_phase1_ns.load() / 1e6 / double(p1_cnt)) : 0.0,
+                 st.total_glock_bg_ns.load() / 1e6, st.max_glock_bg_ns.load() / 1e6,
+                 st.total_glock_title_ns.load() / 1e6);
+
+    std::fprintf(fp,
+                 "  \"shaders\": {\n"
+                 "    \"compile_count\": %llu, \"compile_ms_total\": %.3f, \"compile_ms_max_frame\": %.3f, \"shader_cache_hits\": %llu,\n"
+                 "    \"pso_create_count\": %llu, \"pso_create_ms_total\": %.3f, \"pso_create_ms_max_frame\": %.3f, \"pso_cache_hits\": %llu,\n"
+                 "    \"boot_prewarm_ms\": %.3f, \"boot_prewarm_psos\": %u, \"sync_present_cache_writes\": %llu, \"async_cache_writes\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)st.total_compile_count.load(), st.total_compile_ns.load() / 1e6, compile_max_frame,
+                 (unsigned long long)st.total_shader_hits.load(), (unsigned long long)st.total_pso_count.load(),
+                 st.total_pso_ns.load() / 1e6, pso_max_frame, (unsigned long long)st.total_pso_hits.load(),
+                 st.boot_prewarm_ms.load(), st.boot_prewarm_psos.load(),
+                 (unsigned long long)st.sync_present_cache_writes.load(), (unsigned long long)st.async_cache_writes.load());
+
+    std::fprintf(fp,
+                 "  \"audio\": {\n"
+                 "    \"xaudio2_underruns\": %llu, \"xaudio2_glitches\": %llu, \"underruns\": %llu, \"glitches\": %llu, \"av_sync_ratio\": %.4f,\n"
+                 "    \"depth_ms_start\": %u, \"depth_ms_peak\": %u, \"depth_ms_final\": %u,\n"
+                 "    \"queued_min\": %u, \"blocks_submitted\": %llu, \"render_us_avg\": %.2f, \"render_us_max\": %u,\n"
+                 "    \"active_voices_peak\": %u, \"stream_packets_completed\": %llu, \"stream_underruns\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)aud_underruns, (unsigned long long)aud_glitches, (unsigned long long)aud_underruns,
+                 (unsigned long long)aud_glitches, av_sync_ratio, st.audio_depth_start.load() * 10u,
+                 st.audio_depth_peak.load() * 10u, st.audio_depth_final.load() * 10u, qmin, (unsigned long long)blocks,
+                 blocks ? double(st.audio_render_us_total.load()) / double(blocks) : 0.0,
+                 st.audio_render_us_max.load(), st.audio_voices_peak.load(),
+                 (unsigned long long)st.stream_packets_done.load(), (unsigned long long)st.stream_underruns.load());
+
+    std::fprintf(fp,
+                 "  \"io\": {\n"
+                 "    \"disc_reads\": %llu, \"disc_bytes\": %llu, \"disc_read_ms_total\": %.3f, \"disc_read_ms_max\": %.3f,\n"
+                 "    \"disc_cache_hits\": %llu, \"disc_cache_misses\": %llu, \"disc_cache_hit_pct\": %.2f,\n"
+                 "    \"disc_os_reads\": %llu, \"io_avg_us\": %.2f, \"io_p99_us\": %.2f, \"io_max_us\": %.2f,\n"
+                 "    \"z_writes\": %llu, \"z_write_bytes\": %llu, \"z_write_ms_total\": %.3f, \"z_write_ms_max\": %.3f,\n"
+                 "    \"z_reads\": %llu, \"z_read_bytes\": %llu, \"z_read_ms_total\": %.3f, \"z_read_ms_max\": %.3f,\n"
+                 "    \"hdd_other_ops\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)disc_reads_n, (unsigned long long)st.disc_bytes.load(),
+                 st.disc_ns_total.load() / 1e6, st.disc_ns_max.load() / 1e6, (unsigned long long)disc_hits,
+                 (unsigned long long)disc_misses, disc_hit_pct, (unsigned long long)st.disc_os_reads.load(),
+                 io_avg_us, io_p99_us, io_max_us, (unsigned long long)st.z_writes.load(),
+                 (unsigned long long)st.z_write_bytes.load(), st.z_write_ns_total.load() / 1e6,
+                 st.z_write_ns_max.load() / 1e6, (unsigned long long)st.z_reads.load(),
+                 (unsigned long long)st.z_read_bytes.load(), st.z_read_ns_total.load() / 1e6,
+                 st.z_read_ns_max.load() / 1e6, (unsigned long long)st.hdd_other_ops.load());
+
+    constexpr double kMb = 1048576.0;
+    constexpr double kPageMb = 4096.0 / 1048576.0;
+    double ring_cap_mb = st.upload_ring_cap / kMb;
+    std::fprintf(fp,
+                 "  \"memory\": {\n"
+                 "    \"host_ws_start_mb\": %.2f, \"host_ws_peak_mb\": %.2f, \"host_ws_final_mb\": %.2f, \"host_ws_delta_mb\": %.2f,\n"
+                 "    \"host_private_start_mb\": %.2f, \"host_private_peak_mb\": %.2f, \"host_private_final_mb\": %.2f, \"page_faults\": %llu,\n"
+                 "    \"working_set_peak_mb\": %.2f, \"commit_peak_mb\": %.2f,\n"
+                 "    \"guest_contig_peak_mb\": %.2f, \"guest_virt_peak_mb\": %.2f, \"guest_sys_peak_mb\": %.2f,\n"
+                 "    \"contig_allocs\": %llu, \"contig_alloc_mb_total\": %.2f, \"contig_alloc_max_frame_mb\": %.2f,\n"
+                 "    \"virt_allocs\": %llu, \"virt_commit_mb_total\": %.2f,\n"
+                 "    \"gpu_slab_count\": %u, \"gpu_slab_mb\": %.2f, \"gpu_slab_allocs\": %llu,\n"
+                 "    \"upload_ring_mb\": %.2f, \"upload_ring_cap_mb\": %.2f, \"upload_overflows\": %llu,\n"
+                 "    \"d3d12_upload_ring_cap_mb\": %.2f, \"d3d12_upload_ring_peak_mb\": %.2f, \"d3d12_upload_overflows\": %llu,\n"
+                 "    \"d3d12_textures_peak\": %u, \"d3d12_targets_peak\": %u\n"
+                 "  },\n",
+                 st.host_ws_start / kMb, host_ws_peak / kMb, host_ws_final / kMb,
+                 (double(host_ws_final) - double(st.host_ws_start)) / kMb, st.host_priv_start / kMb, host_priv_peak / kMb,
+                 host_priv_final / kMb, (unsigned long long)page_faults, host_ws_peak / kMb, host_priv_peak / kMb,
+                 st.guest_contig_peak_pages * kPageMb, st.guest_virt_peak_pages * kPageMb,
+                 st.guest_sys_peak_pages * kPageMb, (unsigned long long)st.contig_allocs.load(),
+                 st.contig_alloc_bytes_total.load() / kMb, contig_max_frame / kMb,
+                 (unsigned long long)st.virt_allocs.load(), st.virt_commit_bytes_total.load() / kMb,
+                 st.gpu_slab_count.load(), st.gpu_slab_bytes.load() / kMb, (unsigned long long)st.gpu_slab_allocs.load(),
+                 ring_cap_mb, ring_cap_mb, (unsigned long long)st.upload_overflows_total, ring_cap_mb,
+                 st.upload_ring_peak / kMb, (unsigned long long)st.upload_overflows_total, st.textures_peak,
+                 st.targets_peak);
+
+    static constexpr const char* kUpscalerIds[9] = {
+        "fsr1", "nis", "cas", "bicubic", "integer", "bilinear", "dlss", "fsr3", "xess"};
+    static constexpr const char* kDlssPresetIds[4] = {"auto", "E", "J", "K"};
+    gpu::UpscalerStatus ust = gpu::GetUpscalerStatus();
+    const char* req_up = (uint32_t(s.upscaler) < 9u) ? kUpscalerIds[uint32_t(s.upscaler)] : "fsr1";
+    const char* act_up = (ust.active_mode < 9u) ? kUpscalerIds[ust.active_mode] : req_up;
+    const char* dp_str = (uint32_t(s.dlss_preset) < 4u) ? kDlssPresetIds[uint32_t(s.dlss_preset)] : "auto";
+    uint32_t up_dw = ust.vp_w ? ust.vp_w : (ust.bb_w ? ust.bb_w : st.window_w);
+    uint32_t up_dh = ust.vp_h ? ust.vp_h : (ust.bb_h ? ust.bb_h : st.window_h);
+    std::fprintf(fp,
+                 "  \"upscaler\": {\n"
+                 "    \"requested\": \"%s\", \"active\": \"%s\", \"fallback\": %s, \"temporal_active\": %s,\n"
+                 "    \"dlss_preset\": \"%s\", \"render_w\": %u, \"render_h\": %u, \"display_w\": %u, \"display_h\": %u,\n"
+                 "    \"bb_w\": %u, \"bb_h\": %u, \"dlss_available\": %s, \"fsr3_available\": %s, \"xess_available\": %s,\n"
+                 "    \"detail\": \"%s\"\n"
+                 "  },\n",
+                 req_up, act_up, ust.fallback_active ? "true" : "false", ust.temporal_active ? "true" : "false", dp_str,
+                 ust.render_w, ust.render_h, up_dw, up_dh, ust.bb_w, ust.bb_h,
+                 ust.dlss_available ? "true" : "false", ust.fsr3_available ? "true" : "false",
+                 ust.xess_available ? "true" : "false", JsonEscape(ust.status_detail).c_str());
+
+    WriteSpikesJson(fp, "top_spikes_overall", all_valid, true);
+    WriteSpikesJson(fp, "top_spikes_gameplay", by_phase[size_t(Phase::GameplayActive)], false);
+    std::fprintf(fp, "}\n");
+    std::fflush(fp);
+    std::fclose(fp);
+    LOGR("upscaler: requested=%s active=%s fallback=%s render=%ux%u -> display=%ux%u dlss_preset=%s", req_up, act_up,
+         ust.fallback_active ? "true" : "false", ust.render_w, ust.render_h, up_dw, up_dh, dp_str);
+    LOGR("perf: wrote telemetry summary to %s (%zu frames, %.2fs)", st.json_path.c_str(), snap.size(), wall_s);
+}
