+    uint64_t blocks = st.audio_blocks.load();
+    uint32_t qmin = st.audio_queued_min.load();
+    if (qmin == UINT32_MAX) qmin = 0;
+    uint64_t p1_cnt = st.total_phase1_count.load();
+
+#ifdef NDEBUG
+    const char* build_str = "Release";
+#else
+    const char* build_str = "Debug";
+#endif
+
+    std::string adapter_name_snap;
+    uint32_t adapter_vid_snap = 0, adapter_did_snap = 0;
+    bool adapter_uma_snap = false;
+    {
+        std::lock_guard<std::mutex> lock(st.meta_lock);
+        adapter_name_snap = st.adapter_name;
+        adapter_vid_snap = st.adapter_vid;
+        adapter_did_snap = st.adapter_did;
+        adapter_uma_snap = st.adapter_uma;
+    }
+    char vid_hex[16], did_hex[16];
+    std::snprintf(vid_hex, sizeof(vid_hex), "%04X", adapter_vid_snap);
+    std::snprintf(did_hex, sizeof(did_hex), "%04X", adapter_did_snap);
+
+    std::vector<double> io_us_snap;
+    {
+        std::lock_guard<std::mutex> lock(st.io_samples_lock);
+        io_us_snap = st.disc_read_us_samples;
+    }
+    uint64_t disc_reads_n = st.disc_reads.load();
+    uint64_t disc_hits = st.disc_cache_hits.load();
+    uint64_t disc_misses = st.disc_cache_misses.load();
+    double disc_hit_pct = (disc_hits + disc_misses) > 0 ? (100.0 * double(disc_hits) / double(disc_hits + disc_misses)) : 0.0;
+    double io_avg_us = disc_reads_n > 0 ? (double(st.disc_ns_total.load()) / 1000.0 / double(disc_reads_n)) : 0.0;
+    double io_p99_us = io_us_snap.empty() ? 0.0 : Percentile(io_us_snap, 0.99);
+    double io_max_us = double(st.disc_ns_max.load()) / 1000.0;
+
+    uint64_t aud_underruns = st.audio_underruns.load();
+    uint64_t aud_glitches = st.audio_glitches.load();
+    double av_sync_ratio = (wall_s > 0.0 && blocks > 0) ? ((double(blocks) * 0.01) / wall_s) : 0.0;
+
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp,
+                 "  \"meta\": {\n"
+                 "    \"build\": \"%s\", \"fps_cap\": %u, \"vsync\": %s, \"present_mode\": \"%s\", \"render_scale\": %.3f,\n"
+                 "    \"window\": [%u, %u], \"display_refresh_hz\": %u, \"shader_cache_enabled\": %s,\n"
