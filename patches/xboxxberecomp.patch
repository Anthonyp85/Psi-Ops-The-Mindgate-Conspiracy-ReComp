+// SPDX-License-Identifier: GPL-2.0-or-later
+// Native Linux mixer output through SDL3 AudioStream (PipeWire / PulseAudio / ALSA)
+#include "audio/audio.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <future>
+#include <thread>
+#include <vector>
+
+#include <SDL3/SDL.h>
+
+#include "core/log.h"
+#include "core/perf.h"
+
+namespace audio {
+
+namespace {
+
+// Matches the console's DOLBY stereo downmix in xaudio2.cpp: centre and back at -3 dB, no sub
+constexpr float kCentreFold = 0.707f;
+constexpr float kBackFold = 0.707f;
+constexpr uint32_t kFrames = kRate / 100;  // 10 ms (480 frames)
+constexpr uint32_t kMinQueued = 3;         // 30 ms initial headroom
+constexpr uint32_t kMaxQueued = 8;         // 80 ms adaptive ceiling
+constexpr uint32_t kRetryBlocks = 100;     // 1 second between device reopen attempts
+
+std::atomic<bool> g_surround{false};
+std::atomic<bool> g_mono{false};
+std::atomic<uint32_t> g_mode{kOutputAuto};
+std::atomic<bool> g_mode_changed{false};
+std::atomic<float> g_master_vol{1.0f};
+std::atomic<bool> g_muted{false};
+std::atomic<bool> g_focus_muted{false};
+
+struct StreamState {
+    std::function<void(float*, uint32_t)> render;
+    int out_channels = 2;
+    bool dev_surround = false;
+    std::vector<float> mix_buf;
+    std::vector<float> out_buf;
+};
+
+const char* OutputName() {
+    if (g_mono.load(std::memory_order_relaxed)) return "mono";
+    return g_surround.load(std::memory_order_relaxed) ? "5.1" : "stereo";
+}
+
+void DownmixAndScale(const float* src, float* dst, uint32_t frames, int out_ch, float vol, bool mono) {
+    if (out_ch == 6) {
+        const size_t total_samples = size_t(frames) * 6;
+        for (size_t i = 0; i < total_samples; ++i) dst[i] = src[i] * vol;
+    } else if (out_ch == 1) {
+        for (uint32_t i = 0; i < frames; ++i) {
+            const float* s = src + size_t(i) * kChannels;
+            float l = s[0] + kCentreFold * s[2] + kBackFold * s[4];
+            float r = s[1] + kCentreFold * s[2] + kBackFold * s[5];
+            dst[i] = (l + r) * 0.5f * vol;
+        }
+    } else {
+        for (uint32_t i = 0; i < frames; ++i) {
+            const float* s = src + size_t(i) * kChannels;
+            float l = s[0] + kCentreFold * s[2] + kBackFold * s[4];
+            float r = s[1] + kCentreFold * s[2] + kBackFold * s[5];
+            if (mono) {
+                float m = (l + r) * 0.5f * vol;
+                dst[size_t(i) * 2 + 0] = m;
+                dst[size_t(i) * 2 + 1] = m;
+            } else {
+                dst[size_t(i) * 2 + 0] = l * vol;
+                dst[size_t(i) * 2 + 1] = r * vol;
+            }
+        }
+    }
+}
+
+SDL_AudioStream* OpenStream(StreamState& st) {
+    if (!SDL_WasInit(SDL_INIT_AUDIO)) {
+        if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+            LOGE("audio: SDL audio init failed: %s", SDL_GetError());
+            return nullptr;
+        }
+    }
+    SDL_AudioSpec dev_spec{};
+    int dev_frames = 0;
+    bool got_fmt = SDL_GetAudioDeviceFormat(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &dev_spec, &dev_frames);
+    int dev_ch = (got_fmt && dev_spec.channels > 0) ? dev_spec.channels : 2;
+    st.dev_surround = (dev_ch >= 6);
+
+    uint32_t mode = g_mode.load(std::memory_order_relaxed);
+    bool want_surround = (mode == kOutputAuto) ? st.dev_surround : (mode == kOutputSurround);
+    bool want_mono = (mode == kOutputMono);
+    g_surround.store(want_surround, std::memory_order_relaxed);
+    g_mono.store(want_mono, std::memory_order_relaxed);
+
+    if (want_surround && st.dev_surround) st.out_channels = 6;
+    else if (dev_ch == 1) st.out_channels = 1;
+    else st.out_channels = 2;
+
+    SDL_AudioSpec spec{};
+    spec.format = SDL_AUDIO_F32;
+    spec.channels = st.out_channels;
+    spec.freq = int(kRate);
+
+    // Push-mode stream (no RT callback): keeps dsound::g_lock and DSP off PipeWire's SCHED_FIFO thread.
+    SDL_AudioStream* stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+    if (!stream) {
+        LOGE("audio: SDL_OpenAudioDeviceStream failed: %s", SDL_GetError());
+        return nullptr;
+    }
+    if (!SDL_ResumeAudioStreamDevice(stream)) {
+        LOGE("audio: SDL_ResumeAudioStreamDevice failed: %s", SDL_GetError());
+        SDL_DestroyAudioStream(stream);
+        return nullptr;
+    }
+    const char* driver = SDL_GetCurrentAudioDriver();
+    LOGR("audio: SDL3 (%s) push %s output, %d stream ch (%d device ch)", driver ? driver : "unknown", OutputName(),
+         st.out_channels, dev_ch);
+    return stream;
+}
+
+// With no audio device (e.g. headless CI / Xvfb), keep advancing the Xbox mixer at wall-clock rate.
+void RenderUnheard(const std::function<void(float*, uint32_t)>& render) {
+    std::vector<float> buf(kFrames * kChannels);
+    auto start = std::chrono::steady_clock::now();
+    for (uint32_t done = 0; done < kRetryBlocks;) {
+        auto due = std::chrono::steady_clock::now() - start;
+        for (; done < kRetryBlocks && done * std::chrono::milliseconds(10) < due; ++done) render(buf.data(), kFrames);
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+}
+
+}  // namespace
+
+bool IsSurround() { return g_surround.load(std::memory_order_relaxed); }
+
+bool IsMono() { return g_mono.load(std::memory_order_relaxed); }
+
+void SetOutputMode(uint32_t mode) {
+    if (g_mode.exchange(mode, std::memory_order_relaxed) != mode)
+        g_mode_changed.store(true, std::memory_order_release);
+}
+
+void SetMasterVolume(float linear_0_to_1) {
+    float v = linear_0_to_1 < 0.0f ? 0.0f : (linear_0_to_1 > 1.0f ? 1.0f : linear_0_to_1);
+    g_master_vol.store(v, std::memory_order_relaxed);
+}
+
+void SetMuted(bool muted) { g_muted.store(muted, std::memory_order_relaxed); }
+
+void SetFocusMuted(bool muted) { g_focus_muted.store(muted, std::memory_order_relaxed); }
+
+void StartOutput(std::function<void(float*, uint32_t)> render) {
+    std::promise<void> opened;
+    std::future<void> known = opened.get_future();
+    std::thread([render = std::move(render), opened = std::move(opened)]() mutable {
+        StreamState st;
+        st.render = std::move(render);
+        st.mix_buf.resize(kFrames * kChannels);
+        st.out_buf.resize(kFrames * kChannels);
+
+        SDL_AudioStream* stream = OpenStream(st);
+        opened.set_value();
+        if (!stream) LOGR("audio: SDL3 playback unavailable, running unheard mixer");
+
+        uint32_t target_blocks = kMinQueued;
+        bool primed = false;
+
+        for (;;) {
+            if (!stream) {
+                RenderUnheard(st.render);
+                stream = OpenStream(st);
+                target_blocks = kMinQueued;
+                primed = false;
+                continue;
+            }
+
+            if (g_mode_changed.exchange(false, std::memory_order_acq_rel)) {
+                uint32_t mode = g_mode.load(std::memory_order_relaxed);
+                bool want_surround = (mode == kOutputAuto) ? st.dev_surround : (mode == kOutputSurround);
+                bool want_mono = (mode == kOutputMono);
+                int want_ch = (want_surround && st.dev_surround) ? 6 : (st.out_channels == 1 ? 1 : 2);
+                g_surround.store(want_surround, std::memory_order_relaxed);
+                g_mono.store(want_mono, std::memory_order_relaxed);
+                if (want_ch != st.out_channels) {
+                    SDL_DestroyAudioStream(stream);
+                    stream = OpenStream(st);
+                    target_blocks = kMinQueued;
+                    primed = false;
+                    continue;
+                }
+                LOGR("audio: %s output, %d stream ch", OutputName(), st.out_channels);
+            }
+
+            const int frame_bytes = st.out_channels * int(sizeof(float));
+            const int block_bytes = int(kFrames) * frame_bytes;
+            int queued_bytes = SDL_GetAudioStreamQueued(stream);
+            if (queued_bytes < 0) {
+                LOGW("audio: SDL_GetAudioStreamQueued failed: %s; reopening", SDL_GetError());
+                SDL_DestroyAudioStream(stream);
+                stream = nullptr;
+                continue;
+            }
+
+            bool starved = false;
+            if (primed && queued_bytes == 0) {
+                starved = true;
+                if (target_blocks < kMaxQueued) {
+                    ++target_blocks;
+                    LOGI("audio: SDL3 output starved, queueing %u ms", target_blocks * 10u);
+                }
+            }
+
+            const int target_bytes = int(target_blocks) * block_bytes;
+            while (queued_bytes < target_bytes) {
+                const float vol =
+                    (g_muted.load(std::memory_order_relaxed) || g_focus_muted.load(std::memory_order_relaxed))
+                        ? 0.0f
+                        : g_master_vol.load(std::memory_order_relaxed);
+                const bool mono = g_mono.load(std::memory_order_relaxed);
+
+                auto rt0 = perf::Enabled() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+                st.render(st.mix_buf.data(), kFrames);
+                if (perf::Enabled()) {
+                    uint32_t rus = uint32_t(
+                        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - rt0)
+                            .count());
+                    uint32_t queued_blocks = queued_bytes > 0 ? uint32_t(queued_bytes / block_bytes) : 0u;
+                    perf::RecordAudioBlock(rus, queued_blocks, target_blocks, starved, 0u);
+                    starved = false;
+                }
+
+                DownmixAndScale(st.mix_buf.data(), st.out_buf.data(), kFrames, st.out_channels, vol, mono);
+                if (!SDL_PutAudioStreamData(stream, st.out_buf.data(), block_bytes)) {
+                    LOGW("audio: SDL_PutAudioStreamData failed: %s; reopening", SDL_GetError());
+                    SDL_DestroyAudioStream(stream);
+                    stream = nullptr;
+                    break;
+                }
+                primed = true;
+                queued_bytes = SDL_GetAudioStreamQueued(stream);
+                if (queued_bytes < 0) {
+                    SDL_DestroyAudioStream(stream);
+                    stream = nullptr;
+                    break;
+                }
+            }
+
+            if (stream) std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+    }).detach();
+    known.wait();
+}
+
+}  // namespace audio
