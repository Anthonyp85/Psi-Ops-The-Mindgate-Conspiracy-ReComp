+CacheStats GetCacheStats() {
+    if (!g_cache_enabled_stat.load(std::memory_order_relaxed)) {
+        return InspectDiskCacheStats(true);
+    }
+    CacheStats cs{};
+    cs.enabled = true;
+    cs.shaders = g_cache_shaders_stat.load(std::memory_order_relaxed);
+    cs.psos = g_cache_psos_stat.load(std::memory_order_relaxed);
+    cs.disk_bytes = g_cache_bytes_stat.load(std::memory_order_relaxed);
+    cs.aot_ready = g_cache_aot_ready_stat.load(std::memory_order_relaxed);
+    cs.rebuild_pending = IsAotRebuildFlagSet();
+    cs.aot_compiled_shaders = g_cache_aot_shaders_stat.load(std::memory_order_relaxed);
+    cs.aot_built_psos = g_cache_aot_psos_stat.load(std::memory_order_relaxed);
+    cs.aot_ms = g_cache_aot_ms_stat.load(std::memory_order_relaxed);
+    return cs;
+}
+
+void RequestCacheReset() { g_cache_reset_requested.store(true, std::memory_order_release); }
+
+void ScheduleCacheRebuildOnNextLaunch() { ClearDiskCachesAndScheduleRebuild(); }
+
+bool IsCacheRebuildScheduled() { return IsAotRebuildFlagSet(); }
+
+void RequestBackbufferCapture(const std::filesystem::path& bmp_path) {
+    std::lock_guard<std::mutex> lock(g_bb_cap_lock);
+    g_bb_cap_path = bmp_path;
+}
+
+void SetCameraCallback(CameraCallback cb) { g_camera_cb.store(cb, std::memory_order_release); }
+
+CameraFrameData QueryCamera() {
+    if (CameraCallback cb = g_camera_cb.load(std::memory_order_acquire)) return cb();
+    return {};
+}
+
+void SetUiVisibleCallback(UiVisibleCallback cb) { g_ui_visible_cb.store(cb, std::memory_order_release); }
+
+bool HasVisibleUi() {
+    if (UiVisibleCallback cb = g_ui_visible_cb.load(std::memory_order_acquire)) return cb();
+    return true;
+}
+
+void SetUpscaler(Upscaler* upscaler) { g_upscaler.store(upscaler, std::memory_order_release); }
+
+Upscaler* GetUpscaler() { return g_upscaler.load(std::memory_order_acquire); }
+
+GpuCaps GetGpuCaps() {
+    std::lock_guard<std::mutex> lock(g_caps_lock);
+    return g_gpu_caps;
+}
+
+UpscalerStatus GetUpscalerStatus() {
+    if (Upscaler* u = g_upscaler.load(std::memory_order_acquire)) return u->GetStatus();
+    return {};
+}
