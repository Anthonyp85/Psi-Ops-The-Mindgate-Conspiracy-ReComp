+        _mm_storeu_si128(reinterpret_cast<__m128i*>(dst_row + x * 4), px0);
+        _mm_storeu_si128(reinterpret_cast<__m128i*>(dst_row + x * 4 + 16), px1);
+    }
+    for (; x < w; x += 2) {
