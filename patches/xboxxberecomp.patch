+    }
+    DEVMODEW dm{};
+    dm.dmSize = sizeof(dm);
+    for (DWORD i = 0; EnumDisplaySettingsW(dev_w.empty() ? nullptr : dev_w.c_str(), i, &dm); ++i) {
+        if (dm.dmBitsPerPel >= 32 && dm.dmPelsWidth >= 640 && dm.dmPelsHeight >= 480)
+            uniq.emplace(dm.dmPelsWidth, dm.dmPelsHeight);
+    }
+#else
+    if (SDL_WasInit(SDL_INIT_VIDEO)) {
+        SDL_DisplayID did = 0;
+        if (!device.empty()) did = SDL_DisplayID(std::strtoul(device.c_str(), nullptr, 10));
+        if (!did) did = static_cast<SDL_DisplayID>(reinterpret_cast<uintptr_t>(TargetMonitor()));
+        if (!did) did = SDL_GetPrimaryDisplay();
+        int count = 0;
+        if (SDL_DisplayMode** modes = SDL_GetFullscreenDisplayModes(did, &count)) {
+            for (int i = 0; i < count; ++i) {
+                if (modes[i] && modes[i]->w >= 640 && modes[i]->h >= 480)
+                    uniq.emplace(uint32_t(modes[i]->w), uint32_t(modes[i]->h));
+            }
+            SDL_free(modes);
+        }
+    }
+#endif
+    // Always include common clean 16:9 / 16:10 / 4:3 windowed targets if not larger than desktop
+    Mode desk = Desktop();
+    static constexpr Mode kCommon[] = {{640, 480},   {960, 720},   {1280, 720},  {1280, 800},  {1600, 900},
+                                       {1920, 1080}, {1920, 1200}, {2560, 1440}, {2560, 1600}, {3840, 2160}};
+    for (Mode m : kCommon)
+        if (m.width <= desk.width && m.height <= desk.height) uniq.emplace(m.width, m.height);
+    if (desk.width >= 640 && desk.height >= 480) uniq.emplace(desk.width, desk.height);
+    std::vector<Mode> out;
+    out.reserve(uniq.size());
+    for (auto [w, h] : uniq) out.push_back({w, h});
+    return out;
+}
