+// Auto-discover .xiso.iso / .iso files in ExeDir(), ancestor workspace roots (up to 6 levels),
+// and their immediate subdirectories (skipping build/SCM/runtime folders).
+std::vector<fs::path> FindWorkspaceIsos() {
+    auto is_skipped_dir = [](const std::string& lower_name) -> bool {
+        if (lower_name.empty() || lower_name[0] == '.') return true;
+        static const char* const kSkip[] = {
+            "out", "build", "generated", "xboxxberecomp", "assets", "hdd", "logs", "cache",
+            "crashdumps", "src", "tools", "config", "patches", "packaging", "tests", "docs",
+            "textures", "compiler", "plugins"
+        };
+        for (const char* s : kSkip)
+            if (lower_name == s) return true;
+        return false;
+    };
+
+    std::vector<fs::path> out;
+    std::error_code ec;
+    auto push_unique = [&](const fs::path& p) {
+        fs::path norm = p.lexically_normal();
+        if (std::find(out.begin(), out.end(), norm) == out.end()) out.push_back(std::move(norm));
+    };
+
+    fs::path dir = ExeDir();
+    for (int depth = 0; depth < 6; ++depth) {
+        std::vector<fs::path> direct_isos;
+        std::vector<fs::path> subdirs;
+        for (auto& e : fs::directory_iterator(dir, ec)) {
+            if (e.is_regular_file(ec)) {
+                if (LowerAsciiStr(e.path().extension().string()) == ".iso") direct_isos.push_back(e.path());
+            } else if (e.is_directory(ec)) {
+                std::string name = LowerAsciiStr(e.path().filename().string());
+                if (!is_skipped_dir(name)) subdirs.push_back(e.path());
+            }
+        }
+        std::sort(direct_isos.begin(), direct_isos.end());
+        for (const fs::path& p : direct_isos) push_unique(p);
+
+        std::sort(subdirs.begin(), subdirs.end());
+        for (const fs::path& sub : subdirs) {
+            std::vector<fs::path> sub_isos;
+            for (auto& se : fs::directory_iterator(sub, ec)) {
+                if (se.is_regular_file(ec) && LowerAsciiStr(se.path().extension().string()) == ".iso")
+                    sub_isos.push_back(se.path());
+            }
+            std::sort(sub_isos.begin(), sub_isos.end());
+            for (const fs::path& p : sub_isos) push_unique(p);
+        }
+
+        if (!dir.has_parent_path() || dir.parent_path() == dir) break;
+        dir = dir.parent_path();
+    }
+    return out;
+}
