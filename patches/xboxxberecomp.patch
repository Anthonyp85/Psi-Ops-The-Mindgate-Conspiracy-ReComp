+
+void AutotestOnPresent(uint64_t present_frame, std::filesystem::path& out_capture_bmp, bool& out_should_exit) {
+    out_capture_bmp.clear();
+    out_should_exit = false;
+    EnsureAutotestLoaded();
+    if (g_autotest.active) {
+        g_autotest.present_frame.store(present_frame, std::memory_order_release);
+        std::lock_guard<std::mutex> lock(g_autotest.lock);
+        auto now = std::chrono::steady_clock::now();
+        if (!g_autotest.clock_started.load(std::memory_order_relaxed)) {
+            g_autotest.start_tp = now;
+            g_autotest.clock_started.store(true, std::memory_order_release);
+        }
+        uint64_t ms =
+            uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(now - g_autotest.start_tp).count());
+        bool any_pending_cap = false;
+        for (AutotestCaptureEvent& cap : g_autotest.captures) {
+            uint64_t cur = cap.by_time_ms ? ms : present_frame;
+            if (!cap.triggered && cur >= cap.target_val) {
+                if (out_capture_bmp.empty()) {
+                    cap.triggered = true;
+                    out_capture_bmp = cap.path;
+                    LOGR("autotest: capture triggered frame=%llu ms=%llu -> %s", (unsigned long long)present_frame,
+                         (unsigned long long)ms, cap.path.string().c_str());
+                } else {
+                    any_pending_cap = true;
+                }
+            } else if (!cap.triggered &&
+                       ((!cap.by_time_ms && g_autotest.exit_frame > 0 && cap.target_val <= g_autotest.exit_frame) ||
+                        (cap.by_time_ms && g_autotest.exit_ms > 0 && cap.target_val <= g_autotest.exit_ms))) {
+                any_pending_cap = true;
+            }
+        }
+        bool hit_exit = (g_autotest.exit_frame > 0 && present_frame >= g_autotest.exit_frame) ||
+                        (g_autotest.exit_ms > 0 && ms >= g_autotest.exit_ms);
+        if (!any_pending_cap && out_capture_bmp.empty() && hit_exit && !g_autotest.exit_posted) {
+            g_autotest.exit_posted = true;
+            out_should_exit = true;
+            LOGR("autotest: clean exit requested at frame=%llu ms=%llu", (unsigned long long)present_frame,
+                 (unsigned long long)ms);
+        }
+    }
+    if (PresentCallback cb = g_present_cb.load(std::memory_order_acquire)) {
+        std::filesystem::path cb_cap;
+        bool cb_exit = false;
+        cb(present_frame, cb_cap, cb_exit);
+        if (out_capture_bmp.empty() && !cb_cap.empty()) out_capture_bmp = std::move(cb_cap);
+        if (cb_exit) out_should_exit = true;
+    }
 }
 
