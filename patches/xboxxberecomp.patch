+uint32_t Disc::ReadAt(uint64_t at, void* out, uint32_t len) const {
+    auto t0 = perf::Enabled() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    if (len == 0 || (size_ > 0 && at >= size_)) {
+        if (perf::Enabled()) {
+            double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            perf::RecordDiscRead(0, ms);
+        }
+        return 0;
+    }
+    if (size_ > 0 && uint64_t(len) > size_ - at) len = uint32_t(size_ - at);
+
+    uint32_t total_got = 0;
+    if (!cache_ || len >= kCacheBypassBytes) {
+        auto os_t0 = perf::Enabled() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        total_got = ReadRawAt(at, out, len);
+        if (perf::Enabled()) {
+            double os_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - os_t0).count();
+            perf::RecordDiscOsRead(total_got, os_ms);
+        }
+    } else {
+        thread_local std::array<uint8_t, kCacheBlockSize * 2u> scratch;
+        thread_local const Disc* last_disc = nullptr;
+        thread_local uint64_t last_miss_block = ~uint64_t(0);
+        if (last_disc != this) {
+            last_disc = this;
+            last_miss_block = ~uint64_t(0);
+        }
+        auto insert_block = [&](uint64_t bidx, const uint8_t* src, uint32_t got_len) {
+            if (got_len == 0) return;
+            BlockCache::Stripe& st = cache_->stripes[size_t(bidx & (kCacheStripes - 1u))];
+            std::lock_guard<std::mutex> lock(st.mtx);
+            BlockCache::Slot* target = nullptr;
+            for (BlockCache::Slot& slot : st.slots) {
+                if (slot.block_idx == bidx) {
+                    target = &slot;
+                    break;
+                }
+            }
+            if (!target) {
+                target = &st.slots[0];
+                for (BlockCache::Slot& slot : st.slots) {
+                    if (slot.block_idx == ~uint64_t(0)) {
+                        target = &slot;
+                        break;
+                    }
+                    if (slot.last_used < target->last_used) target = &slot;
+                }
+                std::memcpy(target->data, src, got_len);
+                target->block_idx = bidx;
+                target->valid_len = got_len;
+            }
+            target->last_used = ++st.clock;
+        };
