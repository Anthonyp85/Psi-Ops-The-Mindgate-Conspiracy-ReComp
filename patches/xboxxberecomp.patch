+// Ahead-of-Time (AOT) NV2A Vertex/Pixel Shader & Pipeline Pre-Compiler
+// shared across Win64 D3D12 and Native Linux Vulkan 1.2 backends.
+// Scans read-only mounted XBE/XISO shader tables + copyright-clean numeric
+// D3D8/NV2A pipeline key seeds so cold boots compile the full shader set up front.
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
