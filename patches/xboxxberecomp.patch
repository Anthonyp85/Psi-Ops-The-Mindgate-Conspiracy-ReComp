+}
+
+void VulkanBackend::FreeDeferred(std::vector<DeferredDestroy>& list) {
+    for (auto& d : list) {
+        if (d.fb != VK_NULL_HANDLE) vk_.destroy_fb(dev_, d.fb, nullptr);
+        if (d.view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, d.view, nullptr);
+        if (d.img != VK_NULL_HANDLE) vk_.destroy_img(dev_, d.img, nullptr);
+        if (d.buf != VK_NULL_HANDLE) vk_.destroy_buf(dev_, d.buf, nullptr);
+        if (d.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, d.mem, nullptr);
+        if (d.slab_id != UINT32_MAX) FreeSlabRange(d.slab_id, d.slab_off, d.slab_size);
+    }
+    list.clear();
+}
