+        auto* dst = static_cast<uint8_t*>(out);
+        uint64_t cur_at = at;
+        uint32_t rem = len;
+        while (rem > 0) {
+            const uint64_t block_idx = cur_at >> kCacheBlockShift;
+            const uint32_t off_in_block = uint32_t(cur_at & (kCacheBlockSize - 1u));
+            const uint32_t chunk = std::min<uint32_t>(rem, kCacheBlockSize - off_in_block);
+            BlockCache::Stripe& stripe = cache_->stripes[size_t(block_idx & (kCacheStripes - 1u))];
+
+            bool hit = false;
+            uint32_t avail = 0;
+            {
+                std::lock_guard<std::mutex> lock(stripe.mtx);
+                for (BlockCache::Slot& slot : stripe.slots) {
+                    if (slot.block_idx == block_idx) {
+                        slot.last_used = ++stripe.clock;
+                        if (off_in_block < slot.valid_len) {
+                            avail = std::min<uint32_t>(chunk, slot.valid_len - off_in_block);
+                            std::memcpy(dst + total_got, slot.data + off_in_block, avail);
+                        }
+                        hit = true;
+                        break;
+                    }
+                }
+            }
+            if (hit) {
+                if (perf::Enabled()) perf::RecordDiscCacheHit(avail);
+                total_got += avail;
+                if (avail < chunk) break;
+                cur_at += avail;
+                rem -= avail;
+                continue;
+            }
