+void RecordRenderWait(uint8_t kind, double ms, bool is_named_wait) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    if (kind < 6) {
+        st.pending_wait_kind_ns[kind].fetch_add(ns, std::memory_order_relaxed);
+        st.total_wait_kind_ns[kind].fetch_add(ns, std::memory_order_relaxed);
+    }
+    if (is_named_wait) st.total_render_waits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordShaderCompile(double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    st.pending_compile_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.pending_shaders.fetch_add(1, std::memory_order_relaxed);
+    st.total_compile_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.total_compile_count.fetch_add(1, std::memory_order_relaxed);
+}
