+// --- Shaders, Pipelines, Samplers, Descriptors ---
+
+VkShaderModule VulkanBackend::Compile(const std::string& src, const char* entry, const char* profile, uint64_t& hash) {
+    uint64_t profile_seed = Hash(profile, std::strlen(profile));
+    uint64_t entry_seed = Hash(entry, std::strlen(entry), profile_seed);
+    hash = Hash(src.data(), src.size(), entry_seed);
+    auto it = shader_mods_.find(hash);
+    if (it != shader_mods_.end()) {
+        if (disk_blob_pending_.erase(hash) > 0 && perf::Enabled()) perf::RecordShaderCacheHit();
+        return it->second;
+    }
+    PerfScope perf_compile{g_perf.compile};
+    g_perf.shaders++;
+    auto ct0 = PerfClock::now();
+    std::vector<uint32_t> spv;
+    std::string err;
+    bool ok = CompileHlslToSpirv(src, entry, profile, spv, err);
+    double ms = PerfMs(ct0);
+    if (boot_init_complete_) {
+        runtime_shader_compiles_++;
+        if (perf::Enabled()) perf::RecordShaderCompile(ms);
+        LOGI("vulkan: runtime shader compile (%s/%s, hash=%016llX, %.2f ms)", profile, entry,
+             (unsigned long long)hash, ms);
+    }
+    if (!ok) {
+        LOGE("vulkan: %s (%s) compile failed: %s", profile, entry, err.c_str());
+        shader_mods_[hash] = VK_NULL_HANDLE;
+        return VK_NULL_HANDLE;
+    }
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = spv.size() * sizeof(uint32_t);
+    ci.pCode = spv.data();
+    VkShaderModule mod = VK_NULL_HANDLE;
+    if (vk_.create_shader(dev_, &ci, nullptr, &mod) != VK_SUCCESS) {
+        shader_mods_[hash] = VK_NULL_HANDLE;
+        return VK_NULL_HANDLE;
+    }
+    shader_mods_[hash] = mod;
+    if (cache_enabled_) {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        shader_cache_entries_.emplace_back(hash, std::move(spv));
+        shaders_dirty_ = true;
+        cache_dirty_frame_ = presents_;
+    }
+    return mod;
+}
+
+VkPrimitiveTopology VkTopologyOf(uint32_t topo, uint32_t strip) {
+    if (topo == uint32_t(Topology::Points)) return VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+    if (topo == uint32_t(Topology::Lines)) {
+        return strip ? VK_PRIMITIVE_TOPOLOGY_LINE_STRIP : VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+    }
+    return strip ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+}
+
+VkPipeline VulkanBackend::EnsurePipeline(const PsoKey& k, VkShaderModule vs, VkShaderModule ps) {
+    uint64_t h = Hash(&k, sizeof(k));
+    auto it = psos_.find(h);
+    if (it != psos_.end()) return it->second;
+
+    VkPipelineShaderStageCreateInfo stages[3]{};
+    uint32_t stage_cnt = 0;
+    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                           VK_SHADER_STAGE_VERTEX_BIT, vs, "main", nullptr};
+    bool expanded_points = false;
+    if (k.topo == uint32_t(Topology::Points)) {
+        uint64_t gh = 0;
+        VkShaderModule gs = Compile(k.sprite ? SpriteHlsl() : PointHlsl(), "main", "gs_5_0", gh);
+        if (gs != VK_NULL_HANDLE) {
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_GEOMETRY_BIT, gs, "main", nullptr};
+            expanded_points = true;
+        }
+    }
+    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                           VK_SHADER_STAGE_FRAGMENT_BIT, ps, "main", nullptr};
+
+    VkVertexInputBindingDescription vbinds[16]{};
+    for (uint32_t i = 0; i < k.buf_count; ++i) {
+        vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+    }
+    VkVertexInputAttributeDescription vattrs[16]{};
+    uint32_t attr_cnt = 0;
+    for (uint32_t r = 0; r < 16; ++r) {
+        if (!((k.regs >> r) & 1)) continue;
+        uint32_t e = k.elements[r];
+        vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+    }
+
+    VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    vi.vertexBindingDescriptionCount = k.buf_count;
+    vi.pVertexBindingDescriptions = vbinds;
+    vi.vertexAttributeDescriptionCount = attr_cnt;
+    vi.pVertexAttributeDescriptions = vattrs;
+
+    VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    ia.topology = VkTopologyOf(k.topo, k.strip);
+    ia.primitiveRestartEnable = VK_FALSE;
+
+    VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    vp.viewportCount = 1;
+    vp.scissorCount = 1;
+
+    VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    rs.polygonMode = (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+    rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+    // Negative-height VkViewport preserves exact D3D12 screen winding!
+    rs.frontFace = (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+    rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+    rs.depthBiasConstantFactor = float(k.zbias);
+    rs.depthBiasSlopeFactor = k.zslope;
+    rs.lineWidth = 1.0f;
+
+    VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+    VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+    ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+    ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+    ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+    ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+    VkStencilOpState sop{};
+    sop.failOp = StencilOpVk(k.sfail);
+    sop.passOp = StencilOpVk(k.spass);
+    sop.depthFailOp = StencilOpVk(k.szfail);
+    sop.compareOp = CmpVk(k.sfunc);
+    sop.compareMask = k.smask;
+    sop.writeMask = k.swmask;
+    ds.front = ds.back = sop;
+
+    VkPipelineColorBlendAttachmentState ba{};
+    ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+    ba.srcColorBlendFactor = BlendFactor(k.src, false);
+    ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+    ba.colorBlendOp = BlendOpVk(k.op);
+    ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+    ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+    ba.alphaBlendOp = BlendOpVk(k.op);
+    ba.colorWriteMask = k.wmask & 0xF;
+
+    VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    cb.attachmentCount = k.has_rt ? 1u : 0u;
+    cb.pAttachments = k.has_rt ? &ba : nullptr;
+
+    VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                    VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+    VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+    dyn.dynamicStateCount = 4;
+    dyn.pDynamicStates = dyn_states;
+
+    VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                    k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+
+    VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    gi.stageCount = stage_cnt;
+    gi.pStages = stages;
+    gi.pVertexInputState = &vi;
+    gi.pInputAssemblyState = &ia;
+    gi.pViewportState = &vp;
+    gi.pRasterizationState = &rs;
+    gi.pMultisampleState = &ms;
+    gi.pDepthStencilState = &ds;
+    gi.pColorBlendState = &cb;
+    gi.pDynamicState = &dyn;
+    gi.layout = gfx_layout_;
+    gi.renderPass = rp;
+    gi.subpass = 0;
+
+    VkPipeline pipe = VK_NULL_HANDLE;
+    g_perf.psos++;
+    auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+    VkResult r = vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe);
+    if (r != VK_SUCCESS) {
+        if (boot_init_complete_) {
+            runtime_pso_creates_++;
+            if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        }
+        LOGE("vulkan: graphics pipeline creation failed (%d)", int(r));
+    } else if (cache_enabled_) {
+        bool is_new = false;
+        {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            is_new = known_pso_keys_.insert(h).second;
+            if (is_new) {
+                pso_meta_entries_.push_back(k);
+                pso_dirty_ = true;
+                meta_dirty_ = true;
+                cache_dirty_frame_ = presents_;
+            }
+        }
+        if (boot_init_complete_) {
+            if (is_new) {
+                runtime_pso_creates_++;
+                if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+                LOGI("vulkan: runtime PSO miss #%zu (vs=%016llX ps=%016llX regs=0x%04X topo=%u strip=%u rt=%u ds=%u "
+                     "blend=%u(%X,%X,%X) wm=0x%X z=(%u,%u,%X) sten=%u(%X,%X,%X,%X,%X,%X) cull=%u ccw=%u fill=%X spr=%u)",
+                     runtime_pso_creates_, (unsigned long long)k.vs, (unsigned long long)k.ps, k.regs, k.topo, k.strip,
+                     k.has_rt, k.has_ds, k.blend, k.src, k.dst, k.op, k.wmask, k.zen, k.zwrite, k.zfunc, k.sten,
+                     k.sfunc, k.smask, k.swmask, k.sfail, k.szfail, k.spass, k.cull, k.ccw, k.fill, k.sprite);
+            } else if (perf::Enabled()) {
+                perf::RecordPsoCacheHit();
+            }
+        }
+    } else if (boot_init_complete_) {
+        runtime_pso_creates_++;
+        if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+    }
+    psos_[h] = pipe;
+    return pipe;
+}
+
+void VulkanBackend::PrewarmCachedPsos() {
+    if (!cache_enabled_ || cache_dir_.empty()) return;
+    std::filesystem::path meta_path = PsoMetaPath();
+    std::error_code ec;
+    auto fsize = std::filesystem::file_size(meta_path, ec);
+    if (ec || fsize < sizeof(VkPsoMetaHeader)) return;
+    FILE* f = std::fopen(meta_path.c_str(), "rb");
+    if (!f) return;
+    VkPsoMetaHeader hdr{};
+    bool ok = std::fread(&hdr, sizeof(hdr), 1, f) == 1 && hdr.magic == kVkPsoMetaMagic &&
+              hdr.version == kVkPsoMetaVersion && hdr.sizeof_pso_key == sizeof(PsoKey) &&
+              hdr.vendor_id == phys_props_.vendorID && hdr.device_id == phys_props_.deviceID &&
+              hdr.driver_version == phys_props_.driverVersion &&
+              std::memcmp(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE) == 0 && hdr.src_count <= 65536u &&
+              hdr.pso_count <= 65536u;
+    uint64_t expect = uint64_t(sizeof(VkPsoMetaHeader)) + uint64_t(hdr.src_count) * sizeof(SrcMetaEntry) +
+                      uint64_t(hdr.pso_count) * sizeof(PsoKey);
+    if (!ok || expect != fsize) {
+        std::fclose(f);
+        return;
+    }
+    std::vector<SrcMetaEntry> src_loaded(hdr.src_count);
+    std::vector<PsoKey> pso_loaded(hdr.pso_count);
+    if (hdr.src_count && std::fread(src_loaded.data(), sizeof(SrcMetaEntry), hdr.src_count, f) != hdr.src_count)
+        ok = false;
+    if (ok && hdr.pso_count && std::fread(pso_loaded.data(), sizeof(PsoKey), hdr.pso_count, f) != hdr.pso_count)
+        ok = false;
+    std::fclose(f);
+    if (!ok) return;
+
+    auto t0 = PerfClock::now();
+    size_t restored_src = 0;
+    for (const auto& e : src_loaded) {
+        auto bit = shader_mods_.find(e.blob_hash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            shader_src_[e.src_key] = e.blob_hash;
+            if (known_src_keys_.insert(e.src_key).second) src_meta_entries_.push_back(e);
+            restored_src++;
+        }
+    }
+
+    // Single-threaded prep: pre-compile point/sprite GS and pre-create all VkRenderPasses before worker spawn
+    bool need_point_gs = false, need_sprite_gs = false;
+    for (const auto& k : pso_loaded) {
+        if (k.topo == uint32_t(Topology::Points)) {
+            if (k.sprite) need_sprite_gs = true;
+            else need_point_gs = true;
+        }
+    }
+    VkShaderModule point_gs = VK_NULL_HANDLE;
+    VkShaderModule sprite_gs = VK_NULL_HANDLE;
+    if (need_point_gs) {
+        uint64_t gh = 0;
+        point_gs = Compile(PointHlsl(), "main", "gs_5_0", gh);
+    }
+    if (need_sprite_gs) {
+        uint64_t gh = 0;
+        sprite_gs = Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+    }
+
+    struct PrepItem {
+        uint64_t hash = 0;
+        PsoKey k{};
+        VkShaderModule vs = VK_NULL_HANDLE;
+        VkShaderModule ps = VK_NULL_HANDLE;
+        VkShaderModule gs = VK_NULL_HANDLE;
+        VkRenderPass rp = VK_NULL_HANDLE;
+    };
+    std::vector<PrepItem> items;
+    items.reserve(pso_loaded.size());
+    std::unordered_set<uint64_t> seen_hashes;
+    for (const auto& k : pso_loaded) {
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h) || !seen_hashes.insert(h).second) continue;
+        auto vit = shader_mods_.find(k.vs);
+        auto pit = shader_mods_.find(k.ps);
+        if (vit == shader_mods_.end() || vit->second == VK_NULL_HANDLE || pit == shader_mods_.end() ||
+            pit->second == VK_NULL_HANDLE) {
+            continue;
+        }
+        VkShaderModule gs = VK_NULL_HANDLE;
+        if (k.topo == uint32_t(Topology::Points)) {
+            gs = k.sprite ? sprite_gs : point_gs;
+        }
+        VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                        k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+        if (rp == VK_NULL_HANDLE) continue;
+        items.push_back(PrepItem{h, k, vit->second, pit->second, gs, rp});
+    }
+    if (items.empty()) {
+        LOGR("vulkan: metadata restored (%zu src mappings, 0 PSOs to prewarm)", restored_src);
+        return;
+    }
+
+    std::vector<VkPipeline> results(items.size(), VK_NULL_HANDLE);
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({4u, max_jobs, uint32_t(items.size())});
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= items.size()) break;
+            const PrepItem& it = items[idx];
+            const PsoKey& k = it.k;
+
+            VkPipelineShaderStageCreateInfo stages[3]{};
+            uint32_t stage_cnt = 0;
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_VERTEX_BIT, it.vs, "main", nullptr};
+            bool expanded_points = false;
+            if (k.topo == uint32_t(Topology::Points) && it.gs != VK_NULL_HANDLE) {
+                stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                       VK_SHADER_STAGE_GEOMETRY_BIT, it.gs, "main", nullptr};
+                expanded_points = true;
+            }
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_FRAGMENT_BIT, it.ps, "main", nullptr};
+
+            VkVertexInputBindingDescription vbinds[16]{};
+            for (uint32_t i = 0; i < k.buf_count && i < 16; ++i) {
+                vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+            }
+            VkVertexInputAttributeDescription vattrs[16]{};
+            uint32_t attr_cnt = 0;
+            for (uint32_t r = 0; r < 16; ++r) {
+                if (!((k.regs >> r) & 1)) continue;
+                uint32_t e = k.elements[r];
+                vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+            }
+
+            VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+            vi.vertexBindingDescriptionCount = std::min<uint32_t>(k.buf_count, 16u);
+            vi.pVertexBindingDescriptions = vbinds;
+            vi.vertexAttributeDescriptionCount = attr_cnt;
+            vi.pVertexAttributeDescriptions = vattrs;
+
+            VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+            ia.topology = VkTopologyOf(k.topo, k.strip);
+            ia.primitiveRestartEnable = VK_FALSE;
+
+            VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+            vp.viewportCount = 1;
+            vp.scissorCount = 1;
+
+            VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+            rs.polygonMode = (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+            rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+            rs.frontFace = (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+            rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+            rs.depthBiasConstantFactor = float(k.zbias);
+            rs.depthBiasSlopeFactor = k.zslope;
+            rs.lineWidth = 1.0f;
+
+            VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+            ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+            VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+            ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+            ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+            ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+            ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+            VkStencilOpState sop{};
+            sop.failOp = StencilOpVk(k.sfail);
+            sop.passOp = StencilOpVk(k.spass);
+            sop.depthFailOp = StencilOpVk(k.szfail);
+            sop.compareOp = CmpVk(k.sfunc);
+            sop.compareMask = k.smask;
+            sop.writeMask = k.swmask;
+            ds.front = ds.back = sop;
+
+            VkPipelineColorBlendAttachmentState ba{};
+            ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+            ba.srcColorBlendFactor = BlendFactor(k.src, false);
+            ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+            ba.colorBlendOp = BlendOpVk(k.op);
+            ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+            ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+            ba.alphaBlendOp = BlendOpVk(k.op);
+            ba.colorWriteMask = k.wmask & 0xF;
+
+            VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+            cb.attachmentCount = k.has_rt ? 1u : 0u;
+            cb.pAttachments = k.has_rt ? &ba : nullptr;
+
+            VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                            VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+            VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+            dyn.dynamicStateCount = 4;
+            dyn.pDynamicStates = dyn_states;
+
+            VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            gi.stageCount = stage_cnt;
+            gi.pStages = stages;
+            gi.pVertexInputState = &vi;
+            gi.pInputAssemblyState = &ia;
+            gi.pViewportState = &vp;
+            gi.pRasterizationState = &rs;
+            gi.pMultisampleState = &ms;
+            gi.pDepthStencilState = &ds;
+            gi.pColorBlendState = &cb;
+            gi.pDynamicState = &dyn;
+            gi.layout = gfx_layout_;
+            gi.renderPass = it.rp;
+            gi.subpass = 0;
+
+            VkPipeline pipe = VK_NULL_HANDLE;
+            if (vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe) == VK_SUCCESS) {
+                results[idx] = pipe;
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t built = 0;
+    for (size_t i = 0; i < items.size(); ++i) {
+        if (results[i] == VK_NULL_HANDLE) continue;
+        psos_[items[i].hash] = results[i];
+        if (known_pso_keys_.insert(items[i].hash).second) pso_meta_entries_.push_back(items[i].k);
+        if (perf::Enabled()) perf::RecordPsoCacheHit();
+        built++;
+    }
+    double prewarm_ms = PerfMs(t0);
+    perf::RecordBootPrewarm(prewarm_ms, uint32_t(built));
+    LOGR("vulkan: startup prewarm done in %.1f ms (src=%zu, psos=%zu/%zu, threads=%u)", prewarm_ms, restored_src, built,
+         items.size(), n_threads);
+}
+
+void VulkanBackend::RenderPrecompileProgressFrame(const char* stage, uint32_t done, uint32_t total, uint32_t sh_done,
+                                                  uint32_t sh_total, uint32_t pso_done, uint32_t pso_total) {
+    if (!imgui_inited_ || swapchain_ == VK_NULL_HANDLE || swap_images_.empty()) return;
+    uint32_t slot = uint32_t(frame_ % kFrames);
+    uint32_t bi = 0;
+    VkResult ar = vk_.acquire_next_image(dev_, swapchain_, UINT64_MAX, img_avail_sems_[slot], VK_NULL_HANDLE, &bi);
+    if (ar != VK_SUCCESS && ar != VK_SUBOPTIMAL_KHR) return;
+    swap_acquired_ = true;
+
+    EndRenderPass();
+    VkImage bb = swap_images_[bi];
+    VkImageLayout bb_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    TransitionImage(bb, bb_layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+    VkClearColorValue bg{{0.045f, 0.062f, 0.090f, 1.0f}};
+    VkImageSubresourceRange rng{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vk_.cmd_clear_color(cmd_, bb, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &bg, 1, &rng);
+    TransitionImage(bb, bb_layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+
+    {
+        std::lock_guard<std::recursive_mutex> lock(app::UiLock());
+        // Render-thread-safe ImGui frame: NEVER call ImGui_ImplSDL3_NewFrame() off the main thread!
+        ImGuiIO& io = ImGui::GetIO();
+        io.DisplaySize = ImVec2(float(bb_w_), float(bb_h_));
+        io.DisplayFramebufferScale = ImVec2(1.0f, 1.0f);
+        io.DeltaTime = 1.0f / 60.0f;
+        ImGui_ImplVulkan_NewFrame();
+        ImGui::NewFrame();
+        DrawPrecompileProgressUi(stage, done, total, sh_done, sh_total, pso_done, pso_total);
+        ImGui::Render();
+        if (ImDrawData* dd = ImGui::GetDrawData(); dd && dd->CmdListsCount > 0) {
+            EnsureRawRenderPass(present_rp_, swap_fbs_[bi], bb_w_, bb_h_);
+            ImGui_ImplVulkan_RenderDrawData(dd, cmd_);
+            EndRenderPass();
+        }
+    }
+
+    TransitionImage(bb, bb_layout, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_ASPECT_COLOR_BIT);
+    ts_started_ = false;
+    SubmitPresent(bi);
+    VkPresentInfoKHR pi{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+    pi.waitSemaphoreCount = 1;
+    pi.pWaitSemaphores = &render_done_sems_[bi];
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &swapchain_;
+    pi.pImageIndices = &bi;
+    vk_.queue_present(queue_, &pi);
+    WaitTimeline(fence_value_);
+    ResetFrame();
+}
+
+void VulkanBackend::RunAotPrecompile() {
+    if (!cache_enabled_) return;
+    auto t0 = PerfClock::now();
+    const uint64_t expected_sig = ComputeAotContentSignature("vulkan");
+    const uint32_t uuid_hash = uint32_t(Hash(phys_props_.pipelineCacheUUID, VK_UUID_SIZE));
+    const std::filesystem::path stamp_path = AotStampPath("vk", phys_props_.vendorID, phys_props_.deviceID);
+
+    AotStamp stamp{};
+    if (LoadAotStamp(stamp_path, phys_props_.vendorID, phys_props_.deviceID, phys_props_.driverVersion, uuid_hash,
+                     expected_sig, stamp) &&
+        !shader_mods_.empty() && shader_mods_.size() >= stamp.shader_count) {
+        aot_ready_ = true;
+        aot_ms_ = PerfMs(t0);
+        PublishCacheStats();
+        LOGR("vulkan: AOT precompile done in %.1f ms (scanned_vs=0, compiled_shaders=0, cached_shaders=%zu, "
+             "psos_built=0, total_shaders=%zu, total_psos=%zu, threads=0, aot_cached=true)",
+             aot_ms_, shader_mods_.size(), shader_mods_.size(), psos_.size() + blit_psos_.size());
+        return;
+    }
+
+    AotPlan plan = BuildAotPrecompilePlan("vulkan");
+    auto add_util_shader = [&](const std::string& src, const char* entry, const char* profile) {
+        uint64_t h = ComputeShaderBlobHash(src, entry, profile);
+        for (const auto& j : plan.shaders) {
+            if (j.blob_hash == h) return;
+        }
+        plan.shaders.push_back(AotShaderJob{h, 0u, src, entry, profile, std::strcmp(profile, "ps_5_0") == 0});
+    };
+    add_util_shader(kBlitHlsl, "vs", "vs_5_0");
+    add_util_shader(kBlitHlsl, "psmain", "ps_5_0");
+    add_util_shader(kClearHlsl, "vs", "vs_5_0");
+    add_util_shader(kClearHlsl, "psmain", "ps_5_0");
+    add_util_shader(kDepthHlsl, "vs", "vs_5_0");
+    add_util_shader(kDepthHlsl, "psmain", "ps_5_0");
+    add_util_shader(PointHlsl(), "main", "gs_5_0");
+    add_util_shader(SpriteHlsl(), "main", "gs_5_0");
+
+    std::vector<size_t> missing_idx;
+    missing_idx.reserve(plan.shaders.size());
+    std::unordered_set<uint64_t> scheduled_hashes;
+    size_t cached_shaders = 0;
+    for (size_t i = 0; i < plan.shaders.size(); ++i) {
+        const AotShaderJob& j = plan.shaders[i];
+        auto bit = shader_mods_.find(j.blob_hash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            cached_shaders++;
+            if (j.src_key != 0) {
+                shader_src_[j.src_key] = j.blob_hash;
+                if (known_src_keys_.insert(j.src_key).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{j.src_key, j.blob_hash});
+                    meta_dirty_ = true;
+                }
+            }
+            continue;
+        }
+        if (scheduled_hashes.insert(j.blob_hash).second) {
+            missing_idx.push_back(i);
+        }
+    }
+
+    const uint32_t hw_threads = std::max<uint32_t>(2u, std::thread::hardware_concurrency());
+    const uint32_t n_threads = std::min<uint32_t>(16u, hw_threads);
+    const uint32_t sh_total = uint32_t(missing_idx.size());
+    const uint32_t est_pso_total = uint32_t(plan.psos.size()) + 5u;
+    const uint32_t grand_total = sh_total + est_pso_total;
+
+    std::atomic<uint32_t> sh_done{0};
+    std::atomic<uint32_t> pso_done{0};
+    size_t compiled_ok = 0;
+
+    if (!missing_idx.empty()) {
+        std::vector<std::vector<uint32_t>> out_spv(missing_idx.size());
+        std::atomic<size_t> cursor{0};
+        std::atomic<bool> workers_finished{false};
+        const uint32_t workers = std::min<uint32_t>(n_threads, uint32_t(missing_idx.size()));
+
+        std::thread coordinator([&] {
+            auto work = [&] {
+                for (;;) {
+                    size_t slot = cursor.fetch_add(1, std::memory_order_relaxed);
+                    if (slot >= missing_idx.size()) break;
+                    const AotShaderJob& j = plan.shaders[missing_idx[slot]];
+                    std::vector<uint32_t> spv;
+                    std::string err;
+                    if (CompileHlslToSpirv(j.hlsl, j.entry.c_str(), j.profile.c_str(), spv, err) && !spv.empty()) {
+                        out_spv[slot] = std::move(spv);
+                    }
+                    sh_done.fetch_add(1, std::memory_order_relaxed);
+                }
+            };
+            std::vector<std::thread> pool;
+            pool.reserve(workers > 1 ? workers - 1 : 0);
+            for (uint32_t t = 1; t < workers; ++t) pool.emplace_back(work);
+            work();
+            for (auto& th : pool) th.join();
+            workers_finished.store(true, std::memory_order_release);
+        });
+
+        RenderPrecompileProgressFrame("Compiling NV2A Shaders", 0, grand_total, 0, sh_total, 0, est_pso_total);
+        while (!workers_finished.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            uint32_t sd = sh_done.load(std::memory_order_relaxed);
+            RenderPrecompileProgressFrame("Compiling NV2A Shaders", sd, grand_total, sd, sh_total, 0, est_pso_total);
+        }
+        coordinator.join();
+
+        for (size_t slot = 0; slot < missing_idx.size(); ++slot) {
+            const AotShaderJob& j = plan.shaders[missing_idx[slot]];
+            if (out_spv[slot].empty()) continue;
+            VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            ci.codeSize = out_spv[slot].size() * sizeof(uint32_t);
+            ci.pCode = out_spv[slot].data();
+            VkShaderModule mod = VK_NULL_HANDLE;
+            if (vk_.create_shader(dev_, &ci, nullptr, &mod) != VK_SUCCESS || mod == VK_NULL_HANDLE) continue;
+            shader_mods_[j.blob_hash] = mod;
+            {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                shader_cache_entries_.emplace_back(j.blob_hash, std::move(out_spv[slot]));
+                shaders_dirty_ = true;
+            }
+            compiled_ok++;
+        }
+        for (const AotShaderJob& j : plan.shaders) {
+            if (j.src_key == 0) continue;
+            auto bit = shader_mods_.find(j.blob_hash);
+            if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+                shader_src_[j.src_key] = j.blob_hash;
+                if (known_src_keys_.insert(j.src_key).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{j.src_key, j.blob_hash});
+                    meta_dirty_ = true;
+                }
+            }
+        }
+    }
+
+    // Eagerly build utility pipelines on main GPU thread
+    size_t built_psos = 0;
+    auto prebuild_util = [&](VkPipeline p) {
+        if (p != VK_NULL_HANDLE) built_psos++;
+        pso_done.fetch_add(1, std::memory_order_relaxed);
+    };
+    prebuild_util(EnsureBlitPipeline(VK_FORMAT_B8G8R8A8_UNORM, false));
+    prebuild_util(EnsureBlitPipeline(VK_FORMAT_B8G8R8A8_UNORM, true));
+    prebuild_util(EnsureClearPipeline(VK_FORMAT_B8G8R8A8_UNORM, 0x7));
+    prebuild_util(EnsureClearPipeline(VK_FORMAT_B8G8R8A8_UNORM, 0xF));
+    prebuild_util(EnsureDepthCopyPipeline());
+
+    // Pre-create all VkRenderPasses single-threaded before spawning PSO worker threads
+    struct AotPsoItem {
+        uint64_t hash = 0;
+        PsoKey k{};
+        VkShaderModule vs = VK_NULL_HANDLE;
+        VkShaderModule ps = VK_NULL_HANDLE;
+        VkShaderModule gs = VK_NULL_HANDLE;
+        VkRenderPass rp = VK_NULL_HANDLE;
+    };
+    uint64_t pt_gs_h = ComputeShaderBlobHash(PointHlsl(), "main", "gs_5_0");
+    uint64_t sp_gs_h = ComputeShaderBlobHash(SpriteHlsl(), "main", "gs_5_0");
+    VkShaderModule pt_gs = shader_mods_.count(pt_gs_h) ? shader_mods_[pt_gs_h] : VK_NULL_HANDLE;
+    VkShaderModule sp_gs = shader_mods_.count(sp_gs_h) ? shader_mods_[sp_gs_h] : VK_NULL_HANDLE;
+
+    std::vector<AotPsoItem> pso_items;
+    pso_items.reserve(plan.psos.size());
+    std::unordered_set<uint64_t> seen_pso_hashes;
+    for (const AotPsoSeed& sd : plan.psos) {
+        auto vit = shader_mods_.find(sd.vs_hash);
+        auto pit = shader_mods_.find(sd.ps_hash);
+        if (vit == shader_mods_.end() || vit->second == VK_NULL_HANDLE || pit == shader_mods_.end() ||
+            pit->second == VK_NULL_HANDLE) {
+            continue;
+        }
+        PsoKey k{};
+        std::memset(&k, 0, sizeof(k));
+        k.vs = sd.vs_hash;
+        k.ps = sd.ps_hash;
+        k.regs = sd.regs;
+        k.topo = sd.topo;
+        k.strip = sd.strip;
+        k.has_rt = sd.has_rt;
+        k.has_ds = sd.has_ds;
+        std::memcpy(k.elements, sd.elements, sizeof(k.elements));
+        std::memcpy(k.strides, sd.strides, sizeof(k.strides));
+        k.buf_count = sd.buf_count;
+        k.blend = sd.blend;
+        k.src = sd.src;
+        k.dst = sd.dst;
+        k.op = sd.op;
+        k.wmask = sd.wmask;
+        k.zen = sd.zen;
+        k.zwrite = sd.zwrite;
+        k.zfunc = sd.zfunc;
+        k.sten = sd.sten;
+        k.sfunc = sd.sfunc;
+        k.smask = sd.smask;
+        k.swmask = sd.swmask;
+        k.sfail = sd.sfail;
+        k.szfail = sd.szfail;
+        k.spass = sd.spass;
+        k.cull = sd.cull;
+        k.ccw = sd.ccw;
+        k.fill = sd.fill;
+        k.zbias = sd.zbias;
+        k.zslope = sd.zslope;
+        k.rtfmt = sd.has_rt ? uint32_t(VK_FORMAT_B8G8R8A8_UNORM) : uint32_t(VK_FORMAT_UNDEFINED);
+        k.sprite = sd.sprite;
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h) || !seen_pso_hashes.insert(h).second) continue;
+        VkShaderModule gs = VK_NULL_HANDLE;
+        if (k.topo == uint32_t(Topology::Points)) {
+            gs = k.sprite ? sp_gs : pt_gs;
+            if (gs == VK_NULL_HANDLE) continue;
+        }
+        VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                        k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+        if (rp == VK_NULL_HANDLE) continue;
+        pso_items.push_back(AotPsoItem{h, k, vit->second, pit->second, gs, rp});
+    }
+
+    if (!pso_items.empty()) {
+        std::vector<VkPipeline> out_psos(pso_items.size(), VK_NULL_HANDLE);
+        std::atomic<size_t> cursor{0};
+        std::atomic<bool> workers_finished{false};
+        const uint32_t workers = std::min<uint32_t>(n_threads, uint32_t(pso_items.size()));
+        const uint32_t pso_total = uint32_t(pso_items.size()) + 5u;
+        const uint32_t total_work = sh_total + pso_total;
+
+        std::thread coordinator([&] {
+            auto work = [&] {
+                for (;;) {
+                    size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+                    if (idx >= pso_items.size()) break;
+                    const AotPsoItem& it = pso_items[idx];
+                    const PsoKey& k = it.k;
+
+                    VkPipelineShaderStageCreateInfo stages[3]{};
+                    uint32_t stage_cnt = 0;
+                    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                           VK_SHADER_STAGE_VERTEX_BIT, it.vs, "main", nullptr};
+                    bool expanded_points = false;
+                    if (k.topo == uint32_t(Topology::Points) && it.gs != VK_NULL_HANDLE) {
+                        stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                               VK_SHADER_STAGE_GEOMETRY_BIT, it.gs, "main", nullptr};
+                        expanded_points = true;
+                    }
+                    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                           VK_SHADER_STAGE_FRAGMENT_BIT, it.ps, "main", nullptr};
+
+                    VkVertexInputBindingDescription vbinds[16]{};
+                    for (uint32_t i = 0; i < k.buf_count && i < 16; ++i) {
+                        vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+                    }
+                    VkVertexInputAttributeDescription vattrs[16]{};
+                    uint32_t attr_cnt = 0;
+                    for (uint32_t r = 0; r < 16; ++r) {
+                        if (!((k.regs >> r) & 1)) continue;
+                        uint32_t e = k.elements[r];
+                        vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+                    }
+
+                    VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+                    vi.vertexBindingDescriptionCount = std::min<uint32_t>(k.buf_count, 16u);
+                    vi.pVertexBindingDescriptions = vbinds;
+                    vi.vertexAttributeDescriptionCount = attr_cnt;
+                    vi.pVertexAttributeDescriptions = vattrs;
+
+                    VkPipelineInputAssemblyStateCreateInfo ia{
+                        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+                    ia.topology = VkTopologyOf(k.topo, k.strip);
+                    ia.primitiveRestartEnable = VK_FALSE;
+
+                    VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+                    vp.viewportCount = 1;
+                    vp.scissorCount = 1;
+
+                    VkPipelineRasterizationStateCreateInfo rs{
+                        VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+                    rs.polygonMode =
+                        (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+                    rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+                    rs.frontFace =
+                        (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+                    rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+                    rs.depthBiasConstantFactor = float(k.zbias);
+                    rs.depthBiasSlopeFactor = k.zslope;
+                    rs.lineWidth = 1.0f;
+
+                    VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+                    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+                    VkPipelineDepthStencilStateCreateInfo ds{
+                        VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+                    ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+                    ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+                    ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+                    ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+                    VkStencilOpState sop{};
+                    sop.failOp = StencilOpVk(k.sfail);
+                    sop.passOp = StencilOpVk(k.spass);
+                    sop.depthFailOp = StencilOpVk(k.szfail);
+                    sop.compareOp = CmpVk(k.sfunc);
+                    sop.compareMask = k.smask;
+                    sop.writeMask = k.swmask;
+                    ds.front = ds.back = sop;
+
+                    VkPipelineColorBlendAttachmentState ba{};
+                    ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+                    ba.srcColorBlendFactor = BlendFactor(k.src, false);
+                    ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+                    ba.colorBlendOp = BlendOpVk(k.op);
+                    ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+                    ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+                    ba.alphaBlendOp = BlendOpVk(k.op);
+                    ba.colorWriteMask = k.wmask & 0xF;
+
+                    VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+                    cb.attachmentCount = k.has_rt ? 1u : 0u;
+                    cb.pAttachments = k.has_rt ? &ba : nullptr;
+
+                    VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                                    VK_DYNAMIC_STATE_BLEND_CONSTANTS,
+                                                    VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+                    VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+                    dyn.dynamicStateCount = 4;
+                    dyn.pDynamicStates = dyn_states;
+
+                    VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+                    gi.stageCount = stage_cnt;
+                    gi.pStages = stages;
+                    gi.pVertexInputState = &vi;
+                    gi.pInputAssemblyState = &ia;
+                    gi.pViewportState = &vp;
+                    gi.pRasterizationState = &rs;
+                    gi.pMultisampleState = &ms;
+                    gi.pDepthStencilState = &ds;
+                    gi.pColorBlendState = &cb;
+                    gi.pDynamicState = &dyn;
+                    gi.layout = gfx_layout_;
+                    gi.renderPass = it.rp;
+                    gi.subpass = 0;
+
+                    VkPipeline pipe = VK_NULL_HANDLE;
+                    if (vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe) == VK_SUCCESS) {
+                        out_psos[idx] = pipe;
+                    }
+                    pso_done.fetch_add(1, std::memory_order_relaxed);
+                }
+            };
+            std::vector<std::thread> pool;
+            pool.reserve(workers > 1 ? workers - 1 : 0);
+            for (uint32_t t = 1; t < workers; ++t) pool.emplace_back(work);
+            work();
+            for (auto& th : pool) th.join();
+            workers_finished.store(true, std::memory_order_release);
+        });
+
+        while (!workers_finished.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            uint32_t pd = pso_done.load(std::memory_order_relaxed);
+            RenderPrecompileProgressFrame("Building GPU Pipelines", sh_total + pd, total_work, sh_total, sh_total, pd,
+                                          pso_total);
+        }
+        coordinator.join();
+
+        for (size_t i = 0; i < pso_items.size(); ++i) {
+            if (out_psos[i] == VK_NULL_HANDLE) continue;
+            const AotPsoItem& it = pso_items[i];
+            psos_[it.hash] = out_psos[i];
+            if (known_pso_keys_.insert(it.hash).second) {
+                pso_meta_entries_.push_back(it.k);
+                pso_dirty_ = true;
+                meta_dirty_ = true;
+            }
+            built_psos++;
+        }
+    }
+
+    if (compiled_ok > 0 || built_psos > 0) {
+        RenderPrecompileProgressFrame("Finalizing Shader Cache", grand_total, grand_total, sh_total, sh_total,
+                                      pso_done.load(std::memory_order_relaxed), est_pso_total);
+    }
+
+    aot_compiled_shaders_ = compiled_ok;
+    aot_built_psos_ = built_psos;
+    aot_ready_ = true;
+    aot_ms_ = PerfMs(t0);
+
+    AotStamp new_stamp{};
+    new_stamp.vendor_id = phys_props_.vendorID;
+    new_stamp.device_id = phys_props_.deviceID;
+    new_stamp.subsys_id = phys_props_.driverVersion;
+    new_stamp.revision = uuid_hash;
+    new_stamp.shader_count = uint32_t(shader_mods_.size());
+    new_stamp.pso_count = uint32_t(psos_.size() + blit_psos_.size());
+    new_stamp.content_sig = expected_sig;
+    WriteAotStamp(stamp_path, new_stamp);
+
+    SaveCaches(false);
+    PublishCacheStats();
+    perf::RecordBootPrewarm(aot_ms_, uint32_t(built_psos));
+    LOGR("vulkan: AOT precompile done in %.1f ms (scanned_vs=%u, compiled_shaders=%zu, cached_shaders=%zu, "
+         "psos_built=%zu, total_shaders=%zu, total_psos=%zu, threads=%u, aot_cached=false)",
+         aot_ms_, plan.scanned_vs_programs, compiled_ok, cached_shaders, built_psos, shader_mods_.size(),
+         psos_.size() + blit_psos_.size(), n_threads);
+}
